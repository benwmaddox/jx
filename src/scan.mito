// The scanner: reads the document once, front to back. A stack of open containers says where it is; each container holds the
// automaton node it belongs to (-1 for a container nobody wants: it is only skipped, but still checked). A value is a span
// (start, end) in the input; the slots keep the spans of the wanted values, and the scope bodies run when an element ends.
// Tags are jq's type order: 1 null, 2 false, 3 true, 4 number, 5 string, 6 array, 7 object.

// the position after the string that starts at p (its quote), or -1 with jj.err set.
// Sets jj.sc.esc: 1 when it has a backslash or a DEL, 2 when it has a byte of 128 or more.
fn scan_string(doc: text, p: i64) -> i64 {
    var i = p + 1;
    var fl = 0;
    while true {
        // 64 bytes at a time up to the next byte that needs a look (a quote, a backslash, a control character, DEL, or the end: bytes past it read 0);
        // a byte of 128 or more before it only sets the flag
        let v = doc.load_u8x64(i);
        let stop = ((v == 34) | (v == 92) | (v < 32) | (v == 127)).mask();
        let high = (v >= 128).mask();
        if stop == 0 {
            if high != 0 { fl = fl | 2; }
            i += 64;
            continue;
        }
        let k = stop.trailing_zeros();
        if high.trailing_zeros() < k { fl = fl | 2; }
        i += k;
        let c = byte_at(doc, i);
        if c == 34 { jj.sc.esc = fl; return i + 1; }
        if c < 0 { return fail_at("unfinished string", i); }
        if c >= 127 { if c == 127 { fl = fl | 1; } else { fl = fl | 2; } i += 1; continue; }
        if c < 32 { return fail_at("control character in string", i); }
        // a backslash
        fl = fl | 1;
        let d = byte_at(doc, i + 1);
        if d == 117 {
            let h = hex4(doc, i + 2);
            if h < 0 { return fail_at("invalid \\u escape", i); }
            if h >= 55296 && h <= 56319 {
                if byte_at(doc, i + 6) != 92 || byte_at(doc, i + 7) != 117 { return fail_at("invalid surrogate pair escape", i); }
                let l = hex4(doc, i + 8);
                if l < 56320 || l > 57343 { return fail_at("invalid surrogate pair escape", i); }
                i += 12;
            } else {
                i += 6;
            }
            continue;
        }
        if d == 34 || d == 92 || d == 47 || d == 98 || d == 102 || d == 110 || d == 114 || d == 116 { i += 2; continue; }
        return fail_at("invalid escape", i);
    }
    return -1;
}

fn is_digit(c: i64) -> bool {
    return c >= 48 && c <= 57;
}

// the position after the number at p (strict JSON grammar), or -1. For an integer of at most 15 digits
// (not -0) jj.sc.isint is set and jj.sc.ival has its value.
fn scan_number(doc: text, p: i64) -> i64 {
    var i = p;
    var neg = false;
    if byte_at(doc, i) == 45 { neg = true; i += 1; }
    var c = byte_at(doc, i);
    var acc = 0;
    var nd = 0;
    if c == 48 { i += 1; nd = 1; }
    else if c >= 49 && c <= 57 {
        acc = c - 48;
        nd = 1;
        i += 1;
        while true {
            let d = byte_at(doc, i);
            if d < 48 || d > 57 { c = d; break; }
            if nd < 15 { acc = acc * 10 + d - 48; }
            nd += 1;
            i += 1;
        }
    } else { return fail_at("invalid number", p); }
    var plain = nd <= 15 && !(neg && acc == 0);
    c = byte_at(doc, i);
    if c == 46 {
        plain = false;
        i += 1;
        if !is_digit(byte_at(doc, i)) { return fail_at("invalid number", p); }
        while is_digit(byte_at(doc, i)) { i += 1; }
        c = byte_at(doc, i);
    }
    if c == 101 || c == 69 {
        plain = false;
        i += 1;
        let s = byte_at(doc, i);
        if s == 43 || s == 45 { i += 1; }
        if !is_digit(byte_at(doc, i)) { return fail_at("invalid number", p); }
        while is_digit(byte_at(doc, i)) { i += 1; }
    }
    jj.sc.isint = plain;
    if neg { jj.sc.ival = -acc; } else { jj.sc.ival = acc; }
    return i;
}

// the position after `true`, `false` or `null` at p, or -1; the tag in jj.sc.esc
fn scan_literal(doc: text, p: i64) -> i64 {
    let c = byte_at(doc, p);
    if c == 116 && substr(doc, p, 4) == "true" { jj.sc.esc = 3; return p + 4; }
    if c == 102 && substr(doc, p, 5) == "false" { jj.sc.esc = 2; return p + 5; }
    if c == 110 && substr(doc, p, 4) == "null" { jj.sc.esc = 1; return p + 4; }
    return fail_at("invalid literal", p);
}

// the node for element k of an array whose node is `node`
fn elem_node(node: i64, k: i64) -> i64 {
    if node < 0 { return -1; }
    let it = jj.f.niter[node];
    if it >= 0 { return it; }
    if jj.f.nidx[node] == 0 { return -1; }
    var e = jj.f.nfirst[node];
    while e != 0 {
        if jj.f.ekind[e] == 1 && jj.f.ea[e] == k { return jj.f.enode[e]; }
        e = jj.f.enext[e];
    }
    return -1;
}

// the generation a slot of `node` must carry to be valid now
fn gen_of(node: i64) -> i64 {
    let ow = jj.f.owner[node];
    if ow < 0 { return jj.sc.dgen; }
    return jj.sc.ugen[ow];
}

// a value of type `tag` where the filter indexes into it by key or position: jq's error, raised when the value is read
fn mark_nav(node: i64, tag: i64) {
    if tag == 1 { return; }
    if jj.f.nkeys[node] != 0 && tag != 7 {
        jj.sc.serr[node] = tag;
        jj.sc.serrg[node] = gen_of(node);
        jj.sc.anyerr = true;
    }
    if jj.f.nidx[node] != 0 && tag != 6 {
        jj.sc.serri[node] = tag;
        jj.sc.serrgi[node] = gen_of(node);
        jj.sc.anyerr = true;
    }
}

// is `a` the node `anc` or below it?
fn is_below(a: i64, anc: i64) -> bool {
    var n = a;
    while n >= 0 {
        if n == anc { return true; }
        n = jj.f.par[n];
    }
    return false;
}

// a key matched again in the same object: the last one wins, so what the first one filled is forgotten
fn forget_below(node: i64) {
    var w = 0;
    while w < jj.f.nn {
        if jj.f.want[w] != 0 && jj.sc.sgen[w] == gen_of(w) && is_below(w, node) {
            jj.sc.sgen[w] = -1;
            if jj.f.owner[w] < 0 { jj.sc.nfilled -= 1; }
        }
        w += 1;
    }
}

// a value for `node` ended: keep it in its slot; at a unit's end run the scopes
fn value_done(doc: text, filter: text, node: i64, tag: i64, a: i64, b: i64, cnt: i64, esc: i64, isint: bool, ival: i64) -> i64 {
    if node < 0 { return 0; }
    if jj.f.want[node] != 0 {
        let g = gen_of(node);
        if jj.sc.sgen[node] != g && jj.f.owner[node] < 0 { jj.sc.nfilled += 1; }
        jj.sc.sgen[node] = g;
        jj.sc.stag[node] = tag;
        jj.sc.sa[node] = a;
        jj.sc.sb[node] = b;
        jj.sc.scnt[node] = cnt;
        jj.sc.sesc[node] = esc;
        if tag == 4 {
            jj.sc.sisint[node] = 0;
            if isint { jj.sc.sisint[node] = 1; jj.sc.sint[node] = ival; }
        }
        if jj.f.owner[node] < 0 && jj.sc.nfilled == jj.f.nwant && jj.sc.exit_depth == 0 && !jj.sc.validate && (jj.first || jj.sc.selective) { jj.sc.exit_depth = jj.sc.sp; }
    }
    if jj.f.sc1[node] >= 0 {
        let rc = run_unit(doc, filter, node);
        jj.sc.ugen[node] += 1;
        return rc;
    }
    return 0;
}

fn close_frame(doc: text, filter: text, p: i64) -> i64 {
    let sp = jj.sc.sp;
    let nd = jj.sc.fnode[sp];
    jj.sc.sp = sp - 1;
    if nd >= 0 && jj.f.wantkeys[nd] != 0 && jj.sc.fkind[sp] == 7 {
        jj.sc.skh[nd] = jj.sc.fkh[sp];
        jj.sc.skn[nd] = jj.sc.fcnt[sp];
    }
    return value_done(doc, filter, nd, jj.sc.fkind[sp], jj.sc.fstart[sp], p, jj.sc.fcnt[sp], 0, false, 0);
}

// the entry of node `kn` for the key at [ks, ks+kl) (escaped when esc), 0 for none
fn find_key(doc: text, kn: i64, ks: i64, kl: i64, esc: i64) -> i64 {
    var e = jj.f.nfirst[kn];
    if (esc & 1) != 0 {
        decode_string(doc, ks - 1, ks + kl + 1);
        let n = len(jj.tmp);
        while e != 0 {
            if jj.f.ekind[e] == 0 && jj.f.eb[e] == n && substr(jj.tmp, 0, n) == substr(jj.f.keys, jj.f.ea[e], n) { return e; }
            e = jj.f.enext[e];
        }
        return 0;
    }
    let first = byte_at(doc, ks);
    while e != 0 {
        if jj.f.ekind[e] == 0 && jj.f.eb[e] == kl && jj.f.ef[e] == first && substr(doc, ks, kl) == substr(jj.f.keys, jj.f.ea[e], kl) { return e; }
        e = jj.f.enext[e];
    }
    return 0;
}

// the arena depth a node's collected keys live in
fn key_depth(node: i64) -> i64 {
    let ow = jj.f.owner[node];
    if ow < 0 { return 0; }
    return jj.f.s_depth[jj.f.sc1[ow]];
}

// --selective: the position after the container whose opening bracket is at p, found 64 bytes at a time by counting brackets outside strings.
// Nothing inside is checked (as simdjson's On-Demand skips a value): only where strings start and end, a backslash escaping the byte after it.
// -1 with jj.err set when the input ends first.
fn skip_container(doc: text, p: i64) -> i64 { return skip_from(doc, p, 0); }

// the position after the `depth0` containers open at p (p outside any string) close; skip_container with depth0 0 starts at the opening bracket
fn skip_from(doc: text, p: i64, depth0: i64) -> i64 {
    var i = p;
    var depth = depth0;
    var instr = 0;      // 1 when this block starts inside a string
    var carry = 0;      // 1 when this block's first byte is escaped (the last block ended with a backslash that escapes)
    while i < len(doc) {
        let v = doc.load_u8x64(i);
        // escaped bytes: a backslash that is not itself escaped escapes the byte after it (backslashes are rare: one at a time)
        var escaped = carry;
        carry = 0;
        var rest = (v == 92).mask();
        while rest != 0 {
            let j = rest.trailing_zeros();
            let bit = 1 << j;
            if (escaped & bit) == 0 {
                if j == 63 { carry = 1; } else { escaped = escaped | (bit << 1); }
            }
            rest = rest ^ bit;
        }
        let quotes = (v == 34).mask();
        let q = quotes ^ (quotes & escaped);
        let inside = q.prefix_xor() ^ (0 - instr);
        instr = inside >>> 63;
        // `[` and `{` differ only in bit 5, as do `]` and `}`: one OR folds each pair onto one compare
        let folded = v | 32;
        let opens = (folded == 123).mask();
        let closes = (folded == 125).mask();
        let o = opens ^ (opens & inside);
        let c = closes ^ (closes & inside);
        if depth > 0 && c.popcount() < depth {
            depth += o.popcount() - c.popcount();
        } else {
            var s = o | c;
            while s != 0 {
                let j = s.trailing_zeros();
                let bit = 1 << j;
                if (o & bit) != 0 { depth += 1; } else {
                    depth -= 1;
                    if depth == 0 { return i + j + 1; }
                }
                s = s ^ bit;
            }
        }
        i += 64;
    }
    return fail_at("unfinished JSON term", len(doc));
}

// The input is a stream of values, as jq reads it: the filter runs once per value and the results come out in order. NDJSON is one
// value per line; white space between values is optional where the end of a value is clear (`[1][2]`, `{"a":1}"b"`), a comma or a
// token run-on (`1true`) is an error. Per value everything the engine holds is reset (new_value). An error of the filter in one value
// is reported on standard error after that value's earlier results, and the next value is read (the exit code is the last value's);
// a parse error or a limit stops: the results of the broken value are taken back, those of earlier values stand.
// --first reads only the first value and stops as soon as the filter is done with it (the single-document mode, early exit included).
// 0, or 1 with jj.err set
fn scan(doc: text, filter: text) -> i64 {
    var p = skip_ws(doc, 0);
    if byte_at(doc, 0) == 239 && byte_at(doc, 1) == 187 && byte_at(doc, 2) == 191 { p = skip_ws(doc, 3); }   // a byte order mark
    if p >= len(doc) { return 0; }
    while true {
        new_value();
        // this value's output, taken back if the value turns out broken
        jj.o.open = false;
        let o_len = len(jj.o.text);
        let o_res = jj.o.results;
        let o_sep = jj.o.sep;
        let o_last = jj.o.lastpos;
        if jj.uses_inl { jj.inl = jj.lfbase + lines_before(doc, p); }
        var e = scan_value(doc, filter, p);
        if e >= 0 && !jj.first { e = after_value(doc, e); }
        if e < 0 {
            jj.o.text = substr(jj.o.text, 0, o_len);
            jj.o.results = o_res;
            jj.o.sep = o_sep;
            jj.o.lastpos = o_last;
            // input in pieces: a value that runs into the end of the piece is not broken but cut; it is read again with the next piece
            if jj.more && jj.sc.perr && jj.sc.perr_at >= len(doc) {
                jj.sc.perr = false;
                jj.err = "";
                jj.part = p;
                return 2;
            }
            return 1;
        }
        if jj.sc.rt {
            res_cut();
            flush_out();
            eprint(jj.rterr + "
");
            jj.vstatus = 5;
        } else { jj.vstatus = 0; }
        if jj.first { return 0; }
        if len(jj.o.text) > 1048576 { flush_out(); }
        p = e;
        if p >= len(doc) { return 0; }
    }
    return 0;
}
// (scan returns 2 only for input in pieces: the value at jj.part runs past the end of the piece)

// per value: a fresh generation for the document-level slots and registers (everything an earlier value left is stale at once),
// empty arenas and scratch text, no pending error
fn new_value() {
    var g = jj.sc.dgen;
    var u = 0;
    while u < jj.f.nn { if jj.sc.ugen[u] > g { g = jj.sc.ugen[u]; } u += 1; }
    g += 1;
    jj.sc.dgen = g;
    u = 0;
    while u < jj.f.nn { jj.sc.ugen[u] = g; u += 1; }
    jj.sc.sp = 0;
    jj.sc.nfilled = 0;
    jj.sc.exit_depth = 0;
    jj.sc.anyerr = false;
    jj.sc.dead = false;
    jj.sc.rt = false;
    var d = 0;
    while d < 4 { jj.v.top[d] = jj.v.base[d]; d += 1; }
    if len(jj.ev.scr) > 0 { jj.ev.scr = ""; }   // most values build no text: no store at all
    if len(jj.ev.ptx) > 0 { jj.ev.ptx = ""; }
    jj.ev.err = 0;
    jj.ev.depth = 0;
}

// after a value that ended at e: the start of the next value (or the end of the input), -1 with jj.err set for a comma, a closing
// bracket or a token run-on (`1true`, `nulll`)
fn after_value(doc: text, e: i64) -> i64 {
    let c = byte_at(doc, e);
    if c < 0 { return e; }
    if c == 44 || c == 58 || c == 93 || c == 125 { return fail_at("unexpected character between values", e); }
    let prev = byte_at(doc, e - 1);
    let ended = prev == 34 || prev == 93 || prev == 125;
    let ws = c == 32 || c == 9 || c == 10 || c == 13;
    if !ended && !ws && c != 34 && c != 91 && c != 123 { return fail_at("invalid token", e); }
    return skip_ws(doc, e);
}

// an error while a value is read: a parse error, a limit, or --first stops the input (true); an error of the filter is kept for the
// end of the value, and the rest of the value is only checked (every open container and everything after it read without the filter)
fn value_error() -> bool {
    if jj.sc.perr || jj.exitc != 5 || jj.first { return true; }
    if !jj.sc.rt { jj.sc.rt = true; jj.rterr = jj.err; }
    jj.err = "";
    jj.ev.err = 0;
    var k = 1;
    while k <= jj.sc.sp { jj.sc.fnode[k] = -1; k += 1; }
    jj.sc.dead = true;
    return false;
}

// one value from p: the position after it, or -1 with jj.err set
fn scan_value(doc: text, filter: text, p0: i64) -> i64 {
    var p = p0;
    var node = 0;
    var mode = 0;                 // 0 a value starts here, 1 a value ended, 2 a key starts here
    while true {
        if mode == 0 {
            p = skip_ws(doc, p);
            let c = byte_at(doc, p);
            if (c == 123 || c == 91) && node < 0 && jj.sc.selective {
                // a container nobody reads: skipped whole
                let e = skip_container(doc, p);
                if e < 0 { return -1; }
                p = e;
                mode = 1;
            } else if c == 123 || c == 91 {
                let sp = jj.sc.sp + 1;
                if sp > 10000 { return fail_at("exceeds depth limit for parsing", p); }
                var tag = 6;
                if c == 123 { tag = 7; }
                if node >= 0 && (jj.f.nkeys[node] != 0 || jj.f.nidx[node] != 0) { mark_nav(node, tag); }
                jj.sc.sp = sp;
                jj.sc.fnode[sp] = node;
                jj.sc.fkind[sp] = tag;
                jj.sc.fcnt[sp] = 0;
                jj.sc.fstart[sp] = p;
                jj.sc.fseen[sp] = 0;
                jj.sc.fkh[sp] = -1;
                jj.sc.fkt[sp] = -1;
                p = skip_ws(doc, p + 1);
                let d = byte_at(doc, p);
                if tag == 7 {
                    if d == 125 {
                        p += 1;
                        if close_frame(doc, filter, p) != 0 { if value_error() { return -1; } }
                        mode = 1;
                    } else { mode = 2; }
                } else {
                    if d == 93 {
                        p += 1;
                        if close_frame(doc, filter, p) != 0 { if value_error() { return -1; } }
                        mode = 1;
                    } else {
                        jj.sc.fcnt[sp] = 1;
                        node = elem_node(node, 0);
                    }
                }
            } else {
                var tag = 0;
                var e = 0;
                var esc = 0;
                var isint = false;
                var ival = 0;
                if c == 34 {
                    e = scan_string(doc, p);
                    tag = 5;
                    esc = jj.sc.esc;
                } else if c == 45 || is_digit(c) {
                    e = scan_number(doc, p);
                    tag = 4;
                    isint = jj.sc.isint;
                    ival = jj.sc.ival;
                } else if c == 116 || c == 102 || c == 110 {
                    e = scan_literal(doc, p);
                    tag = jj.sc.esc;
                } else {
                    return fail_at("unexpected character, expected a value", p);
                }
                if e < 0 { return -1; }
                if node >= 0 && (jj.f.nkeys[node] != 0 || jj.f.nidx[node] != 0) { mark_nav(node, tag); }
                if value_done(doc, filter, node, tag, p, e, 0, esc, isint, ival) != 0 { if value_error() { return -1; } }
                p = e;
                mode = 1;
            }
        } else if mode == 2 {
            // a key
            let sp = jj.sc.sp;
            if byte_at(doc, p) != 34 { return fail_at("object keys must be strings", p); }
            let e = scan_string(doc, p);
            if e < 0 { return -1; }
            let esc = jj.sc.esc;
            let kn = jj.sc.fnode[sp];
            jj.sc.fcnt[sp] += 1;
            node = -1;
            if kn >= 0 {
                if jj.f.niter[kn] >= 0 {
                    node = jj.f.niter[kn];
                } else if jj.f.nkeys[kn] != 0 {
                    let ent = find_key(doc, kn, p + 1, e - p - 2, esc);
                    if ent != 0 {
                        node = jj.f.enode[ent];
                        let bit = 1 << (jj.f.eord[ent] % 62);
                        if (jj.sc.fseen[sp] & bit) != 0 {
                            if jj.f.stream[node] != 0 { return fail_at("a key repeats on a streamed path (jq keeps the last one)", p); }
                            forget_below(node);
                        }
                        jj.sc.fseen[sp] = jj.sc.fseen[sp] | bit;
                    }
                }
                if jj.f.wantkeys[kn] != 0 {
                    let h = ar_alloc(key_depth(kn));
                    if h < 0 { return -1; }
                    jj.v.vt[h] = 5;
                    jj.v.vs[h] = 0;
                    jj.v.va[h] = p;
                    jj.v.vb[h] = e;
                    jj.v.vf[h] = esc;
                    jj.v.vd[h] = -1;
                    jj.v.vn[h] = -1;
                    if jj.sc.fkt[sp] >= 0 { jj.v.vn[jj.sc.fkt[sp]] = h; } else { jj.sc.fkh[sp] = h; }
                    jj.sc.fkt[sp] = h;
                }
            }
            p = skip_ws(doc, e);
            if byte_at(doc, p) != 58 { return fail_at("expected a colon after the key", p); }
            p += 1;
            mode = 0;
        } else {
            // a value ended
            if jj.sc.exit_depth > 0 && jj.sc.sp < jj.sc.exit_depth && jj.sc.sp > 0 {
                // every slot is filled: --first stops here; in a stream (--selective) the rest of the value is skipped to its end
                if !jj.first {
                    p = skip_from(doc, p, jj.sc.sp);
                    if p < 0 { return -1; }
                }
                break;
            }
            let sp = jj.sc.sp;
            if sp == 0 && !jj.first { break; }   // the value ended at p
            p = skip_ws(doc, p);
            if sp == 0 {
                // --first does not look at what follows the value; with --validate it must be white space only
                if p < len(doc) && jj.sc.validate { return fail_at("more than one JSON value on the input (--first --validate reads one document)", p); }
                break;
            }
            let c = byte_at(doc, p);
            let kind = jj.sc.fkind[sp];
            if c == 44 {
                if kind == 7 {
                    p = skip_ws(doc, p + 1);
                    mode = 2;
                } else {
                    jj.sc.fcnt[sp] += 1;
                    node = elem_node(jj.sc.fnode[sp], jj.sc.fcnt[sp] - 1);
                    p += 1;
                    mode = 0;
                }
            } else if (c == 125 && kind == 7) || (c == 93 && kind == 6) {
                p += 1;
                if close_frame(doc, filter, p) != 0 { if value_error() { return -1; } }
            } else if c < 0 {
                return fail_at("unfinished JSON term", p);
            } else {
                return fail_at("expected a separator or the end of the container", p);
            }
        }
    }
    if !jj.sc.dead && run_root(doc, filter) != 0 { if value_error() { return -1; } }
    return p;
}
