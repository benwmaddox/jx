// Writing values the way jq 1.8.2 does: strings re-escaped, invalid UTF-8 replaced by U+FFFD, numbers in decNumber's form
// (1e3 becomes 1E+3, 0.0001e5 becomes 1E+1) or as jq prints a double, containers compact or indented.

fn newline_indent(depth: i64) {
    ow("\n");
    var k = 0;
    if jj.o.tab { while k < depth { ow(chr(9)); k += 1; } return; }
    while k < depth * jj.o.ind { ow(" "); k += 1; }
}

// write t to the output, or to the scratch string while a number is being turned into a string
fn ow(t: text) {
    if jj.o.to == 0 {
        if jj.o.ascii { ow_ascii(t); } else { jj.o.text += t; }
    } else { jj.ev.scr += t; }
}

// -a: every character above 127 as a backslash-u escape (a pair for one above U+FFFF), like jq's ASCII output
fn ow_ascii(t: text) {
    var i = 0;
    var rs = 0;
    let n = len(t);
    while i < n {
        let c = byte_at(t, i);
        if c < 128 { i += 1; continue; }
        if i > rs { jj.o.text += substr(t, rs, i - rs); }
        var cp = c;
        var k = 1;
        if c >= 240 { cp = c & 7; k = 4; } else if c >= 224 { cp = c & 15; k = 3; } else if c >= 192 { cp = c & 31; k = 2; }
        var j = 1;
        while j < k { cp = (cp << 6) | (byte_at(t, i + j) & 63); j += 1; }
        if cp >= 65536 {
            let v = cp - 65536;
            ow_u4(55296 + (v >> 10));
            ow_u4(56320 + (v & 1023));
        } else { ow_u4(cp); }
        i += k;
        rs = i;
    }
    if i > rs { jj.o.text += substr(t, rs, i - rs); }
}

fn ow_u4(v: i64) {
    jj.o.text += "\\u";
    var sh = 12;
    while sh >= 0 {
        jj.o.text += substr("0123456789abcdef", (v >> sh) & 15, 1);
        sh -= 4;
    }
}

// append the byte run to a destination (see put in eval.mito)
fn emit_run(doc: text, s: i64, n: i64, dst: i64) {
    if n <= 0 { return; }
    put(dst, substr(doc, s, n));
}

// the length of the UTF-8 sequence at i (before end) as jq's decoder reads it: n > 0 for a valid one, -n for an invalid one that
// is replaced by one U+FFFD and consumes n bytes
fn utf8_len(doc: text, i: i64, end: i64) -> i64 {
    let c = byte_at(doc, i);
    if c < 128 { return 1; }
    if c < 194 { return -1; }
    var need = 4;
    if c < 224 { need = 2; } else if c < 240 { need = 3; } else if c > 244 { return -1; }
    var k = 1;
    while k < need {
        var b = -1;
        if i + k < end { b = byte_at(doc, i + k); }
        if b < 128 || b > 191 { return -k; }
        k += 1;
    }
    let b1 = byte_at(doc, i + 1);
    if c == 224 && b1 < 160 { return -need; }
    if c == 237 && b1 >= 160 { return -need; }
    if c == 240 && b1 < 144 { return -need; }
    if c == 244 && b1 >= 144 { return -need; }
    return need;
}

// the code point of the escape at i (a backslash): the character, with jj.sc.esc left as the length of the escape
fn escape_cp(doc: text, i: i64) -> i64 {
    let d = byte_at(doc, i + 1);
    if d == 117 {
        let h = hex4(doc, i + 2);
        if h >= 55296 && h <= 56319 {
            let l = hex4(doc, i + 8);
            jj.sc.esc = 12;
            return 65536 + ((h - 55296) << 10) + (l - 56320);
        }
        jj.sc.esc = 6;
        if h >= 56320 && h <= 57343 { return 65533; }
        return h;
    }
    jj.sc.esc = 2;
    if d == 110 { return 10; }
    if d == 116 { return 9; }
    if d == 114 { return 13; }
    if d == 98 { return 8; }
    if d == 102 { return 12; }
    return d;                      // " \ /
}

// the string at [a, b) (with its quotes), unescaped and with invalid UTF-8 replaced, into a destination
fn decode_to(doc: text, a: i64, b: i64, dst: i64) {
    var i = a + 1;
    let end = b - 1;
    var rs = i;
    while i < end {
        let c = byte_at(doc, i);
        if c < 128 && c != 92 { i += 1; continue; }
        if c >= 128 {
            let n = utf8_len(doc, i, end);
            if n > 0 { i += n; continue; }
            emit_run(doc, rs, i - rs, dst);
            put(dst, chr(65533));
            i += -n;
            rs = i;
            continue;
        }
        emit_run(doc, rs, i - rs, dst);
        let cp = escape_cp(doc, i);
        if cp == 0 { put(dst, "\0"); } else { put(dst, chr(cp)); }
        i += jj.sc.esc;
        rs = i;
    }
    emit_run(doc, rs, i - rs, dst);
}

fn decode_string(doc: text, a: i64, b: i64) {
    jj.tmp = "";
    decode_to(doc, a, b, 0);
}

fn write_cp_escaped(cp: i64) {
    if cp == 34 { ow("\\\""); }
    else if cp == 92 { ow("\\\\"); }
    else if cp == 10 { ow("\\n"); }
    else if cp == 9 { ow("\\t"); }
    else if cp == 13 { ow("\\r"); }
    else if cp == 8 { ow("\\b"); }
    else if cp == 12 { ow("\\f"); }
    else if cp < 32 || cp == 127 {
        ow("\\u00");
        ow(substr("0123456789abcdef", cp / 16, 1));
        ow(substr("0123456789abcdef", cp % 16, 1));
    }
    else { ow(chr(cp)); }
}

// the string at [a, b) (with its quotes) as jq writes it: escapes normalized, invalid UTF-8 replaced
fn write_string_norm(doc: text, a: i64, b: i64) {
    ow("\"");
    var i = a + 1;
    let end = b - 1;
    var rs = i;
    while i < end {
        let c = byte_at(doc, i);
        if c < 127 && c != 92 { i += 1; continue; }
        if c >= 128 {
            let n = utf8_len(doc, i, end);
            if n > 0 { i += n; continue; }
            emit_run(doc, rs, i - rs, 1);
            ow(chr(65533));
            i += -n;
            rs = i;
            continue;
        }
        emit_run(doc, rs, i - rs, 1);
        if c == 127 {
            ow("\\u007f");
            i += 1;
        } else {
            let cp = escape_cp(doc, i);
            i += jj.sc.esc;
            write_cp_escaped(cp);
        }
        rs = i;
    }
    emit_run(doc, rs, i - rs, 1);
    ow("\"");
}

// plain bytes (already valid UTF-8) of t at [o, o+n) as a JSON string
fn write_plain(t: text, o: i64, n: i64) {
    ow("\"");
    var i = o;
    let end = o + n;
    var rs = o;
    while i < end {
        let c = byte_at(t, i);
        if c >= 32 && c != 34 && c != 92 && c != 127 { i += 1; continue; }
        if i > rs { ow(substr(t, rs, i - rs)); }
        write_cp_escaped(c);
        i += 1;
        rs = i;
    }
    if i > rs { ow(substr(t, rs, i - rs)); }
    ow("\"");
}

// digits [x, y) of the virtual digit string (integer digits at is, then fraction digits at fs)
fn emit_digits(doc: text, is: i64, ilen: i64, fs: i64, x: i64, y: i64) {
    if x < ilen {
        var ye = y;
        if ye > ilen { ye = ilen; }
        if ye > x { ow(substr(doc, is + x, ye - x)); }
    }
    var xf = x;
    if xf < ilen { xf = ilen; }
    if y > xf { ow(substr(doc, fs + (xf - ilen), y - xf)); }
}

// the number at [a, b) in decNumber's scientific string form. mode 0 as written, 1 absolute value, 2 negated
fn write_number(doc: text, a: i64, b: i64, mode: i64) {
    var i = a;
    var neg = byte_at(doc, i) == 45;
    if neg { i += 1; }
    let is = i;
    while is_digit(byte_at(doc, i)) { i += 1; }
    let ilen = i - is;
    var fs = i;
    var flen = 0;
    var ex = 0;
    var more = false;
    if byte_at(doc, i) == 46 {
        fs = i + 1;
        i = fs;
        while is_digit(byte_at(doc, i)) { i += 1; }
        flen = i - fs;
        more = true;
    }
    let ec = byte_at(doc, i);
    if ec == 101 || ec == 69 {
        more = true;
        i += 1;
        var es = false;
        if byte_at(doc, i) == 45 { es = true; i += 1; }
        else if byte_at(doc, i) == 43 { i += 1; }
        while is_digit(byte_at(doc, i)) {
            if ex < 100000000000000 { ex = ex * 10 + byte_at(doc, i) - 48; }
            i += 1;
        }
        if es { ex = -ex; }
    }
    // a negated zero is zero
    var allzero = true;
    var z = 0;
    while z < ilen && allzero { if byte_at(doc, is + z) != 48 { allzero = false; } z += 1; }
    z = 0;
    while z < flen && allzero { if byte_at(doc, fs + z) != 48 { allzero = false; } z += 1; }
    if mode == 1 { neg = false; }
    else if mode == 2 { neg = !neg; if allzero { neg = false; } }
    if neg { ow("-"); }
    if !more {
        ow(substr(doc, is, ilen));
        return;
    }
    // the coefficient: the digits without leading zeros; all zero is "0"
    let total = ilen + flen;
    var k = 0;
    while k < total - 1 {
        var dg = 0;
        if k < ilen { dg = byte_at(doc, is + k); } else { dg = byte_at(doc, fs + (k - ilen)); }
        if dg != 48 { break; }
        k += 1;
    }
    let n = total - k;             // digits kept (at least one: all zeros keep the last)
    let e = ex - flen;
    let adj = e + n - 1;
    if e <= 0 && adj >= -6 {
        if e == 0 { emit_digits(doc, is, ilen, fs, k, total); return; }
        let pointpos = n + e;      // digits before the decimal point
        if pointpos > 0 {
            emit_digits(doc, is, ilen, fs, k, k + pointpos);
            ow(".");
            emit_digits(doc, is, ilen, fs, k + pointpos, total);
        } else {
            ow("0.");
            var zz = pointpos;
            while zz < 0 { ow("0"); zz += 1; }
            emit_digits(doc, is, ilen, fs, k, total);
        }
        return;
    }
    emit_digits(doc, is, ilen, fs, k, k + 1);
    if n > 1 {
        ow(".");
        emit_digits(doc, is, ilen, fs, k + 1, total);
    }
    ow("E");
    if adj >= 0 { ow("+"); ow(str(adj)); } else { ow("-"); ow(str(-adj)); }
}

// a container (validated) at [a, b): tokens re-written compact or indented, starting at nesting depth base
fn write_container(doc: text, a: i64, b: i64, base: i64) {
    var p = a;
    var depth = base;
    while p < b {
        let c = byte_at(doc, p);
        if c == 34 {
            let e = scan_string(doc, p);
            if jj.sc.esc != 0 { write_string_norm(doc, p, e); } else { ow(substr(doc, p, e - p)); }
            p = e;
        } else if c == 123 || c == 91 {
            let q = skip_ws(doc, p + 1);
            let d = byte_at(doc, q);
            if (c == 123 && d == 125) || (c == 91 && d == 93) {
                ow(substr(doc, p, 1));
                ow(substr(doc, q, 1));
                p = q + 1;
            } else {
                ow(substr(doc, p, 1));
                depth += 1;
                if jj.o.pretty { newline_indent(depth); }
                p = q;
            }
        } else if c == 125 || c == 93 {
            depth -= 1;
            if jj.o.pretty { newline_indent(depth); }
            ow(substr(doc, p, 1));
            p += 1;
        } else if c == 44 {
            ow(",");
            if jj.o.pretty { newline_indent(depth); }
            p = skip_ws(doc, p + 1);
        } else if c == 58 {
            ow(":");
            if jj.o.pretty { ow(" "); }
            p = skip_ws(doc, p + 1);
        } else if c == 32 || c == 10 || c == 13 || c == 9 {
            p += 1;
        } else {
            var e = p;
            while true {
                let d = byte_at(doc, e);
                if d == 44 || d == 125 || d == 93 || d == 32 || d == 10 || d == 13 || d == 9 || d < 0 { break; }
                e += 1;
            }
            if c == 45 || is_digit(c) { write_number(doc, p, e, 0); } else { ow(substr(doc, p, e - p)); }
            p = e;
        }
    }
}

// a string entry as a JSON string (or raw)
fn write_string_h(doc: text, filter: text, h: i64, raw: bool) {
    let s = jj.v.vs[h];
    let a = jj.v.va[h];
    let b = jj.v.vb[h];
    if s == 0 {
        if raw {
            if jj.v.vf[h] != 0 { decode_to(doc, a, b, 1); } else { ow(substr(doc, a + 1, b - a - 2)); }
        } else {
            if jj.v.vf[h] != 0 { write_string_norm(doc, a, b); } else { ow(substr(doc, a, b - a)); }
        }
        return;
    }
    if raw {
        if s == 1 { ow(substr(jj.f.lits, a, b)); }
        else if s == 2 { ow(substr(jj.ev.scr, a, b)); }
        else { ow(substr(jj.ev.ptx, a, b)); }
        return;
    }
    if s == 1 { write_plain(jj.f.lits, a, b); }
    else if s == 2 { write_plain(jj.ev.scr, a, b); }
    else { write_plain(jj.ev.ptx, a, b); }
}

// a value entry as a result or inside one, at nesting depth `depth`
fn write_h(doc: text, filter: text, h: i64, depth: i64) {
    let t = jj.v.vt[h];
    if t == 1 { ow("null"); return; }
    if t == 2 { ow("false"); return; }
    if t == 3 { ow("true"); return; }
    if t == 4 {
        let s = jj.v.vs[h];
        if s == 4 { ow(str(jj.v.va[h])); return; }
        if s == 3 { fmt_dbl(jj.v.vx[h]); ow(jj.num.buf); return; }
        var mode = 0;
        if (jj.v.vf[h] & 2) != 0 { mode = 1; } else if (jj.v.vf[h] & 1) != 0 { mode = 2; }
        if s == 0 { write_number(doc, jj.v.va[h], jj.v.vb[h], mode); } else if s == 2 { write_number(jj.ev.scr, jj.v.va[h], jj.v.vb[h], mode); } else if s == 5 { write_number(jj.ev.ptx, jj.v.va[h], jj.v.vb[h], mode); } else { write_number(filter, jj.v.va[h], jj.v.vb[h], mode); }
        return;
    }
    if t == 5 { write_string_h(doc, filter, h, depth == 0 && jj.o.raw); return; }
    if jj.v.vs[h] == 0 { write_container(doc, jj.v.va[h], jj.v.vb[h], depth); return; }
    // built
    var p = jj.v.va[h];
    if p < 0 { if t == 7 { ow("{}"); } else { ow("[]"); } return; }
    if t == 7 { ow("{"); } else { ow("["); }
    var first = true;
    while p >= 0 {
        if !first { ow(","); }
        first = false;
        if jj.o.pretty { newline_indent(depth + 1); }
        if t == 7 {
            write_string_h(doc, filter, jj.v.va[p], false);
            ow(":");
            if jj.o.pretty { ow(" "); }
            write_h(doc, filter, jj.v.vb[p], depth + 1);
        } else {
            write_h(doc, filter, p, depth + 1);
        }
        p = jj.v.vn[p];
    }
    if jj.o.pretty { newline_indent(depth); }
    if t == 7 { ow("}"); } else { ow("]"); }
}

// the slot of node n as a result or inside one (what write_h prints for node_val(n), without the entry); -1 on a navigation error
fn write_slot(doc: text, n: i64, depth: i64) -> i64 {
    if jj.sc.anyerr { if nav_check(n) != 0 { return -1; } }
    if jj.sc.sgen[n] != gen_of(n) { ow("null"); return 0; }
    let tag = jj.sc.stag[n];
    if tag == 1 { ow("null"); return 0; }
    if tag == 2 { ow("false"); return 0; }
    if tag == 3 { ow("true"); return 0; }
    let a = jj.sc.sa[n];
    let b = jj.sc.sb[n];
    if tag == 4 {
        if jj.sc.sisint[n] != 0 { ow(str(jj.sc.sint[n])); } else { write_number(doc, a, b, 0); }
        return 0;
    }
    if tag == 5 {
        if depth == 0 && jj.o.raw {
            if jj.sc.sesc[n] != 0 { decode_to(doc, a, b, 1); } else { ow(substr(doc, a + 1, b - a - 2)); }
        } else {
            if jj.sc.sesc[n] != 0 { write_string_norm(doc, a, b); } else { ow(substr(doc, a, b - a)); }
        }
        return 0;
    }
    write_container(doc, a, b, depth);
    return 0;
}

// a result starts: remember where, so an error before it ends can take it back (a stream reports the error and goes on)
fn res_begin() {
    jj.o.open = true;
    jj.o.cut = len(jj.o.text);
    jj.o.cut_sep = jj.o.sep;
    jj.o.cut_res = jj.o.results;
    jj.o.cut_last = jj.o.lastpos;
}

// an error stopped the value: a result left half written is taken back
fn res_cut() {
    if !jj.o.open { return; }
    jj.o.text = substr(jj.o.text, 0, jj.o.cut);
    jj.o.sep = jj.o.cut_sep;
    jj.o.results = jj.o.cut_res;
    jj.o.lastpos = jj.o.cut_last;
    jj.o.open = false;
}
