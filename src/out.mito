// Writing values the way jq 1.8.2 does: strings re-escaped, numbers in decNumber's form (1e3 becomes 1E+3, 0.0001e5 becomes 1E+1),
// containers compact or indented. A value is a span of the (already validated) input.

fn begin_result() {
    if j.o.sep { j.o.text += "\n"; }
    j.o.sep = true;
    j.o.results += 1;
}

fn newline_indent(depth: i64) {
    j.o.text += "\n";
    var k = 0;
    while k < depth { j.o.text += "  "; k += 1; }
}

// append the code point or byte run to the destination: the output (to_out) or the scratch string
fn emit_run(doc: text, s: i64, n: i64, to_out: bool) {
    if n <= 0 { return; }
    if to_out { j.o.text += substr(doc, s, n); } else { j.tmp += substr(doc, s, n); }
}

fn emit_text(t: text, to_out: bool) {
    if to_out { j.o.text += t; } else { j.tmp += t; }
}

// the code point of the escape at i (a backslash): the character, with j.sc.esc left as the length of the escape
fn escape_cp(doc: text, i: i64) -> i64 {
    let d = byte_at(doc, i + 1);
    if d == 117 {
        let h = hex4(doc, i + 2);
        if h >= 55296 && h <= 56319 {
            let l = hex4(doc, i + 8);
            j.sc.esc = 12;
            return 65536 + ((h - 55296) << 10) + (l - 56320);
        }
        j.sc.esc = 6;
        if h >= 56320 && h <= 57343 { return 65533; }
        return h;
    }
    j.sc.esc = 2;
    if d == 110 { return 10; }
    if d == 116 { return 9; }
    if d == 114 { return 13; }
    if d == 98 { return 8; }
    if d == 102 { return 12; }
    return d;                      // " \ /
}

// the string at [a, b) (with its quotes), unescaped, into the scratch string or the output
fn decode_to(doc: text, a: i64, b: i64, to_out: bool) {
    var i = a + 1;
    let end = b - 1;
    var rs = i;
    while i < end {
        if byte_at(doc, i) != 92 { i += 1; continue; }
        emit_run(doc, rs, i - rs, to_out);
        let cp = escape_cp(doc, i);
        if cp == 0 { emit_text("\0", to_out); } else { emit_text(chr(cp), to_out); }
        i += j.sc.esc;
        rs = i;
    }
    emit_run(doc, rs, i - rs, to_out);
}

fn decode_string(doc: text, a: i64, b: i64) {
    j.tmp = "";
    decode_to(doc, a, b, false);
}

// the string at [a, b) as jq writes it: escapes normalized
fn write_string_norm(doc: text, a: i64, b: i64) {
    j.o.text += "\"";
    var i = a + 1;
    let end = b - 1;
    var rs = i;
    while i < end {
        let c = byte_at(doc, i);
        if c != 92 && c != 127 { i += 1; continue; }
        emit_run(doc, rs, i - rs, true);
        if c == 127 {
            j.o.text += "\\u007f";
            i += 1;
        } else {
            let cp = escape_cp(doc, i);
            i += j.sc.esc;
            if cp == 34 { j.o.text += "\\\""; }
            else if cp == 92 { j.o.text += "\\\\"; }
            else if cp == 10 { j.o.text += "\\n"; }
            else if cp == 9 { j.o.text += "\\t"; }
            else if cp == 13 { j.o.text += "\\r"; }
            else if cp == 8 { j.o.text += "\\b"; }
            else if cp == 12 { j.o.text += "\\f"; }
            else if cp < 32 || cp == 127 {
                j.o.text += "\\u00";
                j.o.text += substr("0123456789abcdef", cp / 16, 1);
                j.o.text += substr("0123456789abcdef", cp % 16, 1);
            }
            else if cp == 0 { j.o.text += "\\u0000"; }
            else { j.o.text += chr(cp); }
        }
        rs = i;
    }
    emit_run(doc, rs, i - rs, true);
    j.o.text += "\"";
}

// digits [x, y) of the virtual digit string (integer digits at is, then fraction digits at fs)
fn emit_digits(doc: text, is: i64, ilen: i64, fs: i64, x: i64, y: i64) {
    if x < ilen {
        var ye = y;
        if ye > ilen { ye = ilen; }
        if ye > x { j.o.text += substr(doc, is + x, ye - x); }
    }
    var xf = x;
    if xf < ilen { xf = ilen; }
    if y > xf { j.o.text += substr(doc, fs + (xf - ilen), y - xf); }
}

// the number at [a, b) in decNumber's scientific string form; abs drops the minus sign
fn write_number(doc: text, a: i64, b: i64, abs: bool) {
    var i = a;
    let neg = byte_at(doc, i) == 45;
    if neg { i += 1; }
    let is = i;
    while is_digit(byte_at(doc, i)) { i += 1; }
    let ilen = i - is;
    var fs = i;
    var flen = 0;
    var ex = 0;
    var more = false;
    if byte_at(doc, i) == 46 {
        fs = i + 1;
        i = fs;
        while is_digit(byte_at(doc, i)) { i += 1; }
        flen = i - fs;
        more = true;
    }
    let ec = byte_at(doc, i);
    if ec == 101 || ec == 69 {
        more = true;
        i += 1;
        var es = false;
        if byte_at(doc, i) == 45 { es = true; i += 1; }
        else if byte_at(doc, i) == 43 { i += 1; }
        while is_digit(byte_at(doc, i)) {
            if ex < 100000000000000 { ex = ex * 10 + byte_at(doc, i) - 48; }
            i += 1;
        }
        if es { ex = -ex; }
    }
    if neg && !abs { j.o.text += "-"; }
    if !more {
        j.o.text += substr(doc, is, ilen);
        return;
    }
    // the coefficient: the digits without leading zeros; all zero is "0"
    let total = ilen + flen;
    var k = 0;
    while k < total - 1 {
        var dg = 0;
        if k < ilen { dg = byte_at(doc, is + k); } else { dg = byte_at(doc, fs + (k - ilen)); }
        if dg != 48 { break; }
        k += 1;
    }
    let n = total - k;             // digits kept (at least one: all zeros keep the last)
    let e = ex - flen;
    let adj = e + n - 1;
    if e <= 0 && adj >= -6 {
        if e == 0 { emit_digits(doc, is, ilen, fs, k, total); return; }
        let pointpos = n + e;      // digits before the decimal point
        if pointpos > 0 {
            emit_digits(doc, is, ilen, fs, k, k + pointpos);
            j.o.text += ".";
            emit_digits(doc, is, ilen, fs, k + pointpos, total);
        } else {
            j.o.text += "0.";
            var z = pointpos;
            while z < 0 { j.o.text += "0"; z += 1; }
            emit_digits(doc, is, ilen, fs, k, total);
        }
        return;
    }
    emit_digits(doc, is, ilen, fs, k, k + 1);
    if n > 1 {
        j.o.text += ".";
        emit_digits(doc, is, ilen, fs, k + 1, total);
    }
    j.o.text += "E";
    if adj >= 0 { j.o.text += "+"; j.o.text += str(adj); } else { j.o.text += "-"; j.o.text += str(-adj); }
}

// a container (validated) at [a, b): tokens re-written compact or indented
fn write_container(doc: text, a: i64, b: i64) {
    var p = a;
    var depth = 0;
    while p < b {
        let c = byte_at(doc, p);
        if c == 34 {
            let e = scan_string(doc, p);
            if j.sc.esc != 0 { write_string_norm(doc, p, e); } else { j.o.text += substr(doc, p, e - p); }
            p = e;
        } else if c == 123 || c == 91 {
            let q = skip_ws(doc, p + 1);
            let d = byte_at(doc, q);
            if (c == 123 && d == 125) || (c == 91 && d == 93) {
                j.o.text += substr(doc, p, 1);
                j.o.text += substr(doc, q, 1);
                p = q + 1;
            } else {
                j.o.text += substr(doc, p, 1);
                depth += 1;
                if j.o.pretty { newline_indent(depth); }
                p = q;
            }
        } else if c == 125 || c == 93 {
            depth -= 1;
            if j.o.pretty { newline_indent(depth); }
            j.o.text += substr(doc, p, 1);
            p += 1;
        } else if c == 44 {
            j.o.text += ",";
            if j.o.pretty { newline_indent(depth); }
            p = skip_ws(doc, p + 1);
        } else if c == 58 {
            j.o.text += ":";
            if j.o.pretty { j.o.text += " "; }
            p = skip_ws(doc, p + 1);
        } else if c == 32 || c == 10 || c == 13 || c == 9 {
            p += 1;
        } else {
            var e = p;
            while true {
                let d = byte_at(doc, e);
                if d == 44 || d == 125 || d == 93 || d == 32 || d == 10 || d == 13 || d == 9 || d < 0 { break; }
                e += 1;
            }
            if c == 45 || is_digit(c) { write_number(doc, p, e, false); } else { j.o.text += substr(doc, p, e - p); }
            p = e;
        }
    }
}

// a value of the given tag at [a, b) as a result
fn write_value(doc: text, tag: i64, a: i64, b: i64, esc: i64) {
    begin_result();
    if tag == 5 {
        if j.o.raw {
            if esc != 0 { decode_to(doc, a, b, true); } else { j.o.text += substr(doc, a + 1, b - a - 2); }
        } else {
            if esc != 0 { write_string_norm(doc, a, b); } else { j.o.text += substr(doc, a, b - a); }
        }
    } else if tag == 4 {
        write_number(doc, a, b, false);
    } else if tag == 6 || tag == 7 {
        write_container(doc, a, b);
    } else {
        j.o.text += substr(doc, a, b - a);
    }
}
