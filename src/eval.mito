// Values and the evaluator. A value is an entry of the arena (fields of J.v, documented in jx.mito); constants of the filter are
// entries below index 4096. The arena has one region per nesting depth of scopes: depth 0 (the document level) is never rewound,
// depth d >= 1 is rewound when an element of a unit of that depth ends. Results that outlive an element (appended to a register of
// an outer level) are copied into the register's region.
//
// The bytecode (lower.mito) runs on these values: exec (exec.mito) calls the helpers below, which return an entry, or -1 with
// jj.ev.err = 1 (a jq error) or 2 (not supported, fatal) and the message in jj.err.

fn ev_init() {
    jj.v.ncon = 1;
    jj.f.lits = "nullbooleannumberstringarrayobjectfalsetrue";
    jj.ev.hnull = new_const(1, 0, 0, 0);
    jj.ev.hfalse = new_const(2, 0, 0, 0);
    jj.ev.htrue = new_const(3, 0, 0, 0);
    jj.ev.htype[1] = new_const(5, 1, 0, 4);
    jj.ev.htype[2] = new_const(5, 1, 4, 7);
    jj.ev.htype[3] = new_const(5, 1, 11, 6);
    jj.ev.htype[4] = new_const(5, 1, 17, 6);
    jj.ev.htype[5] = new_const(5, 1, 23, 5);
    jj.ev.htype[6] = new_const(5, 1, 28, 6);
    var z = 0.0;
    jj.ev.nanv = z / z;
    jj.ev.harr0 = new_const(6, 1, -1, -1);
    jj.v.base[1] = 4096;
    jj.v.base[2] = 4096 + Lim.REG1;
    jj.v.base[3] = 4096 + 2 * Lim.REG1;
    jj.v.base[0] = 4096 + 3 * Lim.REG1;
    var d = 0;
    while d < 4 {
        jj.v.top[d] = jj.v.base[d];
        d += 1;
    }
    jj.v.cap[1] = jj.v.base[2];
    jj.v.cap[2] = jj.v.base[3];
    jj.v.cap[3] = jj.v.base[0];
    jj.v.cap[0] = jj.v.base[0] + Lim.REG0;
}

fn fatal(msg: text) -> i64 {
    jj.ev.err = 2;
    jj.exitc = 1;
    jj.err = "jx: not supported in Stage 2: " + msg;
    return -1;
}

// the compact JSON text of v cut to jq's message size, in jj.ev.tmp3
fn vdesc(doc: text, filter: text, h: i64) -> i64 {
    let t = tojson_of(doc, filter, h);
    if t < 0 { jj.ev.tmp3 = "?"; return 0; }
    let n = str_plain(doc, t, 3);
    if n > 29 {
        let lc = byte_at(jj.ev.tmp3, n - 1);
        if lc == 34 || lc == 93 || lc == 125 { jj.ev.tmp3 = substr(jj.ev.tmp3, 0, 25) + "..." + substr(jj.ev.tmp3, n - 1, 1); }
        else { jj.ev.tmp3 = substr(jj.ev.tmp3, 0, 26) + "..."; }
    }
    return 0;
}

// "number (1)" as jq words a value in an error
fn typed(doc: text, filter: text, h: i64) -> text {
    vdesc(doc, filter, h);
    return tag_name(jj.v.vt[h]) + " (" + jj.ev.tmp3 + ")";
}

fn jqerr(msg: text) -> i64 {
    jj.ev.err = 1;
    jj.exitc = 5;
    jj.err = "jx: error: " + msg;
    jj.ev.rawmsg = msg;
    // the message as a value, for `catch`
    let off = len(jj.ev.scr);
    if off + len(msg) < 16000000 {
        jj.ev.scr += msg;
        let h = ent(5, 2, off, len(msg));
        jj.ev.errv = h;
    } else { jj.ev.errv = jj.ev.hnull; }
    return -1;
}

fn ar_alloc(d: i64) -> i64 {
    let h = jj.v.top[d];
    if h >= jj.v.cap[d] {
        jj.ev.err = 2;
        jj.exitc = 1;
        jj.err = "jx: out of value memory at nesting depth " + str(d) + " (the filter keeps more values than the arena holds)";
        return -1;
    }
    jj.v.top[d] = h + 1;
    return h;
}

fn ent(tag: i64, vs: i64, a: i64, b: i64) -> i64 {
    let h = ar_alloc(jj.ev.depth);
    if h < 0 { return -1; }
    jj.v.vt[h] = tag;
    jj.v.vs[h] = vs;
    jj.v.va[h] = a;
    jj.v.vb[h] = b;
    jj.v.vf[h] = 0;
    jj.v.vd[h] = -1;
    jj.v.vn[h] = -1;
    return h;
}

fn mk_dbl(x: f64) -> i64 {
    let h = ent(4, 3, 0, 0);
    if h < 0 { return -1; }
    jj.v.vx[h] = x;
    return h;
}

fn mk_bool(b: bool) -> i64 {
    if b { return jj.ev.htrue; }
    return jj.ev.hfalse;
}

fn truthy(h: i64) -> bool {
    return jj.v.vt[h] >= 3;
}

fn type_idx(t: i64) -> i64 {
    if t == 3 { return 2; }
    if t >= 4 { return t - 1; }
    return t;
}

fn type_name(h: i64) -> text {
    return tag_name(jj.v.vt[h]);
}

fn tag_name(t: i64) -> text {
    if t == 1 { return "null"; }
    if t == 2 || t == 3 { return "boolean"; }
    if t == 4 { return "number"; }
    if t == 5 { return "string"; }
    if t == 6 { return "array"; }
    return "object";
}

// ---- slots as values ----

// the first ancestor edge of node n that could not be navigated (the value above it was of the wrong type), else 0
fn nav_check(n: i64) -> i64 {
    if !jj.sc.anyerr { return 0; }
    var c = n;
    var bad = -1;
    var tag = 0;
    while jj.f.par[c] >= 0 {
        let p = jj.f.par[c];
        if jj.sc.serrg[p] == gen_of(p) && jj.f.niter[p] != c {
            // the kind of the edge from p to c
            var e = jj.f.nfirst[p];
            while e != 0 {
                if jj.f.enode[e] == c { break; }
                e = jj.f.enext[e];
            }
            if e != 0 {
                if jj.f.ekind[e] == 0 && jj.sc.serr[p] != 0 { bad = c; tag = jj.sc.serr[p]; }
                if jj.f.ekind[e] == 1 && jj.sc.serri[p] != 0 { bad = c; tag = jj.sc.serri[p]; }
            }
        }
        c = p;
    }
    if bad < 0 { return 0; }
    let tn = tag_name(tag);
    var e = jj.f.nfirst[jj.f.par[bad]];
    while e != 0 {
        if jj.f.enode[e] == bad { break; }
        e = jj.f.enext[e];
    }
    if e != 0 && jj.f.ekind[e] == 0 { return jqerr("Cannot index " + tn + " with string (\"" + substr(jj.f.keys, jj.f.ea[e], jj.f.eb[e]) + "\")"); }
    return jqerr("Cannot index " + tn + " with number (" + str(jj.f.ea[e]) + ")");
}

// the value of node n's slot as an entry (null when it was not filled)
fn slot_val(n: i64) -> i64 {
    if jj.sc.sgen[n] != gen_of(n) { return jj.ev.hnull; }
    let tag = jj.sc.stag[n];
    if tag <= 3 {
        if tag == 1 { return jj.ev.hnull; }
        if tag == 2 { return jj.ev.hfalse; }
        return jj.ev.htrue;
    }
    var h = -1;
    if tag == 4 {
        if jj.sc.sisint[n] != 0 { h = ent(4, 4, jj.sc.sint[n], 0); }
        else { h = ent(4, 0, jj.sc.sa[n], jj.sc.sb[n]); }
    } else if tag == 5 {
        h = ent(5, 0, jj.sc.sa[n], jj.sc.sb[n]);
        if h >= 0 { jj.v.vf[h] = jj.sc.sesc[n]; }
    } else {
        h = ent(tag, 0, jj.sc.sa[n], jj.sc.sb[n]);
        if h >= 0 { jj.v.vf[h] = jj.sc.scnt[n]; jj.v.vd[h] = n; }
    }
    return h;
}

fn node_val(n: i64) -> i64 {
    if jj.sc.anyerr { if nav_check(n) != 0 { return -1; } }
    return slot_val(n);
}

// ---- strings ----

// emit into a destination: 0 jj.tmp, 1 the output, 2 tmp2, 3 tmp3, 4 the scratch string
fn put(dst: i64, t: text) {
    if dst == 0 { jj.tmp += t; }
    else if dst == 1 { ow(t); }
    else if dst == 2 { jj.ev.tmp2 += t; }
    else if dst == 3 { jj.ev.tmp3 += t; }
    else { jj.ev.scr += t; }
}

fn clear_dst(dst: i64) {
    if dst == 0 { jj.tmp = ""; }
    else if dst == 2 { jj.ev.tmp2 = ""; }
    else if dst == 3 { jj.ev.tmp3 = ""; }
}

// the plain bytes of string entry h, into the destination (cleared first for the temporaries); the length
fn str_plain(doc: text, h: i64, dst: i64) -> i64 {
    clear_dst(dst);
    let s = jj.v.vs[h];
    let a = jj.v.va[h];
    let b = jj.v.vb[h];
    if s == 0 {
        if jj.v.vf[h] == 0 { put(dst, substr(doc, a + 1, b - a - 2)); return b - a - 2; }
        decode_to(doc, a, b, dst);
    } else if s == 1 { put(dst, substr(jj.f.lits, a, b)); return b; }
    else if s == 2 { put(dst, substr(jj.ev.scr, a, b)); return b; }
    else { put(dst, substr(jj.ev.ptx, a, b)); return b; }
    if dst == 0 { return len(jj.tmp); }
    if dst == 2 { return len(jj.ev.tmp2); }
    return len(jj.ev.tmp3);
}

// compare strings x and y (entries): -1, 0, 1 by bytes of their plain forms
fn str_cmp(doc: text, x: i64, y: i64) -> i64 {
    let nx = str_plain(doc, x, 0);
    let ny = str_plain(doc, y, 2);
    return bytes_cmp(jj.tmp, 0, nx, jj.ev.tmp2, 0, ny);
}

// a new string entry from the plain bytes in jj.tmp, kept in the scratch string
fn str_from_tmp() -> i64 {
    let n = len(jj.tmp);
    if len(jj.ev.scr) + n > 16000000 { return fatal("strings built by the filter exceed the 16 MB scratch string"); }
    let off = len(jj.ev.scr);
    jj.ev.scr += jj.tmp;
    return ent(5, 2, off, n);
}

// ---- numbers ----

fn numd(doc: text, filter: text, h: i64) -> f64 {
    let s = jj.v.vs[h];
    var x = 0.0;
    if s == 4 { x = jj.v.va[h] as f64; }
    else if s == 3 { return jj.v.vx[h]; }
    else if s == 0 { x = num_parse(doc, jj.v.va[h], jj.v.vb[h]); }
    else { x = num_parse(filter, jj.v.va[h], jj.v.vb[h]); }
    let f = jj.v.vf[h];
    if (f & 2) != 0 { if x < 0.0 { x = -x; } return x; }
    if (f & 1) != 0 { x = -x; }
    return x;
}

// the text of a literal number entry into dst (jj.tmp or tmp2)
fn lit_text(doc: text, filter: text, h: i64, dst: i64) {
    clear_dst(dst);
    let s = jj.v.vs[h];
    if s == 4 { put(dst, str(jj.v.va[h])); }
    else if s == 0 { put(dst, substr(doc, jj.v.va[h], jj.v.vb[h] - jj.v.va[h])); }
    else { put(dst, substr(filter, jj.v.va[h], jj.v.vb[h] - jj.v.va[h])); }
}

fn is_lit(h: i64) -> bool {
    return jj.v.vs[h] != 3 && jj.v.vf[h] == 0;
}

// the order of two numbers as jq has it: exact on two literals, by double otherwise; nan is below everything
fn num_cmp3(doc: text, filter: text, x: i64, y: i64) -> i64 {
    if is_lit(x) && is_lit(y) {
        if jj.v.vs[x] == 4 && jj.v.vs[y] == 4 {
            if jj.v.va[x] < jj.v.va[y] { return -1; }
            if jj.v.va[x] > jj.v.va[y] { return 1; }
            return 0;
        }
        lit_text(doc, filter, x, 0);
        lit_text(doc, filter, y, 2);
        return num_cmp(jj.tmp, 0, len(jj.tmp), jj.ev.tmp2, 0, len(jj.ev.tmp2));
    }
    let a = numd(doc, filter, x);
    let b = numd(doc, filter, y);
    if a != a { return -1; }
    if b != b { return 1; }
    if a < b { return -1; }
    if a > b { return 1; }
    return 0;
}

// ---- comparison ----

// jq's order: -1, 0, 1; -2 when it cannot be decided (error set)
fn cmp_vals(doc: text, filter: text, x: i64, y: i64) -> i64 {
    let tx = jj.v.vt[x];
    let ty = jj.v.vt[y];
    if tx != ty { if tx < ty { return -1; } return 1; }
    if tx <= 3 { return 0; }
    if tx == 4 { return num_cmp3(doc, filter, x, y); }
    if tx == 5 { return str_cmp(doc, x, y); }
    if jj.v.vs[x] != 1 || jj.v.vs[y] != 1 {
        let bx = built_of(doc, x);
        let by = built_of(doc, y);
        if bx < 0 || by < 0 { return -2; }
        return cmp_vals(doc, filter, bx, by);
    }
    if tx == 7 { return cmp_objects(doc, filter, x, y); }
    var px = jj.v.va[x];
    var py = jj.v.va[y];
    while px >= 0 && py >= 0 {
        let c = cmp_vals(doc, filter, px, py);
        if c != 0 { return c; }
        px = jj.v.vn[px];
        py = jj.v.vn[py];
    }
    if px < 0 && py < 0 { return 0; }
    if px < 0 { return -1; }
    return 1;
}


// ---- values built from the document ----

// attach value h to the open container sp (or make it the result when sp is 0)
fn mat_deliver(doc: text, sp: i64, h: i64, res: i64) -> i64 {
    if sp == 0 { return h; }
    var x = h;
    if jj.ev.ms_kind[sp] == 6 {
        if x < 4096 || jj.v.vn[x] >= 0 {
            let c = ent(jj.v.vt[x], 0, 0, 0);
            if c < 0 { return -2; }
            x = c;
        }
        if jj.ev.ms_tail[sp] >= 0 { jj.v.vn[jj.ev.ms_tail[sp]] = x; } else { jj.ev.ms_head[sp] = x; }
        jj.ev.ms_tail[sp] = x;
        jj.ev.ms_cnt[sp] += 1;
        return res;
    }
    // an object: the key waits in ms_key; a repeated key replaces the value in place (jq keeps the first position, the last value)
    let kh = jj.ev.ms_key[sp];
    var q = jj.ev.ms_head[sp];
    while q >= 0 {
        if str_cmp(doc, jj.v.va[q], kh) == 0 { jj.v.vb[q] = x; return res; }
        q = jj.v.vn[q];
    }
    let pe = ent(0, 0, kh, x);
    if pe < 0 { return -2; }
    if jj.ev.ms_tail[sp] >= 0 { jj.v.vn[jj.ev.ms_tail[sp]] = pe; } else { jj.ev.ms_head[sp] = pe; }
    jj.ev.ms_tail[sp] = pe;
    jj.ev.ms_cnt[sp] += 1;
    return res;
}

// the value of the JSON text at [a, b) of the document (already validated by the scanner), built in the current arena
fn materialize(doc: text, a: i64, b: i64) -> i64 {
    var sp = 0;
    var p = a;
    var mode = 0;
    var result = -1;
    while true {
        if mode == 0 {
            p = skip_ws(doc, p);
            let c = byte_at(doc, p);
            if c == 123 || c == 91 {
                sp += 1;
                if sp > 250 { return fatal("a value nested deeper than 250 levels cannot be built from the document"); }
                jj.ev.ms_kind[sp] = 6;
                if c == 123 { jj.ev.ms_kind[sp] = 7; }
                jj.ev.ms_head[sp] = -1;
                jj.ev.ms_tail[sp] = -1;
                jj.ev.ms_cnt[sp] = 0;
                p = skip_ws(doc, p + 1);
                let d = byte_at(doc, p);
                if (c == 123 && d == 125) || (c == 91 && d == 93) {
                    p += 1;
                    let h = ent(jj.ev.ms_kind[sp], 1, -1, -1);
                    if h < 0 { return -1; }
                    jj.v.vf[h] = 0;
                    sp -= 1;
                    let r = mat_deliver(doc, sp, h, result);
                    if r == -2 { return -1; }
                    result = r;
                    mode = 1;
                } else if c == 123 {
                    let e = scan_string(doc, p);
                    let kh = ent(5, 0, p, e);
                    if kh < 0 { return -1; }
                    jj.v.vf[kh] = jj.sc.esc;
                    jj.ev.ms_key[sp] = kh;
                    p = skip_ws(doc, e) + 1;
                }
            } else {
                var h = -1;
                var e = p;
                if c == 34 {
                    e = scan_string(doc, p);
                    h = ent(5, 0, p, e);
                    if h >= 0 { jj.v.vf[h] = jj.sc.esc; }
                } else if c == 116 { e = p + 4; h = jj.ev.htrue; }
                else if c == 102 { e = p + 5; h = jj.ev.hfalse; }
                else if c == 110 { e = p + 4; h = jj.ev.hnull; }
                else {
                    e = scan_number(doc, p);
                    h = number_lit_doc(doc, p, e);
                }
                if h < 0 { return -1; }
                p = e;
                let r = mat_deliver(doc, sp, h, result);
                if r == -2 { return -1; }
                result = r;
                mode = 1;
            }
        } else {
            if sp == 0 { return result; }
            p = skip_ws(doc, p);
            let c = byte_at(doc, p);
            if c == 44 {
                p = skip_ws(doc, p + 1);
                if jj.ev.ms_kind[sp] == 7 {
                    let e = scan_string(doc, p);
                    let kh = ent(5, 0, p, e);
                    if kh < 0 { return -1; }
                    jj.v.vf[kh] = jj.sc.esc;
                    jj.ev.ms_key[sp] = kh;
                    p = skip_ws(doc, e) + 1;
                }
                mode = 0;
            } else {
                p += 1;
                let h = ent(jj.ev.ms_kind[sp], 1, jj.ev.ms_head[sp], jj.ev.ms_tail[sp]);
                if h < 0 { return -1; }
                jj.v.vf[h] = jj.ev.ms_cnt[sp];
                sp -= 1;
                let r = mat_deliver(doc, sp, h, result);
                if r == -2 { return -1; }
                result = r;
            }
        }
    }
    return result;
}

// a container taken from the document as a built value (anything else as it is)
fn built_of(doc: text, h: i64) -> i64 {
    if jj.v.vt[h] >= 6 && jj.v.vs[h] == 0 { return materialize(doc, jj.v.va[h], jj.v.vb[h]); }
    return h;
}


// ---- registers and copies ----

fn reg_gen(r: i64) -> i64 {
    let ow = jj.f.r_own[r];
    if ow < 0 { return 1; }
    return jj.sc.ugen[ow];
}

// a register used while its owner element is current: reset when the element changed
fn reg_touch(r: i64) {
    let g = reg_gen(r);
    if jj.ev.rg[r] != g {
        jj.ev.rg[r] = g;
        jj.ev.rh[r] = -1;
        jj.ev.rt[r] = -1;
        jj.ev.rc[r] = 0;
        jj.ev.rerr[r] = 0;
        jj.ev.at[r] = 0;
        jj.ev.ax[r] = 0.0;
    }
}

fn reg_clear(r: i64) {
    jj.ev.rg[r] = reg_gen(r);
    jj.ev.rh[r] = -1;
    jj.ev.rt[r] = -1;
    jj.ev.rc[r] = 0;
    jj.ev.rerr[r] = 0;
    jj.ev.at[r] = 0;
    jj.ev.ax[r] = 0.0;
}

// a copy of entry h in the arena of depth d, with what it holds (a string of the scratch string moves to the persistent text)
fn copy_deep(h: i64, d: i64) -> i64 {
    return copy_deep_l(h, d, 0);
}

fn copy_deep_l(h: i64, d: i64, lvl: i64) -> i64 {
    if lvl > 40 { return fatal("a value nested more than 40 levels deep is copied"); }
    let t = jj.v.vt[h];
    if t <= 3 { return h; }
    let save = jj.ev.depth;
    jj.ev.depth = d;
    var n = ent(t, jj.v.vs[h], jj.v.va[h], jj.v.vb[h]);
    jj.ev.depth = save;
    if n < 0 { return -1; }
    jj.v.vf[n] = jj.v.vf[h];
    jj.v.vx[n] = jj.v.vx[h];
    if t == 5 && jj.v.vs[h] == 2 {
        let off = len(jj.ev.ptx);
        if off + jj.v.vb[h] > 268000000 { return fatal("strings kept by the filter exceed the persistent text (256 MB)"); }
        jj.ev.ptx += substr(jj.ev.scr, jj.v.va[h], jj.v.vb[h]);
        jj.v.vs[n] = 3;
        jj.v.va[n] = off;
    }
    if t >= 6 && jj.v.vs[h] == 1 {
        // a built container: copy the chain
        var p = jj.v.va[h];
        var first = -1;
        var last = -1;
        while p >= 0 {
            var c = -1;
            if t == 6 {
                c = copy_deep_l(p, d, lvl + 1);
                if c < 0 { return -1; }
                if c == p || jj.v.vt[c] <= 3 {
                    // a constant: the chain needs its own entry
                    let save2 = jj.ev.depth;
                    jj.ev.depth = d;
                    let c2 = ent(jj.v.vt[p], 0, 0, 0);
                    jj.ev.depth = save2;
                    if c2 < 0 { return -1; }
                    c = c2;
                } else {
                    // copy_deep made a fresh entry; it is its own chain link
                }
            } else {
                let save3 = jj.ev.depth;
                jj.ev.depth = d;
                c = ent(0, 0, 0, 0);
                jj.ev.depth = save3;
                if c < 0 { return -1; }
                let kk = copy_deep_l(jj.v.va[p], d, lvl + 1);
                let vv = copy_deep_l(jj.v.vb[p], d, lvl + 1);
                if kk < 0 || vv < 0 { return -1; }
                jj.v.va[c] = kk;
                jj.v.vb[c] = vv;
            }
            jj.v.vn[c] = -1;
            if last >= 0 { jj.v.vn[last] = c; } else { first = c; }
            last = c;
            p = jj.v.vn[p];
        }
        jj.v.va[n] = first;
        jj.v.vb[n] = last;
    }
    if t >= 6 && jj.v.vs[h] == 0 { jj.v.vd[n] = -1; }
    jj.v.vn[n] = -1;
    return n;
}

// the next code that handles an element of a list: copy the entry into the arena of depth d, as the next link of register r
fn append_reg(r: i64, h: i64, d: i64) -> i64 {
    reg_touch(r);
    var c = -1;
    let t = jj.v.vt[h];
    if t <= 3 {
        let save = jj.ev.depth;
        jj.ev.depth = d;
        c = ent(t, 0, 0, 0);
        jj.ev.depth = save;
    } else if t == 4 || (t == 5 && jj.v.vs[h] != 2) || (t >= 6 && jj.v.vs[h] == 0) {
        let save = jj.ev.depth;
        jj.ev.depth = d;
        c = ent(t, jj.v.vs[h], jj.v.va[h], jj.v.vb[h]);
        jj.ev.depth = save;
        if c >= 0 {
            jj.v.vf[c] = jj.v.vf[h];
            jj.v.vx[c] = jj.v.vx[h];
            jj.v.vd[c] = -1;
        }
    } else {
        c = copy_deep(h, d);
        if c >= 0 && c == h { return fatal("internal: a shared entry in a list"); }
    }
    if c < 0 { return -1; }
    jj.v.vn[c] = -1;
    if jj.ev.rt[r] >= 0 { jj.v.vn[jj.ev.rt[r]] = c; } else { jj.ev.rh[r] = c; }
    jj.ev.rt[r] = c;
    jj.ev.rc[r] += 1;
    return 0;
}

// the list held by register r as a value
fn reg_list(r: i64) -> i64 {
    reg_touch(r);
    if jj.ev.rc[r] == 0 { return jj.ev.harr0; }
    let h = ent(6, 1, jj.ev.rh[r], jj.ev.rt[r]);
    if h < 0 { return -1; }
    jj.v.vf[h] = jj.ev.rc[r];
    return h;
}

// ---- arithmetic ----

fn add_vals(doc: text, filter: text, x: i64, y: i64) -> i64 {
    let tx = jj.v.vt[x];
    let ty = jj.v.vt[y];
    if tx == 1 { return y; }
    if ty == 1 { return x; }
    if tx == 4 && ty == 4 { return mk_dbl(numd(doc, filter, x) + numd(doc, filter, y)); }
    if tx == 5 && ty == 5 {
        let nx = str_plain(doc, x, 0);
        str_plain(doc, y, 2);
        let off = len(jj.ev.scr);
        if off + nx + len(jj.ev.tmp2) > 16000000 { return fatal("strings built by the filter exceed the 16 MB scratch string"); }
        jj.ev.scr += jj.tmp;
        jj.ev.scr += jj.ev.tmp2;
        return ent(5, 2, off, nx + len(jj.ev.tmp2));
    }
    if tx == 6 && ty == 6 {
        if jj.v.vs[x] != 1 || jj.v.vs[y] != 1 {
            let bx = built_of(doc, x);
            let by = built_of(doc, y);
            if bx < 0 || by < 0 { return -1; }
            return add_vals(doc, filter, bx, by);
        }
        let r = ent(6, 1, -1, -1);
        if r < 0 { return -1; }
        var first = -1;
        var last = -1;
        var side = 0;
        while side < 2 {
            var p = jj.v.va[x];
            if side == 1 { p = jj.v.va[y]; }
            while p >= 0 {
                let c = ent(jj.v.vt[p], jj.v.vs[p], jj.v.va[p], jj.v.vb[p]);
                if c < 0 { return -1; }
                jj.v.vf[c] = jj.v.vf[p];
                jj.v.vx[c] = jj.v.vx[p];
                jj.v.vd[c] = jj.v.vd[p];
                if last >= 0 { jj.v.vn[last] = c; } else { first = c; }
                last = c;
                p = jj.v.vn[p];
            }
            side += 1;
        }
        jj.v.va[r] = first;
        jj.v.vb[r] = last;
        jj.v.vf[r] = jj.v.vf[x] + jj.v.vf[y];
        return r;
    }
    if tx == 7 && ty == 7 {
        if jj.v.vs[x] != 1 || jj.v.vs[y] != 1 {
            let bx = built_of(doc, x);
            let by = built_of(doc, y);
            if bx < 0 || by < 0 { return -1; }
            return add_vals(doc, filter, bx, by);
        }
        return merge_objects(doc, x, y);
    }
    return jqerr(typed(doc, filter, x) + " and " + typed(doc, filter, y) + " cannot be added");
}

// the entries of object x then those of y, a key of y replacing the value of the same key of x in place
fn merge_objects(doc: text, x: i64, y: i64) -> i64 {
    let r = ent(7, 1, -1, -1);
    if r < 0 { return -1; }
    var cnt = 0;
    var side = 0;
    while side < 2 {
        var p = jj.v.va[x];
        if side == 1 { p = jj.v.va[y]; }
        while p >= 0 {
            var done = false;
            var q = jj.v.va[r];
            while q >= 0 && !done {
                if str_cmp(doc, jj.v.va[q], jj.v.va[p]) == 0 { jj.v.vb[q] = jj.v.vb[p]; done = true; }
                q = jj.v.vn[q];
            }
            if !done {
                let pe = ent(0, 0, jj.v.va[p], jj.v.vb[p]);
                if pe < 0 { return -1; }
                if jj.v.vb[r] >= 0 { jj.v.vn[jj.v.vb[r]] = pe; } else { jj.v.va[r] = pe; }
                jj.v.vb[r] = pe;
                cnt += 1;
            }
            p = jj.v.vn[p];
        }
        side += 1;
    }
    jj.v.vf[r] = cnt;
    return r;
}

// the order of two built objects as jq has it: the sorted key lists first, then the values in that key order
fn cmp_objects(doc: text, filter: text, x: i64, y: i64) -> i64 {
    let kx = keys_of(doc, filter, x);
    if kx < 0 { return -2; }
    let ky = keys_of(doc, filter, y);
    if ky < 0 { return -2; }
    let c = cmp_vals(doc, filter, kx, ky);
    if c != 0 { return c; }
    var p = jj.v.va[kx];
    while p >= 0 {
        var vx = -1;
        var vy = -1;
        var q = jj.v.va[x];
        while q >= 0 { if str_cmp(doc, jj.v.va[q], p) == 0 { vx = jj.v.vb[q]; } q = jj.v.vn[q]; }
        q = jj.v.va[y];
        while q >= 0 { if str_cmp(doc, jj.v.va[q], p) == 0 { vy = jj.v.vb[q]; } q = jj.v.vn[q]; }
        let d = cmp_vals(doc, filter, vx, vy);
        if d != 0 { return d; }
        p = jj.v.vn[p];
    }
    return 0;
}

// .[lo:hi] of a string (by characters), an array or null, as jq computes it
fn slice_of(doc: text, filter: text, s: i64, lo: i64, hi: i64) -> i64 {
    let t = jj.v.vt[s];
    if t == 1 { return jj.ev.hnull; }
    if t != 5 && t != 6 { return jqerr("Cannot index " + type_name(s) + " with object"); }
    if (jj.v.vt[lo] != 4 && jj.v.vt[lo] != 1) || (jj.v.vt[hi] != 4 && jj.v.vt[hi] != 1) { return jqerr("Start and end indices of an array slice must be numbers"); }
    var s2 = s;
    var n = 0;
    if t == 6 {
        if jj.v.vs[s] == 0 { s2 = built_of(doc, s); if s2 < 0 { return -1; } }
        n = jj.v.vf[s2];
    } else {
        let nb = str_plain(doc, s, 0);
        var i = 0;
        while i < nb { if (byte_at(jj.tmp, i) & 192) != 128 { n += 1; } i += 1; }
    }
    let nf = n as f64;
    var ds = 0.0;
    var de = nf;
    if jj.v.vt[lo] == 4 { ds = numd(doc, filter, lo); }
    if jj.v.vt[hi] == 4 { de = numd(doc, filter, hi); }
    if ds != ds { ds = 0.0; }
    if de != de { de = nf; }
    if ds < 0.0 { ds = ds + nf; }
    if de < 0.0 { de = de + nf; }
    if ds < 0.0 { ds = 0.0; }
    if ds > nf { ds = nf; }
    if de > nf { de = nf; }
    var st = ds as i64;
    var en = de as i64;
    if (en as f64) < de { en += 1; }
    if en > n { en = n; }
    if de < ds { st = 0; en = 0; }
    if t == 6 {
        let r = ent(6, 1, -1, -1);
        if r < 0 { return -1; }
        var p = jj.v.va[s2];
        var i = 0;
        var last = -1;
        var cnt = 0;
        while p >= 0 && i < en {
            if i >= st {
                let c = ent(jj.v.vt[p], jj.v.vs[p], jj.v.va[p], jj.v.vb[p]);
                if c < 0 { return -1; }
                jj.v.vf[c] = jj.v.vf[p];
                jj.v.vx[c] = jj.v.vx[p];
                jj.v.vd[c] = jj.v.vd[p];
                if last >= 0 { jj.v.vn[last] = c; } else { jj.v.va[r] = c; }
                last = c;
                cnt += 1;
            }
            p = jj.v.vn[p];
            i += 1;
        }
        if cnt == 0 { return jj.ev.harr0; }
        jj.v.vb[r] = last;
        jj.v.vf[r] = cnt;
        return r;
    }
    // a string: the bytes of characters st .. en
    let nb2 = len(jj.tmp);
    var bi = 0;
    var ci = 0;
    var bs = nb2;
    var be = nb2;
    var found_s = false;
    while bi < nb2 {
        if (byte_at(jj.tmp, bi) & 192) != 128 {
            if ci == st && !found_s { bs = bi; found_s = true; }
            if ci == en { be = bi; break; }
            ci += 1;
        }
        bi += 1;
    }
    if st >= n { bs = nb2; }
    if be < bs { be = bs; }
    jj.ev.tmp3 = substr(jj.tmp, bs, be - bs);
    let off = len(jj.ev.scr);
    jj.ev.scr += jj.ev.tmp3;
    return ent(5, 2, off, be - bs);
}

// string repetition: jq 1.8 gives null for a negative count and at least one copy only from a count of 1
fn repeat_string(doc: text, filter: text, s: i64, nv: i64) -> i64 {
    let x = numd(doc, filter, nv);
    if x != x || x < 0.0 { return jj.ev.hnull; }
    let nb = str_plain(doc, s, 0);
    var cnt = 0;
    if x >= 1.0 { cnt = dtoi(x); }
    if cnt == 0 || nb == 0 { jj.tmp = ""; return str_from_tmp(); }
    if (nb as f64) * (cnt as f64) > 2147483647.0 { return jqerr("Repeat string result too long"); }
    if nb * cnt > 15000000 { return fatal("a repeated string longer than 15 MB"); }
    jj.ev.tmp3 = jj.tmp;
    let off = len(jj.ev.scr);
    var i = 0;
    while i < cnt { jj.ev.scr += jj.ev.tmp3; i += 1; }
    return ent(5, 2, off, nb * cnt);
}

// the string s split at the separator sep
fn split_string(doc: text, filter: text, s: i64, sep: i64) -> i64 {
    let ns = str_plain(doc, s, 0);
    let nsep = str_plain(doc, sep, 2);
    let r = ent(6, 1, -1, -1);
    if r < 0 { return -1; }
    if ns == 0 { return jj.ev.harr0; }
    var last = -1;
    var cnt = 0;
    var start = 0;
    var i = 0;
    while i <= ns {
        var cut = false;
        var step = 1;
        if i == ns { cut = true; }
        else if nsep == 0 {
            // every character
            var k = i + 1;
            while k < ns && (byte_at(jj.tmp, k) & 192) == 128 { k += 1; }
            step = k - i;
            cut = true;
            // the piece is the character at i
            let off = len(jj.ev.scr);
            jj.ev.scr += substr(jj.tmp, i, step);
            let c = ent(5, 2, off, step);
            if c < 0 { return -1; }
            if last >= 0 { jj.v.vn[last] = c; } else { jj.v.va[r] = c; }
            last = c;
            cnt += 1;
            i += step;
            continue;
        } else if i + nsep <= ns && byte_at(jj.tmp, i) == byte_at(jj.ev.tmp2, 0) && substr(jj.tmp, i, nsep) == substr(jj.ev.tmp2, 0, nsep) {
            cut = true;
            step = nsep;
        }
        if cut {
            let off = len(jj.ev.scr);
            jj.ev.scr += substr(jj.tmp, start, i - start);
            let c = ent(5, 2, off, i - start);
            if c < 0 { return -1; }
            if last >= 0 { jj.v.vn[last] = c; } else { jj.v.va[r] = c; }
            last = c;
            cnt += 1;
            i += step;
            start = i;
            if i > ns { break; }
        } else { i += 1; }
    }
    jj.v.vb[r] = last;
    jj.v.vf[r] = cnt;
    return r;
}

// the deep merge of two built objects: b's keys win, objects on both sides are merged
fn deep_merge(doc: text, filter: text, x: i64, y: i64) -> i64 {
    jj.ev.rec += 1;
    if jj.ev.rec > 40 { jj.ev.rec -= 1; return fatal("`*` on objects nested more than 40 levels"); }
    let r = ent(7, 1, -1, -1);
    if r < 0 { return -1; }
    var cnt = 0;
    var p = jj.v.va[x];
    while p >= 0 {
        let pe = ent(0, 0, jj.v.va[p], jj.v.vb[p]);
        if pe < 0 { return -1; }
        if jj.v.vb[r] >= 0 { jj.v.vn[jj.v.vb[r]] = pe; } else { jj.v.va[r] = pe; }
        jj.v.vb[r] = pe;
        cnt += 1;
        p = jj.v.vn[p];
    }
    p = jj.v.va[y];
    while p >= 0 {
        var q = jj.v.va[r];
        var done = false;
        while q >= 0 && !done {
            if str_cmp(doc, jj.v.va[q], jj.v.va[p]) == 0 {
                var a = jj.v.vb[q];
                var b = jj.v.vb[p];
                if jj.v.vt[a] >= 6 && jj.v.vs[a] == 0 { a = built_of(doc, a); }
                if jj.v.vt[b] >= 6 && jj.v.vs[b] == 0 { b = built_of(doc, b); }
                if a >= 0 && b >= 0 && jj.v.vt[a] == 7 && jj.v.vt[b] == 7 {
                    let m = deep_merge(doc, filter, a, b);
                    if m < 0 { return -1; }
                    jj.v.vb[q] = m;
                } else { jj.v.vb[q] = jj.v.vb[p]; }
                done = true;
            }
            q = jj.v.vn[q];
        }
        if !done {
            let pe = ent(0, 0, jj.v.va[p], jj.v.vb[p]);
            if pe < 0 { return -1; }
            if jj.v.vb[r] >= 0 { jj.v.vn[jj.v.vb[r]] = pe; } else { jj.v.va[r] = pe; }
            jj.v.vb[r] = pe;
            cnt += 1;
        }
        p = jj.v.vn[p];
    }
    jj.v.vf[r] = cnt;
    jj.ev.rec -= 1;
    return r;
}

fn dtoi(x: f64) -> i64 {
    if x >= 9223372036854775807.0 { return 9223372036854775807; }
    if x <= -9223372036854775807.0 { return -9223372036854775807 - 1; }
    return x as i64;
}

// x op y for + - * / %
fn arith(doc: text, filter: text, op: i64, x: i64, y: i64) -> i64 {
    if op == 21 { return add_vals(doc, filter, x, y); }
    let tx = jj.v.vt[x];
    let ty = jj.v.vt[y];
    if tx == 4 && ty == 4 {
        let a = numd(doc, filter, x);
        let b = numd(doc, filter, y);
        if op == 22 { return mk_dbl(a - b); }
        if op == 23 { return mk_dbl(a * b); }
        if op == 24 {
            if b == 0.0 { return jqerr(typed(doc, filter, x) + " and " + typed(doc, filter, y) + " cannot be divided because the divisor is zero"); }
            return mk_dbl(a / b);
        }
        if a != a || b != b { return mk_dbl(jj.ev.nanv); }
        let ia = dtoi(a);
        let ib = dtoi(b);
        if ib == 0 { return jqerr(typed(doc, filter, x) + " and " + typed(doc, filter, y) + " cannot be divided (remainder) because the divisor is zero"); }
        if ib == -1 { return mk_dbl(0.0); }
        return mk_dbl((ia % ib) as f64);
    }
    if op == 22 && tx == 6 && ty == 6 {
        if jj.v.vs[x] != 1 || jj.v.vs[y] != 1 {
            let bx = built_of(doc, x);
            let by = built_of(doc, y);
            if bx < 0 || by < 0 { return -1; }
            return arith(doc, filter, op, bx, by);
        }
        let r = ent(6, 1, -1, -1);
        if r < 0 { return -1; }
        var first = -1;
        var last = -1;
        var cnt = 0;
        var p = jj.v.va[x];
        while p >= 0 {
            var found = false;
            var q = jj.v.va[y];
            while q >= 0 && !found {
                let c = cmp_vals(doc, filter, p, q);
                if c == -2 { return -1; }
                if c == 0 { found = true; }
                q = jj.v.vn[q];
            }
            if !found {
                let c = ent(jj.v.vt[p], jj.v.vs[p], jj.v.va[p], jj.v.vb[p]);
                if c < 0 { return -1; }
                jj.v.vf[c] = jj.v.vf[p];
                jj.v.vx[c] = jj.v.vx[p];
                jj.v.vd[c] = jj.v.vd[p];
                if last >= 0 { jj.v.vn[last] = c; } else { first = c; }
                last = c;
                cnt += 1;
            }
            p = jj.v.vn[p];
        }
        jj.v.va[r] = first;
        jj.v.vb[r] = last;
        jj.v.vf[r] = cnt;
        return r;
    }
    if op == 23 && tx == 5 && ty == 4 { return repeat_string(doc, filter, x, y); }
    if op == 23 && tx == 4 && ty == 5 { return repeat_string(doc, filter, y, x); }
    if op == 23 && tx == 7 && ty == 7 {
        let bx = built_of(doc, x);
        let by = built_of(doc, y);
        if bx < 0 || by < 0 { return -1; }
        return deep_merge(doc, filter, bx, by);
    }
    if op == 24 && tx == 5 && ty == 5 { return split_string(doc, filter, x, y); }
    return jqerr(typed(doc, filter, x) + " and " + typed(doc, filter, y) + " cannot be " + op_word(op));
}

fn op_word(op: i64) -> text {
    if op == 22 { return "subtracted"; }
    if op == 23 { return "multiplied"; }
    if op == 24 { return "divided"; }
    return "divided (remainder)";
}

fn neg_val(doc: text, filter: text, x: i64) -> i64 {
    if jj.v.vt[x] != 4 { return jqerr(typed(doc, filter, x) + " cannot be negated"); }
    let s = jj.v.vs[x];
    if s == 4 { return ent(4, 4, -jj.v.va[x], 0); }
    if s == 3 { return mk_dbl(-jj.v.vx[x]); }
    let h = ent(4, s, jj.v.va[x], jj.v.vb[x]);
    if h < 0 { return -1; }
    jj.v.vf[h] = jj.v.vf[x] ^ 1;
    if (jj.v.vf[x] & 2) != 0 { jj.v.vf[h] = jj.v.vf[x]; return mk_dbl(-numd(doc, filter, x)); }
    return h;
}

// ---- navigation ----

fn find_child_key(node: i64, ko: i64, kl: i64) -> i64 {
    var e = jj.f.nfirst[node];
    while e != 0 {
        if jj.f.ekind[e] == 0 && jj.f.eb[e] == kl && substr(jj.f.keys, jj.f.ea[e], kl) == substr(jj.f.keys, ko, kl) { return jj.f.enode[e]; }
        e = jj.f.enext[e];
    }
    return -1;
}

fn find_child_idx(node: i64, k: i64) -> i64 {
    var e = jj.f.nfirst[node];
    while e != 0 {
        if jj.f.ekind[e] == 1 && jj.f.ea[e] == k { return jj.f.enode[e]; }
        e = jj.f.enext[e];
    }
    return -1;
}

// the value under the key keys[ko, ko+kl) of an object value, null when missing
fn nav_key(doc: text, v: i64, ko: i64, kl: i64) -> i64 {
    let t = jj.v.vt[v];
    if t == 1 { return jj.ev.hnull; }
    if t != 7 { return jqerr("Cannot index " + type_name(v) + " with string (\"" + substr(jj.f.keys, ko, kl) + "\")"); }
    if jj.v.vs[v] == 0 {
        let nd = jj.v.vd[v];
        if nd >= 0 {
            let c = find_child_key(nd, ko, kl);
            if c >= 0 { return node_val(c); }
        }
        let v2 = built_of(doc, v);
        if v2 < 0 { return -1; }
        return nav_key(doc, v2, ko, kl);
    }
    var p = jj.v.va[v];
    var found = -1;
    while p >= 0 {
        let kh = jj.v.va[p];
        let n = str_plain(doc, kh, 0);
        if n == kl && substr(jj.tmp, 0, n) == substr(jj.f.keys, ko, kl) { found = jj.v.vb[p]; }
        p = jj.v.vn[p];
    }
    if found < 0 { return jj.ev.hnull; }
    return found;
}

fn nav_idx(doc: text, v: i64, k: i64) -> i64 {
    let t = jj.v.vt[v];
    if t == 1 { return jj.ev.hnull; }
    if t != 6 { return jqerr("Cannot index " + type_name(v) + " with number (" + str(k) + ")"); }
    if jj.v.vs[v] == 0 {
        let nd = jj.v.vd[v];
        if nd >= 0 {
            let c = find_child_idx(nd, k);
            if c >= 0 { return node_val(c); }
        }
        let v2 = built_of(doc, v);
        if v2 < 0 { return -1; }
        return nav_idx(doc, v2, k);
    }
    if k >= jj.v.vf[v] { return jj.ev.hnull; }
    var p = jj.v.va[v];
    var i = 0;
    while i < k { p = jj.v.vn[p]; i += 1; }
    return p;
}

// ---- builtins on one value ----

fn length_of(doc: text, filter: text, v: i64) -> i64 {
    let t = jj.v.vt[v];
    if t == 1 { return ent(4, 4, 0, 0); }
    if t == 2 || t == 3 { return jqerr(typed(doc, filter, v) + " has no length"); }
    if t == 4 {
        let s = jj.v.vs[v];
        if s == 4 { var a = jj.v.va[v]; if a < 0 { a = -a; } return ent(4, 4, a, 0); }
        if s == 3 { var x = jj.v.vx[v]; if x < 0.0 { x = -x; } return mk_dbl(x); }
        let h = ent(4, s, jj.v.va[v], jj.v.vb[v]);
        if h < 0 { return -1; }
        jj.v.vf[h] = 2;
        return h;
    }
    if t == 5 {
        let n = str_plain(doc, v, 0);
        var c = 0;
        var i = 0;
        while i < n {
            if (byte_at(jj.tmp, i) & 192) != 128 { c += 1; }
            i += 1;
        }
        return ent(4, 4, c, 0);
    }
    return ent(4, 4, jj.v.vf[v], 0);
}

fn keys_of(doc: text, filter: text, v: i64) -> i64 {
    let t = jj.v.vt[v];
    if t == 6 {
        let n = jj.v.vf[v];
        let r = ent(6, 1, -1, -1);
        if r < 0 { return -1; }
        var last = -1;
        var i = 0;
        while i < n {
            let c = ent(4, 4, i, 0);
            if c < 0 { return -1; }
            if last >= 0 { jj.v.vn[last] = c; } else { jj.v.va[r] = c; }
            last = c;
            i += 1;
        }
        jj.v.vb[r] = last;
        jj.v.vf[r] = n;
        if n == 0 { return jj.ev.harr0; }
        return r;
    }
    if t != 7 { return jqerr(typed(doc, filter, v) + " has no keys"); }
    // collect the key entries, then order them by their text
    var first = -1;
    var cnt = 0;
    if jj.v.vs[v] == 0 {
        let nd = jj.v.vd[v];
        if nd < 0 || jj.f.wantkeys[nd] == 0 {
            let v2 = built_of(doc, v);
            if v2 < 0 { return -1; }
            return keys_of(doc, filter, v2);
        }
        first = jj.sc.skh[nd];
        cnt = jj.sc.skn[nd];
    } else {
        first = -1;
        cnt = jj.v.vf[v];
    }
    // an array of handles sorted by insertion
    var n = 0;
    var p = first;
    if jj.v.vs[v] == 1 { p = jj.v.va[v]; }
    while p >= 0 {
        var kh = p;
        if jj.v.vs[v] == 1 { kh = jj.v.va[p]; }
        if n >= 60 { return fatal("`keys` of an object with more than 60 keys"); }
        // insert in order
        var pos = n;
        while pos > 0 {
            let c = str_cmp(doc, jj.ev.stk[pos - 1], kh);
            if c <= 0 { break; }
            jj.ev.stk[pos] = jj.ev.stk[pos - 1];
            pos -= 1;
        }
        jj.ev.stk[pos] = kh;
        n += 1;
        if jj.v.vs[v] == 1 { p = jj.v.vn[p]; } else { p = jj.v.vn[p]; }
    }
    let r = ent(6, 1, -1, -1);
    if r < 0 { return -1; }
    var last = -1;
    var i = 0;
    var kept = 0;
    while i < n {
        let kh = jj.ev.stk[i];
        var dup = false;
        if i > 0 { if str_cmp(doc, jj.ev.stk[i - 1], kh) == 0 { dup = true; } }
        if !dup {
            let c = ent(5, jj.v.vs[kh], jj.v.va[kh], jj.v.vb[kh]);
            if c < 0 { return -1; }
            jj.v.vf[c] = jj.v.vf[kh];
            if last >= 0 { jj.v.vn[last] = c; } else { jj.v.va[r] = c; }
            last = c;
            kept += 1;
        }
        i += 1;
    }
    jj.v.vb[r] = last;
    jj.v.vf[r] = kept;
    if kept == 0 { return jj.ev.harr0; }
    return r;
}

fn has_of(doc: text, filter: text, v: i64, a: i64) -> i64 {
    let t = jj.v.vt[v];
    let ta = jj.v.vt[a];
    if t == 1 && (ta == 4 || ta == 5) { return jj.ev.hfalse; }
    if t == 7 && ta == 5 {
        if jj.v.vs[v] == 0 {
            let nd = jj.v.vd[v];
            if nd < 0 {
                let v2 = built_of(doc, v);
                if v2 < 0 { return -1; }
                return has_of(doc, filter, v2, a);
            }
            let n = str_plain(doc, a, 0);
            let ko = len(jj.f.keys);
            // look the key up among the node's children by text
            var e = jj.f.nfirst[nd];
            while e != 0 {
                if jj.f.ekind[e] == 0 && jj.f.eb[e] == n && substr(jj.f.keys, jj.f.ea[e], n) == substr(jj.tmp, 0, n) {
                    let c = jj.f.enode[e];
                    return mk_bool(jj.sc.sgen[c] == gen_of(c));
                }
                e = jj.f.enext[e];
            }
            let v3 = built_of(doc, v);
            if v3 < 0 { return -1; }
            return has_of(doc, filter, v3, a);
        }
        var p = jj.v.va[v];
        while p >= 0 {
            if str_cmp(doc, jj.v.va[p], a) == 0 { return jj.ev.htrue; }
            p = jj.v.vn[p];
        }
        return jj.ev.hfalse;
    }
    if t == 6 && ta == 4 {
        let x = numd(doc, filter, a);
        if x != x { return jj.ev.hfalse; }
        var c = jj.v.vf[v];
        return mk_bool(x >= 0.0 && x < (c as f64));
    }
    return jqerr("Cannot check whether " + type_name(v) + " has a " + type_name(a) + " key");
}

fn tostring_of(doc: text, filter: text, v: i64) -> i64 {
    let t = jj.v.vt[v];
    if t == 5 { return v; }
    if t == 1 { return ent(5, 1, 0, 4); }
    if t == 2 { return ent(5, 1, 34, 5); }
    if t == 3 { return ent(5, 1, 39, 4); }
    if t == 4 {
        let s = jj.v.vs[v];
        jj.tmp = "";
        if s == 4 { jj.tmp += str(jj.v.va[v]); }
        else if s == 3 { fmt_dbl(jj.v.vx[v]); jj.tmp += jj.num.buf; }
        else {
            // the literal in jq's canonical form
            jj.o.to = 4;
            let m = len(jj.ev.scr);
            var mode = 0;
            if (jj.v.vf[v] & 2) != 0 { mode = 1; } else if (jj.v.vf[v] & 1) != 0 { mode = 2; }
            if s == 0 { write_number(doc, jj.v.va[v], jj.v.vb[v], mode); } else { write_number(filter, jj.v.va[v], jj.v.vb[v], mode); }
            jj.o.to = 0;
            return ent(5, 2, m, len(jj.ev.scr) - m);
        }
        return str_from_tmp();
    }
    return tojson_of(doc, filter, v);
}

// the compact JSON text of any value, as a string
fn tojson_of(doc: text, filter: text, v: i64) -> i64 {
    let m = len(jj.ev.scr);
    let save = jj.o.pretty;
    jj.o.to = 4;
    jj.o.pretty = false;
    write_h(doc, filter, v, 1);
    jj.o.to = 0;
    jj.o.pretty = save;
    return ent(5, 2, m, len(jj.ev.scr) - m);
}

fn tonumber_of(doc: text, filter: text, v: i64) -> i64 {
    let t = jj.v.vt[v];
    if t == 4 { return v; }
    if t != 5 { return jqerr(typed(doc, filter, v) + " cannot be parsed as a number"); }
    let n = str_plain(doc, v, 0);
    // [+-]? digits* [. digits*] [e [+-] digits+]?  with at least one digit
    var i = 0;
    var neg = false;
    if n > 0 && byte_at(jj.tmp, 0) == 45 { neg = true; i = 1; }
    else if n > 0 && byte_at(jj.tmp, 0) == 43 { i = 1; }
    var nd = 0;
    var strict = true;
    var lead0 = false;
    if i < n && byte_at(jj.tmp, i) == 48 && i + 1 < n && is_digit(byte_at(jj.tmp, i + 1)) { lead0 = true; }
    if byte_at(jj.tmp, 0) == 43 { strict = false; }
    if lead0 { strict = false; }
    while i < n && is_digit(byte_at(jj.tmp, i)) { i += 1; nd += 1; }
    if i < n && byte_at(jj.tmp, i) == 46 {
        i += 1;
        var fd = 0;
        while i < n && is_digit(byte_at(jj.tmp, i)) { i += 1; nd += 1; fd += 1; }
        if fd == 0 { strict = false; }
        if nd == fd && fd > 0 { strict = false; }
    }
    if nd == 0 { return jqerr(typed(doc, filter, v) + " cannot be parsed as a number"); }
    if i < n && (byte_at(jj.tmp, i) == 101 || byte_at(jj.tmp, i) == 69) {
        i += 1;
        if i < n && (byte_at(jj.tmp, i) == 43 || byte_at(jj.tmp, i) == 45) { i += 1; }
        var ed = 0;
        while i < n && is_digit(byte_at(jj.tmp, i)) { i += 1; ed += 1; }
        if ed == 0 { return jqerr(typed(doc, filter, v) + " cannot be parsed as a number"); }
    }
    if i != n { return jqerr(typed(doc, filter, v) + " cannot be parsed as a number"); }
    // a plain JSON number from the document keeps its literal form
    if strict && jj.v.vs[v] == 0 && jj.v.vf[v] == 0 {
        let a = jj.v.va[v] + 1;
        let b = jj.v.vb[v] - 1;
        return number_lit_doc(doc, a, b);
    }
    var x = 0.0;
    if strict { x = num_parse(jj.tmp, 0, n); }
    else {
        // rewrite without the plus sign and with the digits as they are: num_parse reads leading zeros and a bare dot
        var s0 = 0;
        if byte_at(jj.tmp, 0) == 43 { s0 = 1; }
        if byte_at(jj.tmp, 0) == 45 { s0 = 1; }
        jj.ev.tmp3 = "";
        if neg { jj.ev.tmp3 += "-"; }
        jj.ev.tmp3 += substr(jj.tmp, s0, n - s0);
        x = num_parse(jj.ev.tmp3, 0, len(jj.ev.tmp3));
    }
    return mk_dbl(x);
}

// a number entry for the literal at [a, b) of the document
fn number_lit_doc(doc: text, a: i64, b: i64) -> i64 {
    var n = 0;
    var k = a;
    var plain = (b - a) <= 15;
    while k < b && plain {
        let c = byte_at(doc, k);
        if !is_digit(c) { plain = false; } else { n = n * 10 + c - 48; }
        k += 1;
    }
    if plain { return ent(4, 4, n, 0); }
    return ent(4, 0, a, b);
}

fn math_of(doc: text, filter: text, id: i64, v: i64) -> i64 {
    if jj.v.vt[v] != 4 { return jqerr(type_name(v) + " number required"); }
    let x = numd(doc, filter, v);
    if id == F.FLOOR { return mk_dbl(floor(x)); }
    if id == F.CEIL { return mk_dbl(ceil(x)); }
    if id == F.ROUND { return mk_dbl(round(x)); }
    if id == F.SQRT { return mk_dbl(sqrt(x)); }
    return mk_dbl(abs(x));
}

// add over the elements of a built list
fn add_list(doc: text, filter: text, v: i64) -> i64 {
    let t = jj.v.vt[v];
    if t != 6 && t != 7 { return jqerr("Cannot iterate over " + typed(doc, filter, v)); }
    var v2 = v;
    if jj.v.vs[v] == 0 { v2 = built_of(doc, v); if v2 < 0 { return -1; } }
    var acc = jj.ev.hnull;
    var p = jj.v.va[v2];
    while p >= 0 {
        var x = p;
        if t == 7 { x = jj.v.vb[p]; }
        acc = add_vals(doc, filter, acc, x);
        if acc < 0 { return -1; }
        p = jj.v.vn[p];
    }
    return acc;
}

// ---- folds ----

fn fold_add(doc: text, filter: text, r: i64, h: i64) -> i64 {
    reg_touch(r);
    let t = jj.v.vt[h];
    if t == 1 { return 0; }
    let st = jj.ev.at[r];
    if st == 0 {
        let c = copy_deep(h, jj.f.r_depth[r]);
        if c < 0 { return 1; }
        if c == h {
            // a constant can be held as is
        }
        jj.ev.ah[r] = c;
        jj.ev.at[r] = 1;
        return 0;
    }
    if st == 2 {
        if t != 4 { jqerr("number and " + type_name(h) + " cannot be added"); return 1; }
        jj.ev.ax[r] = jj.ev.ax[r] + numd(doc, filter, h);
        return 0;
    }
    let a = jj.ev.ah[r];
    if jj.v.vt[a] == 4 && t == 4 {
        jj.ev.ax[r] = numd(doc, filter, a) + numd(doc, filter, h);
        jj.ev.at[r] = 2;
        return 0;
    }
    let sum = add_vals(doc, filter, a, h);
    if sum < 0 { return 1; }
    let c = copy_deep(sum, jj.f.r_depth[r]);
    if c < 0 { return 1; }
    jj.ev.ah[r] = c;
    return 0;
}

fn fold_result(r: i64, kind: i64) -> i64 {
    reg_touch(r);
    if kind == 2 { return ent(4, 4, jj.ev.rc[r], 0); }
    if jj.ev.at[r] == 0 { return jj.ev.hnull; }
    if jj.ev.at[r] == 1 { return jj.ev.ah[r]; }
    return mk_dbl(jj.ev.ax[r]);
}

// ---- the evaluator ----

fn cmp_result(op: i64, c: i64) -> bool {
    if op == 11 { return c == 0; }
    if op == 12 { return c != 0; }
    if op == 13 { return c < 0; }
    if op == 14 { return c <= 0; }
    if op == 15 { return c > 0; }
    return c >= 0;
}

// a number or string slot against a literal, without making entries
fn cmplit(doc: text, filter: text, n: i64, lit: i64, op: i64) -> i64 {
    if jj.sc.anyerr { if nav_check(n) != 0 { return -1; } }
    var tag = 1;
    var c = 0;
    if jj.sc.sgen[n] == gen_of(n) { tag = jj.sc.stag[n]; }
    let lt = jj.v.vt[lit];
    if tag != lt {
        if tag < lt { c = -1; } else { c = 1; }
        return mk_bool(cmp_result(op, c));
    }
    if tag == 4 {
        if jj.sc.sisint[n] != 0 && jj.v.vs[lit] == 4 && jj.v.vf[lit] == 0 {
            let a = jj.sc.sint[n];
            let b = jj.v.va[lit];
            if a < b { c = -1; } else if a > b { c = 1; }
            return mk_bool(cmp_result(op, c));
        }
        let h = slot_val(n);
        if h < 0 { return -1; }
        c = num_cmp3(doc, filter, h, lit);
        return mk_bool(cmp_result(op, c));
    }
    if tag == 5 {
        let a = jj.sc.sa[n];
        let b = jj.sc.sb[n];
        if jj.sc.sesc[n] == 0 {
            c = bytes_cmp(doc, a + 1, b - a - 2, jj.f.lits, jj.v.va[lit], jj.v.vb[lit]);
        } else {
            decode_string(doc, a, b);
            c = bytes_cmp(jj.tmp, 0, len(jj.tmp), jj.f.lits, jj.v.va[lit], jj.v.vb[lit]);
        }
        return mk_bool(cmp_result(op, c));
    }
    if tag >= 6 {
        let h = slot_val(n);
        if h < 0 { return -1; }
        c = cmp_vals(doc, filter, h, lit);
        if c == -2 { return -1; }
        return mk_bool(cmp_result(op, c));
    }
    return mk_bool(cmp_result(op, 0));
}
// raise the error whose value is x (a string gives the message)
fn raise_value(doc: text, filter: text, x: i64) -> i64 {
    jj.ev.err = 1;
    jj.exitc = 5;
    jj.ev.errv = x;
    if jj.v.vt[x] == 5 {
        let n = str_plain(doc, x, 0);
        var n2 = n;
        if n2 > 200 { n2 = 200; }
        while n2 > 0 && n2 < n && (byte_at(jj.tmp, n2) & 192) == 128 { n2 -= 1; }
        jj.err = "jx: error: " + substr(jj.tmp, 0, n2);
        jj.ev.rawmsg = substr(jj.tmp, 0, n2);
    } else {
        jj.ev.rawmsg = "(not a string)";
        let t = tojson_of(doc, filter, x);
        if t >= 0 {
            let n = str_plain(doc, t, 0);
            var n3 = n;
            if n3 > 200 { n3 = 200; }
            while n3 > 0 && n3 < n && (byte_at(jj.tmp, n3) & 192) == 128 { n3 -= 1; }
            jj.err = "jx: error (not a string): " + substr(jj.tmp, 0, n3);
        }
    }
    return -1;
}

// raise the error a scope body met earlier while the document streamed by
fn raise_deferred(r: i64) -> i64 {
    let m = jj.ev.emsg;
    jqerr(m);
    if jj.ev.rerrv[r] >= 0 { jj.ev.errv = jj.ev.rerrv[r]; }
    return -1;
}
// the iteration `.[]` of a scope is an error unless the iterated value is an array or object
fn scope_parent_check(doc: text, filter: text, s: i64) -> i64 {
    let p = jj.f.s_par[s];
    if jj.sc.anyerr { if nav_check(p) != 0 { return 1; } }
    var tag = 1;
    if jj.sc.sgen[p] == gen_of(p) { tag = jj.sc.stag[p]; }
    if tag == 6 || tag == 7 { return 0; }
    if tag == 1 { jqerr("Cannot iterate over null (null)"); return 1; }
    let h = slot_val(p);
    if h < 0 { return 1; }
    jqerr("Cannot iterate over " + typed(doc, filter, h));
    return 1;
}

// the scopes of an iteration node whose element just ended: run their bodies
fn run_unit(doc: text, filter: text, n: i64) -> i64 {
    var s = jj.f.sc1[n];
    let d = jj.f.s_depth[s];
    let save = jj.ev.depth;
    var rc = 0;
    while s >= 0 && rc == 0 {
        let term = jj.f.s_term[s];
        var r = 0;
        var skip = false;
        if term != 1 {
            r = jj.f.s_reg[s];
            reg_touch(r);
            if jj.ev.rerr[r] != 0 { skip = true; }
        }
        if !skip {
            jj.ev.depth = d;
            var h = jj.ev.hnull;
            if jj.f.want[n] != 0 { h = node_val(n); }
            if h >= 0 {
                jj.m.rv[jj.c.ein[s]] = h;
                var x = exec(doc, filter, jj.c.entry[s]);
                if x != 0 {
                    if jj.ev.err == 1 && term != 1 { jj.ev.rerr[r] = 1; jj.ev.emsg = jj.ev.rawmsg; jj.ev.rerrv[r] = copy_deep(jj.ev.errv, 0); x = 0; jj.ev.err = 0; }
                }
                rc = x;
            } else if jj.ev.err == 1 && term != 1 {
                jj.ev.rerr[r] = 1;
                jj.ev.emsg = jj.ev.rawmsg; jj.ev.rerrv[r] = copy_deep(jj.ev.errv, 0);
                jj.ev.err = 0;
            } else { rc = 1; }
        }
        s = jj.f.s_next[s];
    }
    // everything made for this element is gone
    jj.v.top[d] = jj.v.base[d];
    if d == 1 { jj.ev.scr = ""; }
    jj.ev.depth = save;
    return rc;
}

// the end of the document (or of the early exit): run the tree at the document level
fn run_root(doc: text, filter: text) -> i64 {
    jj.ev.depth = 0;
    var v = jj.ev.hnull;
    if jj.f.want[0] != 0 { v = node_val(0); }
    var rc = 1;
    if v >= 0 {
        jj.m.rv[jj.c.ein[32]] = v;
        rc = exec(doc, filter, jj.c.entry[32]);
    }
    if rc != 0 && len(jj.err) == 0 { jj.err = "jx: error"; }
    return rc;
}
