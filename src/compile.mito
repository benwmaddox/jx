// The filter compiler: reads the filter text once into an expression tree (no ASTs beyond fixed arrays), then analyzes the tree
// to build (a) a trie of the wanted paths (the path automaton: a node is a value reached by a path, with child entries by key,
// by index and by `[]`) and (b) scopes: an iteration of a node whose body runs at the end of each element while the document streams by.
// Grammar (jq's, the supported part):
//   pipe `|` (right), `,`, `//` (right), `or`, `and`, comparisons (not chained), `+ -`, `* / %`, unary minus, postfix `.k ."k" [n] ["k"] []`,
//   `.`, literals, `( )`, `[ ]`, `{ }`, `if/elif/else/end`, and the builtins length type keys has not add empty first map select
//   tostring tonumber floor ceil round sqrt fabs.
// Everything else is rejected here, before any input is read: exit code 1, `jx: not supported in Stage 2: ...`.

const K {
    ID: i64 = 1; LIT: i64 = 2; NODE: i64 = 3; FIELD: i64 = 4; IDX: i64 = 5; ITER: i64 = 6; PIPE: i64 = 7; COMMA: i64 = 8;
    ALT: i64 = 9; BIN: i64 = 10; AND: i64 = 11; OR: i64 = 12; NEG: i64 = 13; IF: i64 = 14; ARR: i64 = 15; OBJ: i64 = 16;
    FN: i64 = 17; SELECT: i64 = 18; EMPTY: i64 = 19; CMPLIT: i64 = 20; FOLD: i64 = 21; PLAY: i64 = 22;
    TRY: i64 = 23; VAR: i64 = 24; AS: i64 = 25; VARBIND: i64 = 26; REDUCE: i64 = 27; RBIND: i64 = 28; RANGE: i64 = 29;
    LIMIT: i64 = 30; UNTIL: i64 = 31; ERROR: i64 = 32; SLICE: i64 = 33;
}

const F {
    LENGTH: i64 = 1; TYPE: i64 = 2; KEYS: i64 = 3; HAS: i64 = 4; NOT: i64 = 5; ADD: i64 = 6; TOSTRING: i64 = 7; TONUMBER: i64 = 8;
    FLOOR: i64 = 9; CEIL: i64 = 10; ROUND: i64 = 11; SQRT: i64 = 12; FABS: i64 = 13; TOJSON: i64 = 14; TYPEMASK: i64 = 15; TOBOOL: i64 = 16;
}

fn reject(what: text, p: i64) -> i64 {
    jj.err = "jx: not supported in Stage 2: " + what + " (filter position " + str(p) + ")";
    return 1;
}

fn syntax(what: text, p: i64) -> i64 {
    jj.err = "jx: syntax error: " + what + " (filter position " + str(p) + ")";
    return 1;
}

fn is_name_start(c: i64) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95;
}

fn is_name_char(c: i64) -> bool {
    return is_name_start(c) || is_digit(c);
}

fn mk(kind: i64, a: i64, b: i64, c: i64, p: i64) -> i64 {
    let n = jj.f.nast;
    if n >= 1023 { jj.err = "jx: the filter is too big (1024 expression nodes)"; return -1; }
    jj.f.nast = n + 1;
    jj.f.ak[n] = kind;
    jj.f.aa[n] = a;
    jj.f.ab[n] = b;
    jj.f.ac[n] = c;
    jj.f.ad[n] = 0;
    jj.f.nx[n] = -1;
    jj.f.at[n] = p;
    return n;
}

// ---- automaton nodes ----

fn new_node(parent: i64) -> i64 {
    let n = jj.f.nn;
    jj.f.nn = n + 1;
    jj.f.par[n] = parent;
    jj.f.niter[n] = -1;
    jj.f.sc1[n] = -1;
    jj.f.owner[n] = -1;
    return n;
}

fn new_entry(parent: i64, kind: i64) -> i64 {
    jj.f.ne += 1;
    let e = jj.f.ne;
    jj.f.ekind[e] = kind;
    jj.f.enext[e] = jj.f.nfirst[parent];
    jj.f.nfirst[parent] = e;
    jj.f.eord[e] = jj.f.nkeys[parent] + jj.f.nidx[parent];
    return e;
}

fn too_big() -> i64 {
    jj.err = "jx: the filter is too big for the automaton (256 nodes, 255 edges, 60 children of one value)";
    return -1;
}

// the node for key keys[ko, ko+kl) below `node`, made if missing; -1 when the automaton is full
fn child_key(node: i64, ko: i64, kl: i64) -> i64 {
    var e = jj.f.nfirst[node];
    while e != 0 {
        if jj.f.ekind[e] == 0 && jj.f.eb[e] == kl && substr(jj.f.keys, jj.f.ea[e], kl) == substr(jj.f.keys, ko, kl) { return jj.f.enode[e]; }
        e = jj.f.enext[e];
    }
    if jj.f.nn >= 255 || jj.f.ne >= 254 || jj.f.nkeys[node] + jj.f.nidx[node] >= 60 { return too_big(); }
    let n = new_node(node);
    e = new_entry(node, 0);
    jj.f.ea[e] = ko;
    jj.f.eb[e] = kl;
    jj.f.ef[e] = byte_at(jj.f.keys, ko);
    jj.f.enode[e] = n;
    jj.f.nkeys[node] += 1;
    return n;
}

fn child_idx(node: i64, k: i64) -> i64 {
    var e = jj.f.nfirst[node];
    while e != 0 {
        if jj.f.ekind[e] == 1 && jj.f.ea[e] == k { return jj.f.enode[e]; }
        e = jj.f.enext[e];
    }
    if jj.f.nn >= 255 || jj.f.ne >= 254 || jj.f.nkeys[node] + jj.f.nidx[node] >= 60 { return too_big(); }
    let n = new_node(node);
    e = new_entry(node, 1);
    jj.f.ea[e] = k;
    jj.f.enode[e] = n;
    jj.f.nidx[node] += 1;
    return n;
}

fn child_iter(node: i64) -> i64 {
    if jj.f.niter[node] >= 0 { return jj.f.niter[node]; }
    if jj.f.nn >= 255 { return too_big(); }
    let n = new_node(node);
    jj.f.niter[node] = n;
    return n;
}

// ---- literals ----

// the string literal at q (its quote) of the filter, unescaped onto `keys` (to_keys) or `lits`; the position after it, or -1
fn filter_string(f: text, q: i64, to_keys: bool) -> i64 {
    var i = q + 1;
    var rs = i;
    while true {
        let c = byte_at(f, i);
        if c < 0 { jj.err = "jx: a string in the filter does not end"; return -1; }
        if c == 34 { break; }
        if c != 92 { i += 1; continue; }
        if byte_at(f, i + 1) == 40 { reject("string interpolation", i); return -1; }
        let d = byte_at(f, i + 1);
        if !(d == 34 || d == 92 || d == 47 || d == 98 || d == 102 || d == 110 || d == 114 || d == 116 || d == 117) {
            jj.err = "jx: invalid escape in a string of the filter";
            return -1;
        }
        if i > rs { if to_keys { jj.f.keys += substr(f, rs, i - rs); } else { jj.f.lits += substr(f, rs, i - rs); } }
        let cp = escape_cp(f, i);
        if cp == 0 { if to_keys { jj.f.keys += "\0"; } else { jj.f.lits += "\0"; } }
        else if to_keys { jj.f.keys += chr(cp); } else { jj.f.lits += chr(cp); }
        i += jj.sc.esc;
        rs = i;
    }
    if i > rs { if to_keys { jj.f.keys += substr(f, rs, i - rs); } else { jj.f.lits += substr(f, rs, i - rs); } }
    return i + 1;
}

// a constant value entry
fn new_const(tag: i64, vs: i64, a: i64, b: i64) -> i64 {
    let h = jj.v.ncon;
    if h >= 4000 { jj.err = "jx: too many literals in the filter"; return -1; }
    jj.v.ncon = h + 1;
    jj.v.vt[h] = tag;
    jj.v.vs[h] = vs;
    jj.v.va[h] = a;
    jj.v.vb[h] = b;
    jj.v.vf[h] = 0;
    jj.v.vd[h] = -1;
    jj.v.vn[h] = -1;
    return h;
}

// a number literal at [q, e) of the filter text
fn number_const(f: text, q: i64, e: i64) -> i64 {
    var n = 0;
    var k = q;
    var plain = (e - q) <= 15;
    while k < e && plain {
        let c = byte_at(f, k);
        if !is_digit(c) { plain = false; } else { n = n * 10 + c - 48; }
        k += 1;
    }
    if plain { return new_const(4, 4, n, 0); }
    return new_const(4, 1, q, e);
}

fn is_word(f: text, q: i64, w: text) -> bool {
    let n = len(w);
    if q + n > len(f) { return false; }
    return substr(f, q, n) == w && !is_name_char(byte_at(f, q + n));
}

fn rej1(what: text, p: i64) -> i64 {
    reject(what, p);
    return -1;
}

fn syn1(what: text, p: i64) -> i64 {
    syntax(what, p);
    return -1;
}

// ---- the parser ----

// builds `l | r` with the pipes nested to the right (a | b) | c is a | (b | c)
fn mk_pipe(l: i64, r: i64, p: i64) -> i64 {
    if l < 0 || r < 0 { return -1; }
    if jj.f.ak[l] == K.PIPE {
        let rr = mk_pipe(jj.f.ab[l], r, p);
        if rr < 0 { return -1; }
        return mk(K.PIPE, jj.f.aa[l], rr, 0, p);
    }
    return mk(K.PIPE, l, r, 0, p);
}

// the key at q (after a dot, or inside brackets), onto `keys`; the node's key offset and length in a, b; the position after it, or -1
fn parse_key(f: text, q: i64) -> i64 {
    let ko = len(jj.f.keys);
    var e = 0;
    if byte_at(f, q) == 34 {
        e = filter_string(f, q, true);
        if e < 0 { return -1; }
    } else {
        e = q;
        while is_name_char(byte_at(f, e)) { e += 1; }
        jj.f.keys += substr(f, q, e - q);
    }
    jj.cp = e;
    return ko;
}

// the arguments of a builtin written (a; b; c): parsed into jj.pa, counted in jj.pn; false on error
fn parse_args(f: text, name: text, lo: i64, hi: i64) -> bool {
    var q = skip_ws(f, jj.cp);
    if byte_at(f, q) != 40 { syntax("`" + name + "` needs its arguments in parentheses", q); return false; }
    jj.cp = q + 1;
    var cnt = 0;
    var a0 = -1;
    var a1 = -1;
    var a2 = -1;
    while true {
        let a = parse_expr(f, 1);
        if a < 0 { return false; }
        if cnt >= hi { reject("more than " + str(hi) + " arguments to `" + name + "`", q); return false; }
        if cnt == 0 { a0 = a; } else if cnt == 1 { a1 = a; } else { a2 = a; }
        cnt += 1;
        q = skip_ws(f, jj.cp);
        if byte_at(f, q) == 59 { jj.cp = q + 1; continue; }
        if byte_at(f, q) == 41 { jj.cp = q + 1; break; }
        syntax("expected ; or ) in the arguments of `" + name + "`", q);
        return false;
    }
    if cnt < lo { syntax("`" + name + "` needs " + str(lo) + " arguments", q); return false; }
    jj.pa[0] = a0;
    jj.pa[1] = a1;
    jj.pa[2] = a2;
    jj.pn = cnt;
    return true;
}

// the variable named keys[...] in scope, else -1
fn find_var(f: text, q: i64, e: i64) -> i64 {
    var k = jj.f.nvar - 1;
    while k >= 0 {
        if jj.f.vname_len[k] == e - q && substr(jj.f.keys, jj.f.vname_off[k], e - q) == substr(f, q, e - q) { return jj.f.vslot[k]; }
        k -= 1;
    }
    return -1;
}

fn const_num(n: i64) -> i64 {
    return mk(K.LIT, new_const(4, 4, n, 0), 0, 0, 0);
}

fn parse_postfix(f: text, t0: i64) -> i64 {
    var t = t0;
    while t >= 0 {
        var q = jj.cp;
        var c = byte_at(f, q);
        if c == 46 {
            let d = byte_at(f, q + 1);
            if d == 46 { reject("`..`", q); return -1; }
            if is_name_start(d) || d == 34 {
                let ko = parse_key(f, q + 1);
                if ko < 0 { return -1; }
                t = mk(K.FIELD, t, ko, len(jj.f.keys) - ko, q);
                continue;
            }
            if d == 91 { jj.cp = q + 1; continue; }
            if is_digit(d) { syntax("a field name cannot start with a digit", q); return -1; }
            break;
        }
        q = skip_ws(f, q);
        c = byte_at(f, q);
        if c == 91 {
            q = skip_ws(f, q + 1);
            let d = byte_at(f, q);
            if d == 93 {
                t = mk(K.ITER, t, 0, 0, q);
                jj.cp = q + 1;
                continue;
            }
            if d == 34 {
                let ko = parse_key(f, q);
                if ko < 0 { return -1; }
                q = skip_ws(f, jj.cp);
                if byte_at(f, q) != 93 { syntax("expected ] after the key", q); return -1; }
                t = mk(K.FIELD, t, ko, len(jj.f.keys) - ko, q);
                jj.cp = q + 1;
                continue;
            }
            // an index, a slice or an expression: parsed as expressions
            var lo = -1;
            if d != 58 {
                jj.cp = q;
                lo = parse_expr(f, 1);
                if lo < 0 { return -1; }
                q = skip_ws(f, jj.cp);
            }
            if byte_at(f, q) == 58 {
                var hi = -1;
                q = skip_ws(f, q + 1);
                if byte_at(f, q) != 93 {
                    jj.cp = q;
                    hi = parse_expr(f, 1);
                    if hi < 0 { return -1; }
                    q = skip_ws(f, jj.cp);
                }
                if byte_at(f, q) != 93 { syntax("expected ] after the slice", q); return -1; }
                t = mk(K.SLICE, t, lo, hi, q);
                jj.cp = q + 1;
                continue;
            }
            if byte_at(f, q) != 93 { syntax("expected ] after the index", q); return -1; }
            if jj.f.ak[lo] == K.LIT && jj.v.vt[jj.f.aa[lo]] == 4 && jj.v.vs[jj.f.aa[lo]] == 4 && jj.v.va[jj.f.aa[lo]] >= 0 {
                t = mk(K.IDX, t, jj.v.va[jj.f.aa[lo]], 0, q);
                jj.cp = q + 1;
                continue;
            }
            if jj.f.ak[lo] == K.LIT && jj.v.vt[jj.f.aa[lo]] == 4 && jj.v.vs[jj.f.aa[lo]] == 4 { reject("a negative index (it needs the array's length)", q); return -1; }
            reject("an index computed by an expression (dynamic indexing)", q);
            return -1;
        }
        if c == 63 {
            t = mk(K.TRY, t, -1, 0, q);
            jj.cp = q + 1;
            continue;
        }
        if is_word(f, q, "as") && jj.noas == 0 { break; }
        break;
    }
    return t;
}

fn parse_object(f: text, p0: i64) -> i64 {
    // after the brace
    var cnt = 0;
    var head = -1;
    var tail = -1;
    var q = skip_ws(f, jj.cp);
    if byte_at(f, q) == 125 { jj.cp = q + 1; return mk(K.OBJ, jj.f.nobj, 0, 0, p0); }
    while true {
        q = skip_ws(f, q);
        let c = byte_at(f, q);
        var key = -1;
        var shorthand = -1;
        if c == 34 {
            let lo = len(jj.f.lits);
            let e = filter_string(f, q, false);
            if e < 0 { return -1; }
            key = mk(K.LIT, new_const(5, 1, lo, len(jj.f.lits) - lo), 0, 0, q);
            let ko = len(jj.f.keys);
            if filter_string(f, q, true) < 0 { return -1; }
            shorthand = mk(K.FIELD, mk(K.ID, 0, 0, 0, q), ko, len(jj.f.keys) - ko, q);
            q = e;
        } else if is_name_start(c) {
            var e = q;
            while is_name_char(byte_at(f, e)) { e += 1; }
            let lo = len(jj.f.lits);
            jj.f.lits += substr(f, q, e - q);
            key = mk(K.LIT, new_const(5, 1, lo, e - q), 0, 0, q);
            let ko = len(jj.f.keys);
            jj.f.keys += substr(f, q, e - q);
            shorthand = mk(K.FIELD, mk(K.ID, 0, 0, 0, q), ko, e - q, q);
            q = e;
        } else if c == 40 {
            jj.cp = q + 1;
            key = parse_expr(f, 1);
            if key < 0 { return -1; }
            q = skip_ws(f, jj.cp);
            if byte_at(f, q) != 41 { syntax("expected ) after the key", q); return -1; }
            q += 1;
        } else if c == 36 {
            var e2 = q + 1;
            while is_name_char(byte_at(f, e2)) { e2 += 1; }
            if e2 == q + 1 { return syn1("a variable name is needed after `$`", q); }
            let slot = find_var(f, q + 1, e2);
            if slot < 0 { return syn1("$" + substr(f, q + 1, e2 - q - 1) + " is not defined", q); }
            let vn = mk(K.VAR, 0, 0, slot, q);
            if vn < 0 { return -1; }
            let q3 = skip_ws(f, e2);
            if byte_at(f, q3) == 58 {
                // {$x: v} is {($x): v}
                key = vn;
                q = e2;
            } else {
                // {$x} is {x: $x}
                let lo = len(jj.f.lits);
                jj.f.lits += substr(f, q + 1, e2 - q - 1);
                key = mk(K.LIT, new_const(5, 1, lo, e2 - q - 1), 0, 0, q);
                shorthand = vn;
                q = e2;
            }
        } else if c == 64 {
            return rej1("a format string in an object", q);
        } else {
            return syn1("an object key must be a name, a string or (expression)", q);
        }
        q = skip_ws(f, q);
        var val = -1;
        if byte_at(f, q) == 58 {
            jj.cp = skip_ws(f, q + 1);
            // an object value is a term, with unary minus and pipes between terms (jq's ExpD)
            var v = parse_expr(f, 3);
            if v < 0 { return -1; }
            while true {
                let q2 = skip_ws(f, jj.cp);
                if byte_at(f, q2) == 124 && byte_at(f, q2 + 1) != 61 {
                    jj.cp = q2 + 1;
                    let r = parse_expr(f, 3);
                    if r < 0 { return -1; }
                    v = mk_pipe(v, r, q2);
                    if v < 0 { return -1; }
                } else { break; }
            }
            val = v;
            q = skip_ws(f, jj.cp);
        } else {
            if shorthand < 0 { return syn1("expected : after the key", q); }
            val = shorthand;
        }
        // the entry waits in a chain: a nested object takes its own block of entries first
        let en = mk(K.ID, key, val, -1, q);
        if en < 0 { return -1; }
        if tail >= 0 { jj.f.ac[tail] = en; } else { head = en; }
        tail = en;
        cnt += 1;
        let d = byte_at(f, q);
        if d == 44 { q += 1; continue; }
        if d == 125 { jj.cp = q + 1; break; }
        return syn1("expected , or } in the object", q);
    }
    if jj.f.nobj + cnt > 255 { jj.err = "jx: too many object entries in the filter"; return -1; }
    let first = jj.f.nobj;
    var en2 = head;
    while en2 >= 0 {
        jj.f.okey[jj.f.nobj] = jj.f.aa[en2];
        jj.f.oval[jj.f.nobj] = jj.f.ab[en2];
        jj.f.nobj += 1;
        en2 = jj.f.ac[en2];
    }
    return mk(K.OBJ, first, cnt, 0, p0);
}

fn parse_if(f: text, p0: i64) -> i64 {
    // after `if` or `elif`
    let c = parse_expr(f, 1);
    if c < 0 { return -1; }
    var q = skip_ws(f, jj.cp);
    if !is_word(f, q, "then") { return syn1("expected `then`", q); }
    jj.cp = q + 4;
    let t = parse_expr(f, 1);
    if t < 0 { return -1; }
    q = skip_ws(f, jj.cp);
    var e = -1;
    if is_word(f, q, "elif") {
        jj.cp = q + 4;
        e = parse_if(f, q);
        if e < 0 { return -1; }
        return mk(K.IF, c, t, e, p0);
    }
    if is_word(f, q, "else") {
        jj.cp = q + 4;
        e = parse_expr(f, 1);
        if e < 0 { return -1; }
        q = skip_ws(f, jj.cp);
    } else {
        e = mk(K.ID, 0, 0, 0, q);
    }
    if !is_word(f, q, "end") { return syn1("expected `end`", q); }
    jj.cp = q + 3;
    return mk(K.IF, c, t, e, p0);
}

// the arguments of a builtin: `(` expr `)`; the expression, or -1
fn parse_arg(f: text, name: text) -> i64 {
    var q = skip_ws(f, jj.cp);
    if byte_at(f, q) != 40 { syntax("`" + name + "` needs an argument in parentheses", q); return -1; }
    jj.cp = q + 1;
    let a = parse_expr(f, 1);
    if a < 0 { return -1; }
    q = skip_ws(f, jj.cp);
    if byte_at(f, q) == 59 { reject("a second argument to `" + name + "`", q); return -1; }
    if byte_at(f, q) != 41 { syntax("expected ) after the argument", q); return -1; }
    jj.cp = q + 1;
    return a;
}

// a call without arguments must not have parentheses with arguments
fn no_args(f: text, name: text) -> bool {
    let q = skip_ws(f, jj.cp);
    if byte_at(f, q) == 40 { reject("`" + name + "(...)` with arguments", q); return false; }
    return true;
}

fn parse_primary(f: text) -> i64 {
    let q = skip_ws(f, jj.cp);
    let c = byte_at(f, q);
    if c < 0 { return syn1("unexpected end of the filter", q); }
    if c == 46 {
        let d = byte_at(f, q + 1);
        if d == 46 { reject("`..`", q); return -1; }
        if is_name_start(d) || d == 34 {
            let ko = parse_key(f, q + 1);
            if ko < 0 { return -1; }
            return mk(K.FIELD, mk(K.ID, 0, 0, 0, q), ko, len(jj.f.keys) - ko, q);
        }
        if is_digit(d) { syntax("a number cannot start with a dot", q); return -1; }
        jj.cp = q + 1;
        return mk(K.ID, 0, 0, 0, q);
    }
    if is_digit(c) {
        let e = scan_number(f, q);
        if e < 0 { jj.err = "jx: syntax error: invalid number in the filter"; return -1; }
        jj.cp = e;
        let h = number_const(f, q, e);
        if h < 0 { return -1; }
        return mk(K.LIT, h, 0, 0, q);
    }
    if c == 34 {
        let lo = len(jj.f.lits);
        let e = filter_string(f, q, false);
        if e < 0 { return -1; }
        jj.cp = e;
        let h = new_const(5, 1, lo, len(jj.f.lits) - lo);
        if h < 0 { return -1; }
        return mk(K.LIT, h, 0, 0, q);
    }
    if c == 40 {
        jj.cp = q + 1;
        let e = parse_expr(f, 1);
        if e < 0 { return -1; }
        let q2 = skip_ws(f, jj.cp);
        if byte_at(f, q2) != 41 { syntax("expected )", q2); return -1; }
        jj.cp = q2 + 1;
        return e;
    }
    if c == 91 {
        jj.cp = q + 1;
        let q2 = skip_ws(f, jj.cp);
        if byte_at(f, q2) == 93 { jj.cp = q2 + 1; return mk(K.ARR, -1, -1, -1, q); }
        let e = parse_expr(f, 1);
        if e < 0 { return -1; }
        let q3 = skip_ws(f, jj.cp);
        if byte_at(f, q3) != 93 { syntax("expected ]", q3); return -1; }
        jj.cp = q3 + 1;
        return mk(K.ARR, e, -1, -1, q);
    }
    if c == 123 {
        jj.cp = q + 1;
        return parse_object(f, q);
    }
    if c == 36 {
        var e = q + 1;
        while is_name_char(byte_at(f, e)) { e += 1; }
        if e == q + 1 { return syn1("a variable name is needed after `$`", q); }
        let slot = find_var(f, q + 1, e);
        if slot < 0 {
            if substr(f, q + 1, e - q - 1) == "__loc__" { return rej1("`$__loc__`", q); }
            if substr(f, q + 1, e - q - 1) == "ENV" { return rej1("`$ENV`", q); }
            return syn1("$" + substr(f, q + 1, e - q - 1) + " is not defined", q);
        }
        jj.cp = e;
        return mk(K.VAR, 0, 0, slot, q);
    }
    if c == 64 { reject("a format string (`@...`)", q); return -1; }
    if is_name_start(c) {
        var e = q;
        while is_name_char(byte_at(f, e)) { e += 1; }
        let w = substr(f, q, e - q);
        jj.cp = e;
        if w == "have_decnum" || w == "have_literal_numbers" { return mk(K.LIT, jj.ev.htrue, 0, 0, q); }
        if w == "true" { return mk(K.LIT, jj.ev.htrue, 0, 0, q); }
        if w == "false" { return mk(K.LIT, jj.ev.hfalse, 0, 0, q); }
        if w == "null" { return mk(K.LIT, jj.ev.hnull, 0, 0, q); }
        if w == "if" { return parse_if(f, q); }
        if w == "empty" { if !no_args(f, w) { return -1; } return mk(K.EMPTY, 0, 0, 0, q); }
        if w == "length" { if !no_args(f, w) { return -1; } return mk(K.FN, -1, -1, F.LENGTH, q); }
        if w == "type" { if !no_args(f, w) { return -1; } return mk(K.FN, -1, -1, F.TYPE, q); }
        if w == "keys" { if !no_args(f, w) { return -1; } return mk(K.FN, -1, -1, F.KEYS, q); }
        if w == "not" { if !no_args(f, w) { return -1; } return mk(K.FN, -1, -1, F.NOT, q); }
        if w == "add" {
            let q2 = skip_ws(f, jj.cp);
            if byte_at(f, q2) == 40 {
                let a = parse_arg(f, w);
                if a < 0 { return -1; }
                return mk(K.FOLD, a, -1, 1, q);
            }
            return mk(K.FN, -1, -1, F.ADD, q);
        }
        if w == "tostring" { if !no_args(f, w) { return -1; } return mk(K.FN, -1, -1, F.TOSTRING, q); }
        if w == "tonumber" { if !no_args(f, w) { return -1; } return mk(K.FN, -1, -1, F.TONUMBER, q); }
        if w == "try" {
            let b = parse_unary(f);
            if b < 0 { return -1; }
            var h = -1;
            let q2 = skip_ws(f, jj.cp);
            if is_word(f, q2, "catch") {
                jj.cp = q2 + 5;
                h = parse_unary(f);
                if h < 0 { return -1; }
            }
            return mk(K.TRY, b, h, 0, q);
        }
        if w == "error" {
            let q2 = skip_ws(f, jj.cp);
            if byte_at(f, q2) == 40 {
                let a = parse_arg(f, w);
                if a < 0 { return -1; }
                return mk(K.ERROR, a, 0, 0, q);
            }
            return mk(K.ERROR, mk(K.ID, 0, 0, 0, q), 0, 0, q);
        }
        if w == "range" {
            if !parse_args(f, w, 1, 3) { return -1; }
            if jj.pn == 1 { return mk(K.RANGE, const_num(0), jj.pa[0], const_num(1), q); }
            if jj.pn == 2 { return mk(K.RANGE, jj.pa[0], jj.pa[1], const_num(1), q); }
            return mk(K.RANGE, jj.pa[0], jj.pa[1], jj.pa[2], q);
        }
        if w == "limit" {
            if !parse_args(f, w, 2, 2) { return -1; }
            return mk(K.LIMIT, jj.pa[0], jj.pa[1], 1, q);
        }
        if w == "nth" {
            if !parse_args(f, w, 2, 2) { return -1; }
            return mk(K.LIMIT, jj.pa[0], jj.pa[1], 5, q);
        }
        if w == "isempty" {
            if !parse_args(f, w, 1, 1) { return -1; }
            return mk(K.LIMIT, -1, jj.pa[0], 3, q);
        }
        if w == "until" {
            if !parse_args(f, w, 2, 2) { return -1; }
            return mk(K.UNTIL, jj.pa[0], jj.pa[1], 0, q);
        }
        if w == "last" {
            let q2 = skip_ws(f, jj.cp);
            if byte_at(f, q2) != 40 { return rej1("`last` without an argument (it needs the array's length)", q); }
            if !parse_args(f, w, 1, 1) { return -1; }
            return mk(K.LIMIT, -1, jj.pa[0], 4, q);
        }
        if w == "reduce" { return rej1("`reduce` (Stage 3)", q); }
        if w == "reduce_unreachable" {
            jj.noas = jj.noas + 1;
            let s0 = parse_primary(f);
            if s0 < 0 { return -1; }
            let src = parse_postfix(f, s0);
            jj.noas = jj.noas - 1;
            if src < 0 { return -1; }
            var e = skip_ws(f, jj.cp);
            if !is_word(f, e, "as") { return syn1("expected `as` in reduce", e); }
            e = skip_ws(f, e + 2);
            if byte_at(f, e) != 36 { return rej1("destructuring patterns in reduce", e); }
            let ns = e + 1;
            e = ns;
            while is_name_char(byte_at(f, e)) { e += 1; }
            if jj.f.nvars >= 60 { jj.err = "jx: too many variables in the filter"; return -1; }
            let slot = jj.f.nvars;
            jj.f.nvars += 1;
            let lo = len(jj.f.keys);
            jj.f.keys += substr(f, ns, e - ns);
            jj.cp = e;
            let q2 = skip_ws(f, e);
            if byte_at(f, q2) != 40 { return syn1("expected ( after the reduce variable", q2); }
            // init is outside the scope of the variable, update inside
            jj.cp = q2 + 1;
            let init = parse_expr(f, 1);
            if init < 0 { return -1; }
            let q3 = skip_ws(f, jj.cp);
            if byte_at(f, q3) != 59 { return syn1("expected ; in reduce", q3); }
            jj.cp = q3 + 1;
            let save = jj.f.nvar;
            jj.f.vname_off[jj.f.nvar] = lo;
            jj.f.vname_len[jj.f.nvar] = e - ns;
            jj.f.vslot[jj.f.nvar] = slot;
            jj.f.nvar += 1;
            let upd = parse_expr(f, 1);
            jj.f.nvar = save;
            if upd < 0 { return -1; }
            let q4 = skip_ws(f, jj.cp);
            if byte_at(f, q4) == 59 { return rej1("foreach-style extract in reduce", q4); }
            if byte_at(f, q4) != 41 { return syn1("expected ) after reduce", q4); }
            jj.cp = q4 + 1;
            let rn = mk(K.REDUCE, src, upd, slot, q);
            if rn < 0 { return -1; }
            jj.f.ad[rn] = init;
            return rn;
        }
        if w == "arrays" || w == "objects" || w == "iterables" || w == "scalars" || w == "values" || w == "booleans" || w == "nulls" || w == "numbers" || w == "strings" {
            if !no_args(f, w) { return -1; }
            var mask = 0;
            if w == "arrays" { mask = 64; }
            if w == "objects" { mask = 128; }
            if w == "iterables" { mask = 192; }
            if w == "scalars" { mask = 62; }
            if w == "values" { mask = 252; }
            if w == "booleans" { mask = 12; }
            if w == "nulls" { mask = 2; }
            if w == "numbers" { mask = 16; }
            if w == "strings" { mask = 32; }
            let tm = mk(K.FN, -1, -1, F.TYPEMASK, q);
            if tm < 0 { return -1; }
            jj.f.ad[tm] = mask;
            return mk(K.SELECT, tm, 0, 0, q);
        }
        if w == "toboolean" { if !no_args(f, w) { return -1; } return mk(K.FN, -1, -1, F.TOBOOL, q); }
        if w == "skip" {
            if !parse_args(f, w, 2, 2) { return -1; }
            return mk(K.LIMIT, jj.pa[0], jj.pa[1], 6, q);
        }
        if w == "first" {
            let q2 = skip_ws(f, jj.cp);
            if byte_at(f, q2) == 40 {
                if !parse_args(f, w, 1, 1) { return -1; }
                return mk(K.LIMIT, const_num(1), jj.pa[0], 1, q);
            }
            return mk(K.IDX, mk(K.ID, 0, 0, 0, q), 0, 0, q);
        }
        if w == "has" {
            let a = parse_arg(f, w);
            if a < 0 { return -1; }
            return mk(K.FN, a, -1, F.HAS, q);
        }
        if w == "select" {
            let a = parse_arg(f, w);
            if a < 0 { return -1; }
            return mk(K.SELECT, a, 0, 0, q);
        }
        if w == "map" {
            let a = parse_arg(f, w);
            if a < 0 { return -1; }
            let it = mk(K.ITER, mk(K.ID, 0, 0, 0, q), 0, 0, q);
            let pp = mk_pipe(it, a, q);
            if pp < 0 { return -1; }
            return mk(K.ARR, pp, -1, -1, q);
        }
        if w == "then" || w == "else" || w == "elif" || w == "end" || w == "and" || w == "or" || w == "as" || w == "catch" {
            return syn1("unexpected `" + w + "`", q);
        }
        return rej1("`" + w + "`", q);
    }
    reject("`" + substr(f, q, 1) + "`", q);
    return -1;
}

fn parse_unary(f: text) -> i64 {
    let q = skip_ws(f, jj.cp);
    if byte_at(f, q) == 45 {
        jj.cp = q + 1;
        let e = parse_unary(f);
        if e < 0 { return -1; }
        // a number literal folds: -1 is a literal
        if jj.f.ak[e] == K.LIT {
            let h = jj.f.aa[e];
            if jj.v.vt[h] == 4 && jj.v.vs[h] == 4 { return mk(K.LIT, new_const(4, 4, -jj.v.va[h], 0), 0, 0, q); }
            if jj.v.vt[h] == 4 && jj.v.vs[h] == 1 {
                let hh = new_const(4, 1, jj.v.va[h], jj.v.vb[h]);
                jj.v.vf[hh] = 1;
                return mk(K.LIT, hh, 0, 0, q);
            }
        }
        return mk(K.NEG, e, 0, 0, q);
    }
    jj.cdepth += 1;
    if jj.cdepth > 20 { return rej1("expressions nested more than 20 deep", q); }
    let t = parse_primary(f);
    let r = parse_postfix(f, t);
    jj.cdepth -= 1;
    return r;
}

// the operator at q: its precedence in the low bits, its kind * 64; 0 when none. jj.cp is left at the end of it.
// precedence: 1 `|`, 2 `,`, 3 `//`, 5 or, 6 and, 7 comparison, 8 + -, 9 * / %
fn peek_op(f: text, q: i64) -> i64 {
    let c = byte_at(f, q);
    let d = byte_at(f, q + 1);
    if c == 124 { if d == 61 { return -1; } return 1 + 64 * 1; }
    if c == 44 { return 2 + 64 * 2; }
    if c == 47 && d == 47 { if byte_at(f, q + 2) == 61 { return -1; } return 3 + 64 * 3; }
    if c == 111 && is_word(f, q, "or") { return 5 + 64 * 5; }
    if c == 97 && is_word(f, q, "and") { return 6 + 64 * 6; }
    if c == 61 && d == 61 { return 7 + 64 * 11; }
    if c == 33 && d == 61 { return 7 + 64 * 12; }
    if c == 60 && d == 61 { return 7 + 64 * 14; }
    if c == 62 && d == 61 { return 7 + 64 * 16; }
    if c == 60 { return 7 + 64 * 13; }
    if c == 62 { return 7 + 64 * 15; }
    if c == 61 { return -1; }
    if (c == 43 || c == 45 || c == 42 || c == 47 || c == 37) && d == 61 { return -1; }
    if c == 43 { return 8 + 64 * 21; }
    if c == 45 { return 8 + 64 * 22; }
    if c == 42 { return 9 + 64 * 23; }
    if c == 47 { return 9 + 64 * 24; }
    if c == 37 { return 9 + 64 * 25; }
    return 0;
}

fn parse_expr(f: text, minp: i64) -> i64 {
    var lhs = parse_unary(f);
    if lhs < 0 { return -1; }
    var last_cmp = false;
    while true {
        let q = skip_ws(f, jj.cp);
        if is_word(f, q, "as") && jj.noas == 0 {
            if minp > 1 { break; }
            var e = skip_ws(f, q + 2);
            if byte_at(f, e) != 36 { return rej1("destructuring patterns after `as`", e); }
            let ns = e + 1;
            e = ns;
            while is_name_char(byte_at(f, e)) { e += 1; }
            if e == ns { return syn1("a variable name is needed after `$`", ns); }
            if jj.f.nvars >= 60 { jj.err = "jx: too many variables in the filter"; return -1; }
            let slot = jj.f.nvars;
            jj.f.nvars += 1;
            let lo = len(jj.f.keys);
            jj.f.keys += substr(f, ns, e - ns);
            let q2 = skip_ws(f, e);
            if byte_at(f, q2) != 124 { return syn1("expected `|` after the variable", q2); }
            jj.cp = q2 + 1;
            let save = jj.f.nvar;
            jj.f.vname_off[jj.f.nvar] = lo;
            jj.f.vname_len[jj.f.nvar] = e - ns;
            jj.f.vslot[jj.f.nvar] = slot;
            jj.f.nvar += 1;
            let body = parse_expr(f, 1);
            jj.f.nvar = save;
            if body < 0 { return -1; }
            return mk(K.AS, lhs, body, slot, q);
        }
        let o = peek_op(f, q);
        if o == 0 { break; }
        if o < 0 { reject("assignment or update operators", q); return -1; }
        let prec = o % 64;
        let kind = o / 64;
        if prec < minp { break; }
        if prec == 7 {
            if last_cmp { syntax("comparisons do not chain", q); return -1; }
            last_cmp = true;
        } else { last_cmp = false; }
        var oplen = 1;
        if kind == 3 || kind == 5 || kind == 11 || kind == 12 || kind == 14 || kind == 16 { oplen = 2; }
        if kind == 6 { oplen = 3; }
        jj.cp = q + oplen;
        var rhs = -1;
        if prec == 1 || prec == 3 { rhs = parse_expr(f, prec); } else { rhs = parse_expr(f, prec + 1); }
        if rhs < 0 { return -1; }
        if kind == 1 { lhs = mk_pipe(lhs, rhs, q); }
        else if kind == 2 { lhs = mk(K.COMMA, lhs, rhs, 0, q); }
        else if kind == 3 { lhs = mk(K.ALT, lhs, rhs, 0, q); }
        else if kind == 5 { lhs = mk(K.OR, lhs, rhs, 0, q); }
        else if kind == 6 { lhs = mk(K.AND, lhs, rhs, 0, q); }
        else { lhs = mk(K.BIN, lhs, rhs, kind, q); }
        if lhs < 0 { return -1; }
    }
    return lhs;
}

// ---- analysis ----

fn j_lim3(e: i64) -> bool {
    return jj.f.ac[e] == 3;
}

// 0 exactly one output, 1 at most one, 2 any number
fn cls(e: i64) -> i64 {
    let k = jj.f.ak[e];
    if k == K.ITER || k == K.COMMA { return 2; }
    if k == K.PLAY { return 2; }
    if k == K.EMPTY || k == K.SELECT { return 1; }
    if k == K.TRY || k == K.RANGE { return 2; }
    if k == K.LIMIT { if j_lim3(e) { return 0; } return 2; }
    if k == K.AS {
        let a = cls(jj.f.aa[e]);
        let b = cls(jj.f.ab[e]);
        if a == 2 || b == 2 { return 2; }
        if a == 1 || b == 1 { return 1; }
        return 0;
    }
    if k == K.FIELD || k == K.IDX || k == K.SLICE { return cls(jj.f.aa[e]); }
    if k == K.PIPE {
        let a = cls(jj.f.aa[e]);
        let b = cls(jj.f.ab[e]);
        if a == 2 || b == 2 { return 2; }
        if a == 1 || b == 1 { return 1; }
        return 0;
    }
    if k == K.ALT {
        if cls(jj.f.aa[e]) != 0 { return 2; }
        return cls(jj.f.ab[e]);
    }
    if k == K.IF {
        if cls(jj.f.aa[e]) != 0 { return 2; }
        var m = cls(jj.f.ab[e]);
        let m2 = cls(jj.f.ac[e]);
        if m2 > m { m = m2; }
        return m;
    }
    if k == K.NEG { return cls(jj.f.aa[e]); }
    if k == K.BIN || k == K.AND || k == K.OR { if cls(jj.f.aa[e]) != 0 || cls(jj.f.ab[e]) != 0 { return 2; } return 0; }
    if k == K.OBJ {
        var i = 0;
        while i < jj.f.ab[e] {
            if cls(jj.f.okey[jj.f.aa[e] + i]) != 0 || cls(jj.f.oval[jj.f.aa[e] + i]) != 0 { return 2; }
            i += 1;
        }
        return 0;
    }
    return 0;
}

fn is_path(e: i64) -> bool {
    let k = jj.f.ak[e];
    if k == K.ID { return true; }
    if k == K.FIELD || k == K.IDX { return is_path(jj.f.aa[e]); }
    return false;
}

// a variable slot made while analyzing (for the rewrites that bind generator outputs)
fn new_slot() -> i64 {
    if jj.f.nvars >= 60 { jj.err = "jx: too many variables in the filter"; return -1; }
    let s = jj.f.nvars;
    jj.f.nvars += 1;
    return s;
}

fn want_node(n: i64) {
    if n >= 0 { jj.f.want[n] = 1; }
}

// the node a pure path reaches from `ctx`, creating the nodes; -1 when ctx is unknown; -2 on error
fn an_nav(e: i64, ctx: i64) -> i64 {
    let k = jj.f.ak[e];
    if k == K.ID { return ctx; }
    let n = an_nav(jj.f.aa[e], ctx);
    if n < 0 { return n; }
    if k == K.FIELD { let c = child_key(n, jj.f.ab[e], jj.f.ac[e]); if c < 0 { return -2; } return c; }
    let c = child_idx(n, jj.f.ab[e]);
    if c < 0 { return -2; }
    return c;
}

// a step (.k, [n], []) on a generator: g | step. Rewrites node e in place; true when it did
fn norm_step(e: i64) -> bool {
    let k = jj.f.ak[e];
    if k != K.FIELD && k != K.IDX && k != K.ITER && k != K.SLICE { return false; }
    if cls(jj.f.aa[e]) == 0 { return false; }
    let st = mk(k, mk(K.ID, 0, 0, 0, jj.f.at[e]), jj.f.ab[e], jj.f.ac[e], jj.f.at[e]);
    if st < 0 { return false; }
    jj.f.ak[e] = K.PIPE;
    jj.f.ab[e] = st;
    return true;
}

fn copy_node(dst: i64, src: i64) {
    jj.f.ak[dst] = jj.f.ak[src];
    jj.f.aa[dst] = jj.f.aa[src];
    jj.f.ab[dst] = jj.f.ab[src];
    jj.f.ac[dst] = jj.f.ac[src];
    jj.f.ad[dst] = jj.f.ad[src];
    jj.f.at[dst] = jj.f.at[src];
}

// a generator (ITER or any iteration of a node with a known path) that can stream: the node whose elements it visits, else -1
fn stream_src(it: i64, ctx: i64) -> i64 {
    if jj.f.ak[it] != K.ITER { return -1; }
    let s = jj.f.aa[it];
    if !is_path(s) { return -1; }
    if ctx < 0 { return -1; }
    return an_nav(s, ctx);
}

fn new_reg(kind: i64) -> i64 {
    if jj.f.nreg >= 63 { jj.err = "jx: the filter is too big (64 registers)"; return -1; }
    let r = jj.f.nreg;
    jj.f.nreg = r + 1;
    jj.f.r_kind[r] = kind;
    jj.f.r_depth[r] = jj.an_depth;
    jj.f.r_own[r] = jj.an_unit;
    return r;
}

// a scope: the iteration `it` of a path from ctx, the body that follows (-1: the elements themselves).
// term: 1 print, 2 register (a list), 3 add fold, 4 count fold. root is the tree node that becomes the playback
fn an_scope(root: i64, it: i64, ctx: i64, nxt: i64, body0: i64, term: i64) -> i64 {
    var p = an_nav(jj.f.aa[it], ctx);
    if p < 0 { return -2; }
    var iter = child_iter(p);
    if iter < 0 { return -2; }
    var body = body0;
    if jj.an_depth >= 3 { reject("iterations nested more than 3 deep", jj.f.at[root]); return -2; }
    if jj.f.nscope >= 31 { jj.err = "jx: the filter is too big (32 iterations)"; return -2; }
    let s = jj.f.nscope;
    jj.f.nscope = s + 1;
    jj.f.anyscope = true;
    jj.f.s_iter[s] = iter;
    jj.f.s_par[s] = p;
    jj.f.s_body[s] = body;
    jj.f.s_term[s] = term;
    jj.f.s_depth[s] = jj.an_depth + 1;
    jj.f.s_own[s] = jj.an_unit;
    jj.f.s_play[s] = root;
    jj.f.s_next[s] = jj.f.sc1[iter];
    jj.f.sc1[iter] = s;
    want_node(p);
    if term != 1 {
        var kind = 0;
        if term == 3 { kind = 3; }
        if term == 4 { kind = 4; }
        let r = new_reg(kind);
        if r < 0 { return -2; }
        jj.f.s_reg[s] = r;
    }
    let sd = jj.an_depth;
    let su = jj.an_unit;
    jj.an_depth = sd + 1;
    jj.an_unit = iter;
    if body >= 0 {
        if an(body, iter, -1, false) == -2 { return -2; }
    } else {
        want_node(iter);
    }
    jj.an_depth = sd;
    jj.an_unit = su;
    // the root of the scope pipeline plays the register back
    jj.f.ak[root] = K.PLAY;
    jj.f.aa[root] = s;
    jj.f.nx[root] = nxt;
    return -1;
}

// bit set of the variables used (jj.wv_used) and bound (jj.wv_bound) in the tree below e
fn walk_vars(e: i64) {
    if e < 0 { return; }
    let k = jj.f.ak[e];
    if k == K.VAR { jj.wv_used = jj.wv_used | (1 << jj.f.ac[e]); return; }
    if k == K.ID || k == K.LIT || k == K.NODE || k == K.EMPTY || k == K.CMPLIT || k == K.PLAY || k == K.VARBIND || k == K.RBIND { return; }
    if k == K.OBJ {
        var i = 0;
        while i < jj.f.ab[e] { walk_vars(jj.f.okey[jj.f.aa[e] + i]); walk_vars(jj.f.oval[jj.f.aa[e] + i]); i += 1; }
        return;
    }
    if k == K.AS { jj.wv_bound = jj.wv_bound | (1 << jj.f.ac[e]); }
    if k == K.IF { walk_vars(jj.f.aa[e]); walk_vars(jj.f.ab[e]); walk_vars(jj.f.ac[e]); return; }
    if k == K.RANGE { walk_vars(jj.f.aa[e]); walk_vars(jj.f.ab[e]); walk_vars(jj.f.ac[e]); return; }
    if k == K.FN || k == K.LIMIT { if k == K.FN && jj.f.aa[e] < 0 { return; } walk_vars(jj.f.aa[e]); if k == K.LIMIT { walk_vars(jj.f.ab[e]); } return; }
    if k == K.ARR || k == K.FOLD { walk_vars(jj.f.aa[e]); return; }
    if k == K.FIELD || k == K.IDX || k == K.ITER || k == K.NEG || k == K.SELECT || k == K.ERROR { walk_vars(jj.f.aa[e]); return; }
    walk_vars(jj.f.aa[e]);
    walk_vars(jj.f.ab[e]);
}

// does the tree use a variable that is bound outside it?
fn uses_outer_var(e: i64) -> bool {
    jj.wv_used = 0;
    jj.wv_bound = 0;
    walk_vars(e);
    return (jj.wv_used - (jj.wv_used & jj.wv_bound)) != 0;
}

fn is_gen_head(e: i64, ctx: i64) -> bool {
    if jj.f.ak[e] == K.PIPE {
        if uses_outer_var(jj.f.ab[e]) { return false; }
        return stream_src(jj.f.aa[e], ctx) >= 0;
    }
    return stream_src(e, ctx) >= 0;
}

// analyze e with the static context ctx (the automaton node its input is, -1 unknown); nxt is the node that takes its outputs
// (-1: the terminal of the enclosing scope body). Returns the context of the outputs: a node, -1 unknown, -2 on error.
fn an(e: i64, ctx: i64, nxt: i64, direct: bool) -> i64 {
    let k = jj.f.ak[e];
    jj.f.nx[e] = nxt;
    if k == K.ID { want_node(ctx); return ctx; }
    if k == K.NODE { return jj.f.aa[e]; }
    if k == K.LIT || k == K.EMPTY { return -1; }
    if k == K.FIELD || k == K.IDX {
        let src = jj.f.aa[e];
        if cls(src) != 0 {
            // a step after a generator: g | step
            let st = mk(k, mk(K.ID, 0, 0, 0, jj.f.at[e]), jj.f.ab[e], jj.f.ac[e], jj.f.at[e]);
            if st < 0 { return -2; }
            jj.f.ak[e] = K.PIPE;
            jj.f.ab[e] = st;
            return an(e, ctx, nxt, direct);
        }
        if is_path(src) {
            let n = an_nav(e, ctx);
            if n == -2 { return -2; }
            if n >= 0 {
                jj.f.ak[e] = K.NODE;
                jj.f.aa[e] = n;
                want_node(n);
                return n;
            }
            if an(src, ctx, -1, false) == -2 { return -2; }
            return -1;
        }
        let rc = an(src, ctx, -1, false);
        if rc == -2 { return -2; }
        if rc >= 0 {
            var c = -1;
            if k == K.FIELD { c = child_key(rc, jj.f.ab[e], jj.f.ac[e]); } else { c = child_idx(rc, jj.f.ab[e]); }
            if c < 0 { return -2; }
            want_node(c);
            return c;
        }
        return -1;
    }
    if k == K.ITER {
        let src = jj.f.aa[e];
        if cls(src) != 0 {
            let st = mk(K.ITER, mk(K.ID, 0, 0, 0, jj.f.at[e]), 0, 0, jj.f.at[e]);
            if st < 0 { return -2; }
            jj.f.ak[e] = K.PIPE;
            jj.f.ab[e] = st;
            return an(e, ctx, nxt, direct);
        }
        if stream_src(e, ctx) >= 0 {
            var term = 2;
            if direct && nxt < 0 { term = 1; }
            return an_scope(e, e, ctx, nxt, -1, term);
        }
        if an(src, ctx, -1, false) == -2 { return -2; }
        return -1;
    }
    if k == K.PIPE {
        let l = jj.f.aa[e];
        let r = jj.f.ab[e];
        if jj.f.ak[l] == K.ID {
            copy_node(e, r);
            return an(e, ctx, nxt, direct);
        }
        if norm_step(l) { return an(e, ctx, nxt, direct); }
        if jj.f.ak[l] == K.PIPE {
            // (a | b) | c is a | (b | c)
            let nr = mk_pipe(jj.f.ab[l], r, jj.f.at[e]);
            if nr < 0 { return -2; }
            jj.f.aa[e] = jj.f.aa[l];
            jj.f.ab[e] = nr;
            return an(e, ctx, nxt, direct);
        }
        // [..] | add and [..] | length fold while collecting
        if jj.f.ak[l] == K.ARR && jj.f.aa[l] >= 0 {
            var h = r;
            var rest = -1;
            if jj.f.ak[r] == K.PIPE { h = jj.f.aa[r]; rest = jj.f.ab[r]; }
            if jj.f.ak[h] == K.FN && (jj.f.ac[h] == F.ADD || jj.f.ac[h] == F.LENGTH) {
                var fk = 1;
                if jj.f.ac[h] == F.LENGTH { fk = 2; }
                jj.f.ak[l] = K.FOLD;
                jj.f.ac[l] = fk;
                if rest < 0 { copy_node(e, l); return an(e, ctx, nxt, direct); }
                jj.f.aa[e] = l;
                jj.f.ab[e] = rest;
                return an(e, ctx, nxt, direct);
            }
        }
        if jj.f.ak[l] == K.ITER && stream_src(l, ctx) >= 0 && uses_outer_var(r) {
            let rcx = an_scope(l, l, ctx, r, -1, 2);
            if rcx == -2 { return -2; }
            return an(r, -1, nxt, false);
        }
        if jj.f.ak[l] == K.ITER && stream_src(l, ctx) >= 0 {
            var term = 2;
            if direct && nxt < 0 { term = 1; }
            return an_scope(e, l, ctx, nxt, r, term);
        }
        let rc = an(l, ctx, r, false);
        if rc == -2 { return -2; }
        var d2 = false;
        let lk = jj.f.ak[l];
        if direct && (lk == K.NODE || lk == K.FIELD || lk == K.IDX) { d2 = true; }
        return an(r, rc, nxt, d2);
    }
    if k == K.COMMA {
        let a = an(jj.f.aa[e], ctx, nxt, direct);
        if a == -2 { return -2; }
        let b = an(jj.f.ab[e], ctx, nxt, false);
        if b == -2 { return -2; }
        return -1;
    }
    if k == K.ALT {
        if cls(jj.f.aa[e]) != 0 { jj.f.ad[e] = 1; }
        if an(jj.f.aa[e], ctx, -1, false) == -2 { return -2; }
        if an(jj.f.ab[e], ctx, nxt, false) == -2 { return -2; }
        return -1;
    }
    if k == K.BIN || k == K.AND || k == K.OR {
        var l = jj.f.aa[e];
        var r = jj.f.ab[e];
        if cls(l) != 0 || cls(r) != 0 {
            // generators in the operands: the right side is the outer loop (jq's order)
            let t1 = new_slot();
            let t2 = new_slot();
            if t1 < 0 || t2 < 0 { return -2; }
            let at = jj.f.at[e];
            var inner = -1;
            if k == K.BIN { inner = mk(K.BIN, mk(K.VAR, 0, 0, t2, at), mk(K.VAR, 0, 0, t1, at), jj.f.ac[e], at); }
            else {
                // and / or: the left decides, the right is only looked at when needed
                let tb = mk(K.IF, r, mk(K.LIT, jj.ev.htrue, 0, 0, at), mk(K.LIT, jj.ev.hfalse, 0, 0, at), at);
                if k == K.AND { inner = mk(K.IF, mk(K.VAR, 0, 0, t2, at), tb, mk(K.LIT, jj.ev.hfalse, 0, 0, at), at); }
                else { inner = mk(K.IF, mk(K.VAR, 0, 0, t2, at), mk(K.LIT, jj.ev.htrue, 0, 0, at), tb, at); }
            }
            if inner < 0 { return -2; }
            if k == K.BIN {
                let body = mk(K.AS, l, inner, t2, at);
                let outer = mk(K.AS, r, body, t1, at);
                if body < 0 || outer < 0 { return -2; }
                copy_node(e, outer);
            } else {
                let outer = mk(K.AS, l, inner, t2, at);
                if outer < 0 { return -2; }
                copy_node(e, outer);
            }
            return an(e, ctx, nxt, direct);
        }
        if an(l, ctx, -1, false) == -2 { return -2; }
        if an(r, ctx, -1, false) == -2 { return -2; }
        l = jj.f.aa[e];
        r = jj.f.ab[e];
        if k == K.BIN && jj.f.ac[e] >= 11 && jj.f.ac[e] <= 16 && jj.f.ak[l] == K.NODE && jj.f.ak[r] == K.LIT {
            let nd = jj.f.aa[l];
            let lh = jj.f.aa[r];
            jj.f.ak[e] = K.CMPLIT;
            jj.f.aa[e] = nd;
            jj.f.ab[e] = lh;
        }
        return -1;
    }
    if k == K.NEG {
        if cls(jj.f.aa[e]) != 0 {
            let t = new_slot();
            if t < 0 { return -2; }
            let at = jj.f.at[e];
            let outer = mk(K.AS, jj.f.aa[e], mk(K.NEG, mk(K.VAR, 0, 0, t, at), 0, 0, at), t, at);
            if outer < 0 { return -2; }
            copy_node(e, outer);
            return an(e, ctx, nxt, direct);
        }
        if an(jj.f.aa[e], ctx, -1, false) == -2 { return -2; }
        return -1;
    }
    if k == K.IF {
        if cls(jj.f.aa[e]) != 0 {
            let t = new_slot();
            if t < 0 { return -2; }
            let at = jj.f.at[e];
            let inner = mk(K.IF, mk(K.VAR, 0, 0, t, at), jj.f.ab[e], jj.f.ac[e], at);
            let outer = mk(K.AS, jj.f.aa[e], inner, t, at);
            if inner < 0 || outer < 0 { return -2; }
            copy_node(e, outer);
            return an(e, ctx, nxt, direct);
        }
        if an(jj.f.aa[e], ctx, -1, false) == -2 { return -2; }
        let a = an(jj.f.ab[e], ctx, nxt, false);
        if a == -2 { return -2; }
        let b = an(jj.f.ac[e], ctx, nxt, false);
        if b == -2 { return -2; }
        if a == b { return a; }
        return -1;
    }
    if k == K.SELECT {
        if cls(jj.f.aa[e]) != 0 { return reject("a generator or `select` inside `select(...)`", jj.f.at[e]) - 3; }
        if an(jj.f.aa[e], ctx, -1, false) == -2 { return -2; }
        if nxt < 0 { want_node(ctx); }
        return ctx;
    }
    if k == K.ARR {
        let body = jj.f.aa[e];
        if body < 0 { return -1; }
        if is_gen_head(body, ctx) {
            // [ g | body ]: collected while streaming
            var bh = body;
            var rest = -1;
            if jj.f.ak[body] == K.PIPE { bh = jj.f.aa[body]; rest = jj.f.ab[body]; }
            let sid = jj.f.nscope;
            if an_scope(body, bh, ctx, -1, rest, 2) == -2 { return -2; }
            jj.f.ab[e] = sid;
            jj.f.ac[e] = -1;
            return -1;
        }
        let r = new_reg(0);
        if r < 0 { return -2; }
        jj.f.ac[e] = r;
        jj.f.ab[e] = -1;
        if an(body, ctx, -1, false) == -2 { return -2; }
        return -1;
    }
    if k == K.FOLD {
        let body = jj.f.aa[e];
        let term = 2 + jj.f.ac[e];
        if is_gen_head(body, ctx) {
            var bh = body;
            var rest = -1;
            if jj.f.ak[body] == K.PIPE { bh = jj.f.aa[body]; rest = jj.f.ab[body]; }
            let sid = jj.f.nscope;
            if an_scope(body, bh, ctx, -1, rest, term) == -2 { return -2; }
            jj.f.ab[e] = sid;
            return -1;
        }
        let r = new_reg(2 + jj.f.ac[e]);
        if r < 0 { return -2; }
        jj.f.ad[e] = r;
        jj.f.ab[e] = -1;
        if an(body, ctx, -1, false) == -2 { return -2; }
        return -1;
    }
    if k == K.VAR { return jj.f.vctx[jj.f.ac[e]]; }
    if k == K.AS {
        let slot = jj.f.ac[e];
        let vb = mk(K.VARBIND, -1, jj.f.ab[e], slot, jj.f.at[e]);
        if vb < 0 { return -2; }
        jj.f.ad[e] = vb;
        let rc = an(jj.f.aa[e], ctx, vb, false);
        if rc == -2 { return -2; }
        jj.f.vctx[slot] = rc;
        return an(jj.f.ab[e], ctx, nxt, direct);
    }
    if k == K.REDUCE {
        let slot = jj.f.ac[e];
        let r = new_reg(0);
        if r < 0 { return -2; }
        let rb = mk(K.RBIND, -1, jj.f.ab[e], slot, jj.f.at[e]);
        if rb < 0 { return -2; }
        jj.f.ad[rb] = r;
        jj.f.ae[e] = rb;
        if cls(jj.f.ad[e]) != 0 { return reject("a generator as the initial value of reduce", jj.f.at[e]) - 3; }
        if an(jj.f.ad[e], ctx, -1, false) == -2 { return -2; }
        let rc = an(jj.f.aa[e], ctx, rb, false);
        if rc == -2 { return -2; }
        jj.f.vctx[slot] = rc;
        if an(jj.f.ab[e], -1, -1, false) == -2 { return -2; }
        jj.f.ac[rb] = slot;
        jj.f.ae[rb] = r;
        return -1;
    }
    if k == K.TRY {
        if an(jj.f.aa[e], ctx, -1, false) == -2 { return -2; }
        if jj.f.ab[e] >= 0 { if an(jj.f.ab[e], -1, nxt, false) == -2 { return -2; } }
        return -1;
    }
    if k == K.ERROR {
        if cls(jj.f.aa[e]) != 0 { return reject("a generator inside `error(...)`", jj.f.at[e]) - 3; }
        if an(jj.f.aa[e], ctx, -1, false) == -2 { return -2; }
        return -1;
    }
    if k == K.RANGE && (cls(jj.f.aa[e]) != 0 || cls(jj.f.ab[e]) != 0 || cls(jj.f.ac[e]) != 0) {
        // generators as bounds: the first bound is the outermost loop
        let at = jj.f.at[e];
        var vs0 = jj.f.aa[e];
        var vs1 = jj.f.ab[e];
        var vs2 = jj.f.ac[e];
        let s0 = new_slot();
        let s1 = new_slot();
        let s2 = new_slot();
        if s0 < 0 || s1 < 0 || s2 < 0 { return -2; }
        let inner = mk(K.RANGE, mk(K.VAR, 0, 0, s0, at), mk(K.VAR, 0, 0, s1, at), mk(K.VAR, 0, 0, s2, at), at);
        if inner < 0 { return -2; }
        let o2 = mk(K.AS, vs2, inner, s2, at);
        let o1 = mk(K.AS, vs1, o2, s1, at);
        let o0 = mk(K.AS, vs0, o1, s0, at);
        if o0 < 0 { return -2; }
        copy_node(e, o0);
        return an(e, ctx, nxt, direct);
    }
    if k == K.SLICE {
        if an(jj.f.aa[e], ctx, -1, false) == -2 { return -2; }
        if jj.f.ab[e] >= 0 { if cls(jj.f.ab[e]) != 0 { return reject("a generator as a slice bound", jj.f.at[e]) - 3; } if an(jj.f.ab[e], ctx, -1, false) == -2 { return -2; } }
        if jj.f.ac[e] >= 0 { if cls(jj.f.ac[e]) != 0 { return reject("a generator as a slice bound", jj.f.at[e]) - 3; } if an(jj.f.ac[e], ctx, -1, false) == -2 { return -2; } }
        return -1;
    }
    if k == K.RANGE {
        var i = 0;
        while i < 3 {
            var x = jj.f.aa[e];
            if i == 1 { x = jj.f.ab[e]; }
            if i == 2 { x = jj.f.ac[e]; }
            if cls(x) != 0 { return reject("a generator as an argument of `range`", jj.f.at[e]) - 3; }
            if an(x, ctx, -1, false) == -2 { return -2; }
            i += 1;
        }
        return -1;
    }
    if k == K.LIMIT {
        if jj.f.aa[e] >= 0 {
            if cls(jj.f.aa[e]) != 0 {
                let r = new_reg(0);
                if r < 0 { return -2; }
                jj.f.ae[e] = r;
            }
            if an(jj.f.aa[e], ctx, -1, false) == -2 { return -2; }
        }
        if an(jj.f.ab[e], ctx, -1, false) == -2 { return -2; }
        return -1;
    }
    if k == K.UNTIL {
        if cls(jj.f.aa[e]) != 0 || cls(jj.f.ab[e]) != 0 { return reject("a generator inside `until`", jj.f.at[e]) - 3; }
        if an(jj.f.aa[e], -1, -1, false) == -2 { return -2; }
        if an(jj.f.ab[e], -1, -1, false) == -2 { return -2; }
        return -1;
    }
    if k == K.OBJ {
        var i = 0;
        while i < jj.f.ab[e] {
            let o = jj.f.aa[e] + i;
            let ke = jj.f.okey[o];
            let ve = jj.f.oval[o];
            if cls(ke) != 0 || cls(ve) != 0 {
                // generators among the entries: one object for each combination, the last entry is the outer loop
                var body = mk(K.OBJ, jj.f.aa[e], jj.f.ab[e], 0, jj.f.at[e]);
                if body < 0 { return -2; }
                var m = 0;
                while m < jj.f.ab[e] {
                    let o2 = jj.f.aa[e] + m;
                    let at = jj.f.at[e];
                    if cls(jj.f.oval[o2]) != 0 {
                        let t = new_slot();
                        if t < 0 { return -2; }
                        let src = jj.f.oval[o2];
                        jj.f.oval[o2] = mk(K.VAR, 0, 0, t, at);
                        body = mk(K.AS, src, body, t, at);
                    }
                    if cls(jj.f.okey[o2]) != 0 {
                        let t = new_slot();
                        if t < 0 { return -2; }
                        let src = jj.f.okey[o2];
                        jj.f.okey[o2] = mk(K.VAR, 0, 0, t, at);
                        body = mk(K.AS, src, body, t, at);
                    }
                    if body < 0 { return -2; }
                    m += 1;
                }
                copy_node(e, body);
                return an(e, ctx, nxt, direct);
            }
            if an(ke, ctx, -1, false) == -2 { return -2; }
            if an(ve, ctx, -1, false) == -2 { return -2; }
            i += 1;
        }
        return -1;
    }
    if k == K.FN {
        let id = jj.f.ac[e];
        if id == F.ADD && ctx >= 0 {
            // add over the elements of a node: a fold that streams
            let it = mk(K.ITER, mk(K.ID, 0, 0, 0, jj.f.at[e]), 0, 0, jj.f.at[e]);
            if it < 0 { return -2; }
            jj.f.ak[e] = K.FOLD;
            jj.f.aa[e] = it;
            jj.f.ac[e] = 1;
            return an(e, ctx, nxt, direct);
        }
        want_node(ctx);
        if id == F.KEYS && ctx >= 0 { jj.f.wantkeys[ctx] = 1; }
        if id == F.HAS {
            let a = jj.f.aa[e];
            if cls(a) != 0 { return reject("a generator inside `has(...)`", jj.f.at[e]) - 3; }
            if ctx >= 0 {
                if jj.f.ak[a] != K.LIT { return reject("`has` with a computed argument on a value of the document (a constant is needed)", jj.f.at[e]) - 3; }
                let h = jj.f.aa[a];
                if jj.v.vt[h] == 5 {
                    // the key's node must exist so that its presence is recorded
                    var ko = len(jj.f.keys);
                    jj.f.keys += substr(jj.f.lits, jj.v.va[h], jj.v.vb[h]);
                    let c = child_key(ctx, ko, jj.v.vb[h]);
                    if c < 0 { return -2; }
                    want_node(c);
                }
            }
            if an(a, ctx, -1, false) == -2 { return -2; }
        }
        return -1;
    }
    return -2;
}

// ---- the whole filter ----

fn compile(f: text) -> i64 {
    jj.f.nn = 1;
    jj.f.par[0] = -1;
    jj.f.niter[0] = -1;
    jj.f.sc1[0] = -1;
    jj.f.owner[0] = -1;
    jj.f.nast = 0;
    jj.cdepth = 0;
    jj.cp = skip_ws(f, 0);
    if jj.cp >= len(f) { return reject("an empty filter", 0); }
    let root = parse_expr(f, 1);
    if root < 0 { return 1; }
    let q = skip_ws(f, jj.cp);
    if byte_at(f, q) >= 0 { return syntax("unexpected `" + substr(f, q, 1) + "`", q); }
    // the expression tree must not nest deeper than the evaluator's recursion allows
    jj.f.root = root;
    jj.an_depth = 0;
    jj.an_unit = -1;
    if an(root, 0, -1, true) == -2 { if len(jj.err) == 0 { jj.err = "jx: internal error in the filter analysis"; } return 1; }
    // owners: the nearest unit at or above each node; count the document level slots
    var n = 1;
    while n < jj.f.nn {
        let p = jj.f.par[n];
        if jj.f.sc1[n] >= 0 { jj.f.owner[n] = n; } else { jj.f.owner[n] = jj.f.owner[p]; }
        n += 1;
    }
    var w = 0;
    var cnt = 0;
    while w < jj.f.nn {
        if jj.f.want[w] != 0 && jj.f.owner[w] < 0 { cnt += 1; }
        w += 1;
    }
    jj.f.nwant = cnt;
    w = 0;
    while w < jj.f.nn {
        if jj.f.niter[w] >= 0 && (jj.f.nkeys[w] != 0 || jj.f.nidx[w] != 0) {
            return reject("`[]` together with a key or an index on the same value", 0);
        }
        w += 1;
    }
    // stream: a unit lies at or below the node
    var u = 0;
    while u < jj.f.nn {
        if jj.f.sc1[u] >= 0 {
            var a = u;
            while a >= 0 { jj.f.stream[a] = 1; a = jj.f.par[a]; }
        }
        u += 1;
    }
    return 0;
}
