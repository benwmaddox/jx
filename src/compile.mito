// The filter compiler: reads the filter text once and builds (a) a trie of the wanted paths (the path automaton: a node is
// a value reached by a path, with child entries by key, by index and by `[]`), and (b) the slot program.
// Stage 1 grammar:   filter := term ( "|" term )*
//   term := path | select( path [op literal] ) | length
//   path := ( "." ident | ".\"key\"" | "." ) ( "[" integer "]" | "[]" | "[\"key\"]" )*  ( "." step )*
// Everything else is rejected here, before any input is read.

fn reject(what: text, p: i64) -> i64 {
    j.err = "jx: not supported in Stage 1: " + what + " (filter position " + str(p) + ")";
    return 1;
}

fn is_name_start(c: i64) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95;
}

fn is_name_char(c: i64) -> bool {
    return is_name_start(c) || is_digit(c);
}

fn new_node(parent: i64) -> i64 {
    let n = j.f.nn;
    j.f.nn = n + 1;
    j.f.par[n] = parent;
    j.f.niter[n] = -1;
    return n;
}

fn new_entry(parent: i64, kind: i64) -> i64 {
    j.f.ne += 1;
    let e = j.f.ne;
    j.f.ekind[e] = kind;
    j.f.enext[e] = j.f.nfirst[parent];
    j.f.nfirst[parent] = e;
    return e;
}

// the node for key keys[ko, ko+kl) below `node`, made if missing; -1 when the automaton is full
fn child_key(node: i64, ko: i64, kl: i64) -> i64 {
    var e = j.f.nfirst[node];
    while e != 0 {
        if j.f.ekind[e] == 0 && j.f.eb[e] == kl && substr(j.f.keys, j.f.ea[e], kl) == substr(j.f.keys, ko, kl) { return j.f.enode[e]; }
        e = j.f.enext[e];
    }
    if j.f.nn >= 64 || j.f.ne >= 62 { j.err = "jx: the filter is too big for the automaton (64 nodes, 62 edges)"; return -1; }
    let n = new_node(node);
    e = new_entry(node, 0);
    j.f.ea[e] = ko;
    j.f.eb[e] = kl;
    j.f.ef[e] = byte_at(j.f.keys, ko);
    j.f.enode[e] = n;
    j.f.nkeys[node] += 1;
    return n;
}

fn child_idx(node: i64, k: i64) -> i64 {
    var e = j.f.nfirst[node];
    while e != 0 {
        if j.f.ekind[e] == 1 && j.f.ea[e] == k { return j.f.enode[e]; }
        e = j.f.enext[e];
    }
    if j.f.nn >= 64 || j.f.ne >= 62 { j.err = "jx: the filter is too big for the automaton (64 nodes, 62 edges)"; return -1; }
    let n = new_node(node);
    e = new_entry(node, 1);
    j.f.ea[e] = k;
    j.f.enode[e] = n;
    j.f.nidx[node] += 1;
    return n;
}

fn child_iter(node: i64) -> i64 {
    if j.f.niter[node] >= 0 { return j.f.niter[node]; }
    if j.f.nn >= 64 { j.err = "jx: the filter is too big for the automaton (64 nodes)"; return -1; }
    let n = new_node(node);
    j.f.niter[node] = n;
    return n;
}

// the string literal at q (its quote) of the filter, unescaped onto `keys` (to_keys) or `lits`; the position after it, or -1
fn filter_string(f: text, q: i64, to_keys: bool) -> i64 {
    var i = q + 1;
    var rs = i;
    while true {
        let c = byte_at(f, i);
        if c < 0 { j.err = "jx: a string in the filter does not end"; return -1; }
        if c == 34 { break; }
        if c != 92 { i += 1; continue; }
        if byte_at(f, i + 1) == 40 { reject("string interpolation", i); return -1; }
        let d = byte_at(f, i + 1);
        if !(d == 34 || d == 92 || d == 47 || d == 98 || d == 102 || d == 110 || d == 114 || d == 116 || d == 117) {
            j.err = "jx: invalid escape in a string of the filter";
            return -1;
        }
        if i > rs { if to_keys { j.f.keys += substr(f, rs, i - rs); } else { j.f.lits += substr(f, rs, i - rs); } }
        let cp = escape_cp(f, i);
        if cp == 0 { if to_keys { j.f.keys += "\0"; } else { j.f.lits += "\0"; } }
        else if to_keys { j.f.keys += chr(cp); } else { j.f.lits += chr(cp); }
        i += j.sc.esc;
        rs = i;
    }
    if i > rs { if to_keys { j.f.keys += substr(f, rs, i - rs); } else { j.f.lits += substr(f, rs, i - rs); } }
    return i + 1;
}

// one step below `node` for a key written at q (after the dot, or inside brackets); the new node or -1, the cursor after it in j.cp
fn key_step(f: text, node: i64, q: i64) -> i64 {
    let ko = len(j.f.keys);
    var e = 0;
    if byte_at(f, q) == 34 {
        e = filter_string(f, q, true);
        if e < 0 { return -1; }
    } else {
        e = q;
        while is_name_char(byte_at(f, e)) { e += 1; }
        j.f.keys += substr(f, q, e - q);
    }
    j.cp = e;
    return child_key(node, ko, len(j.f.keys) - ko);
}

// a path starting at the dot at j.cp, below `node`; the node reached, or -1 (j.err set); the cursor after it in j.cp.
// iter_ok: `[]` is allowed; j.f_iter is set to 1 when one was taken
fn parse_path(f: text, node0: i64, iter_ok: bool) -> i64 {
    var node = node0;
    var q = j.cp;
    var first = true;
    while true {
        // at a dot
        q += 1;
        let c = byte_at(f, q);
        if c == 46 { reject("`..`", q); return -1; }
        if is_name_start(c) || c == 34 {
            node = key_step(f, node, q);
            if node < 0 { return -1; }
            q = j.cp;
        } else if c == 91 {
            // brackets follow
        } else if is_digit(c) {
            j.err = "jx: syntax error: a field name cannot start with a digit";
            return -1;
        } else {
            // a bare dot
            if !first { j.err = "jx: syntax error: a dot with no field after it"; return -1; }
        }
        first = false;
        while byte_at(f, q) == 91 {
            q = skip_ws(f, q + 1);
            let d = byte_at(f, q);
            if d == 93 {
                if !iter_ok { reject("`[]` inside select(...) (a generator in a condition)", q); return -1; }
                node = child_iter(node);
                if node < 0 { return -1; }
                j.f_iter = 1;
                q += 1;
            } else if is_digit(d) {
                var n = 0;
                while is_digit(byte_at(f, q)) {
                    if n > 100000000000 { reject("an index this large", q); return -1; }
                    n = n * 10 + byte_at(f, q) - 48;
                    q += 1;
                }
                q = skip_ws(f, q);
                if byte_at(f, q) == 58 { reject("a slice", q); return -1; }
                if byte_at(f, q) != 93 { j.err = "jx: syntax error: expected ] after the index"; return -1; }
                q += 1;
                node = child_idx(node, n);
                if node < 0 { return -1; }
            } else if d == 34 {
                node = key_step(f, node, q);
                if node < 0 { return -1; }
                q = skip_ws(f, j.cp);
                if byte_at(f, q) != 93 { j.err = "jx: syntax error: expected ] after the key"; return -1; }
                q += 1;
            } else if d == 45 {
                reject("a negative index (it needs the array's length)", q);
                return -1;
            } else if d == 58 {
                reject("a slice", q);
                return -1;
            } else {
                reject("an expression inside [...]", q);
                return -1;
            }
        }
        if byte_at(f, q) == 63 { reject("the `?` operator", q); return -1; }
        if byte_at(f, q) == 46 {
            let n1 = byte_at(f, q + 1);
            if is_name_start(n1) || n1 == 34 || n1 == 91 { continue; }
        }
        break;
    }
    j.cp = q;
    return node;
}

fn add_instr(op: i64, slot: i64, arg: i64) -> i64 {
    if j.f.npr >= 64 { j.err = "jx: the filter is too big"; return 1; }
    j.f.pop[j.f.npr] = op;
    j.f.pslot[j.f.npr] = slot;
    j.f.parg[j.f.npr] = arg;
    j.f.npr += 1;
    return 0;
}

// the condition of select( at j.cp (after the paren): a path, then `)` or an operator and a literal, then `)`
fn parse_select(f: text, node: i64) -> i64 {
    var q = skip_ws(f, j.cp);
    if byte_at(f, q) != 46 { return reject("a condition that does not start with a path", q); }
    j.cp = q;
    let cn = parse_path(f, node, false);
    if cn < 0 { return 1; }
    j.f.want[cn] = 1;
    q = skip_ws(f, j.cp);
    var c = byte_at(f, q);
    var op = 0;
    if c == 41 {
        j.cp = q + 1;
        return add_instr(1, cn, 7);
    }
    let c2 = byte_at(f, q + 1);
    if c == 61 && c2 == 61 { op = 1; q += 2; }
    else if c == 33 && c2 == 61 { op = 2; q += 2; }
    else if c == 60 && c2 == 61 { op = 4; q += 2; }
    else if c == 62 && c2 == 61 { op = 6; q += 2; }
    else if c == 60 { op = 3; q += 1; }
    else if c == 62 { op = 5; q += 1; }
    else { return reject("a condition other than `path`, or `path` compared with a literal", q); }
    q = skip_ws(f, q);
    if j.f.nlit >= 32 { j.err = "jx: too many literals"; return 1; }
    let l = j.f.nlit;
    j.f.nlit += 1;
    c = byte_at(f, q);
    if c == 34 {
        j.f.lkind[l] = 5;
        j.f.la[l] = len(j.f.lits);
        let e = filter_string(f, q, false);
        if e < 0 { return 1; }
        j.f.lb[l] = len(j.f.lits) - j.f.la[l];
        q = e;
    } else if c == 45 || is_digit(c) {
        let e = scan_number(f, q);
        if e < 0 { j.err = "jx: syntax error: invalid number in the filter"; return 1; }
        j.f.lkind[l] = 4;
        j.f.la[l] = q;
        j.f.lb[l] = e;
        q = e;
    } else if c == 116 && substr(f, q, 4) == "true" && !is_name_char(byte_at(f, q + 4)) {
        j.f.lkind[l] = 3;
        q += 4;
    } else if c == 102 && substr(f, q, 5) == "false" && !is_name_char(byte_at(f, q + 5)) {
        j.f.lkind[l] = 2;
        q += 5;
    } else if c == 110 && substr(f, q, 4) == "null" && !is_name_char(byte_at(f, q + 4)) {
        j.f.lkind[l] = 1;
        q += 4;
    } else {
        return reject("comparing with anything but a literal (a number, string, true, false or null)", q);
    }
    q = skip_ws(f, q);
    if byte_at(f, q) != 41 { return reject("anything but one comparison inside select(...)", q); }
    j.cp = q + 1;
    return add_instr(1, cn, l * 8 + op);
}

fn word_at(f: text, q: i64) -> text {
    var e = q;
    while is_name_char(byte_at(f, e)) { e += 1; }
    return substr(f, q, e - q);
}

// the filter: 0, or 1 with j.err set
fn compile(f: text) -> i64 {
    j.f.nn = 1;
    j.f.par[0] = -1;
    j.f.niter[0] = -1;
    j.f.nunit = -1;
    var cur = 0;
    var seen_select = false;
    var length_last = false;
    j.cp = skip_ws(f, 0);
    if j.cp >= len(f) { return reject("an empty filter", 0); }
    while true {
        let q = skip_ws(f, j.cp);
        let c = byte_at(f, q);
        if length_last { return reject("a step after `length` (it makes a new value)", q); }
        if c == 46 {
            j.cp = q;
            j.f_iter = 0;
            let nn = parse_path(f, cur, true);
            if nn < 0 { return 1; }
            if j.f_iter != 0 && seen_select { return reject("`[]` after select (it needs buffering: Stage 3)", q); }
            cur = nn;
        } else if is_name_start(c) {
            let w = word_at(f, q);
            if w == "select" {
                var e = skip_ws(f, q + 6);
                if byte_at(f, e) != 40 { return reject("select without its parenthesis", e); }
                j.cp = e + 1;
                if parse_select(f, cur) != 0 { return 1; }
                seen_select = true;
            } else if w == "length" {
                j.cp = q + 6;
                length_last = true;
            } else {
                return reject("`" + w + "`", q);
            }
        } else {
            return reject("`" + substr(f, q, 1) + "`", q);
        }
        let q2 = skip_ws(f, j.cp);
        let d = byte_at(f, q2);
        if d < 0 { break; }
        if d != 124 { return reject("`" + substr(f, q2, 1) + "` (only `|` joins steps)", q2); }
        j.cp = q2 + 1;
    }
    j.f.want[cur] = 1;
    if length_last { if add_instr(3, cur, 0) != 0 { return 1; } }
    else { if add_instr(2, cur, 0) != 0 { return 1; } }
    var n = 0;
    var w = 0;
    while w < j.f.nn {
        if j.f.want[w] != 0 { n += 1; }
        if j.f.niter[w] >= 0 && (j.f.nkeys[w] != 0 || j.f.nidx[w] != 0) {
            return reject("`[]` together with a key or an index on the same value", 0);
        }
        w += 1;
    }
    j.f.nwant = n;
    // where a missing value would be iterated: children come after their parents, so go backwards
    var m = j.f.nn - 1;
    while m >= 0 {
        if j.f.niter[m] >= 0 { j.f.ib[m] = 1; }
        let pm = j.f.par[m];
        if pm >= 0 && j.f.niter[pm] != m && j.f.ib[m] != 0 { j.f.ib[pm] = 1; j.f.chk[pm] = 1; }
        m -= 1;
    }
    // the unit: the deepest `[]` on the path to the result
    var u = cur;
    while u > 0 {
        let p = j.f.par[u];
        if j.f.niter[p] == u {
            j.f.nunit = u;
            j.f.unit[u] = 1;
            var a = p;
            while a >= 0 { j.f.stream[a] = 1; a = j.f.par[a]; }
            break;
        }
        u = p;
    }
    return 0;
}
