// jx: a jq-compatible extractor that reads its input once, front to back (docs/design.md, Stage 2).
//   jx.mito      this file: the state and the entry point
//   util.mito    small helpers
//   num.mito     decimal text to double, double to jq's text
//   compile.mito the filter text -> an expression tree, a path automaton (a trie of wanted paths) and scopes
//   scan.mito    the scanner: one forward pass, validating, filling slots, running scope bodies at element ends
//   eval.mito    values in the arena and their helpers (arithmetic, comparison, constructors, builtins, registers)
//   code.mito    the bytecode program: opcodes, instruction arrays, the register file
//   lower.mito   the expression tree to bytecode (docs/bytecode-design.md)
//   exec.mito    the interpreter: runs a scope body or the end-of-document program
//   dis.mito     the disassembler (--dump-program)
//   out.mito     writing values the way jq does (compact or indented, numbers and strings normalized)
// Nothing is allocated at run time; every size is declared here.

platform cli;

const Lim {
    MAX_DEPTH: i64 = 10000;      // nesting depth of the input (jq's own limit)
    REG1: i64 = 1048576;         // value entries of an arena at nesting depth 1, 2, 3
    REG0: i64 = 16777216;        // value entries of the document level arena
}

// the filter, compiled
struct Filt {
    nn: i64;                      // nodes used; node 0 is the document
    ne: i64;                      // child entries used (entry ids start at 1; 0 means none)
    nwant: i64;                   // document level nodes whose value a slot holds (the scan may stop when all are filled)
    nscope: i64;
    nreg: i64;
    nobj: i64;
    root: i64;                    // the expression to run at the end of the document
    anyscope: bool;
    par: i64[256];                // per node: its parent, -1 for the root
    want: i64[256];               // 1 when a slot keeps the node's value
    wantkeys: i64[256];           // 1 when the keys of the object are collected
    owner: i64[256];              // the nearest unit node at or above this node, -1 for none
    sc1: i64[256];                // first scope run when this node's value ends, -1 none
    stream: i64[256];             // 1 when a unit is at or below the node
    nfirst: i64[256];             // first child entry of the node, 0 none
    niter: i64[256];              // the node reached by `[]`, -1 none
    nkeys: i64[256];              // children by key
    nidx: i64[256];               // children by index
    ekind: i64[256];              // 0 key, 1 index
    ea: i64[256];                 // key: offset in `keys`; index: the number
    eb: i64[256];                 // key: length
    ef: i64[256];                 // key: its first byte
    eord: i64[256];               // ordinal among the node's entries (for the bit set per object)
    enode: i64[256];
    enext: i64[256];
    keys: utf8<8192>;             // wanted keys, unescaped
    lits: utf8<4194304>;           // string literals, unescaped
    // the expression tree
    ak: i64[1024];                // kind
    aa: i64[1024];
    ab: i64[1024];
    ac: i64[1024];
    ad: i64[1024];
    nx: i64[1024];                // the continuation: the node that takes this node's outputs, -1 the terminal of the enclosing scope body
    at: i64[1024];                // position in the filter text, for errors
    nast: i64;
    ae: i64[1024];
    nvar: i64;                    // variables in scope while parsing, and all variables made
    nvars: i64;
    vname_off: i64[64];
    vname_len: i64[64];
    vslot: i64[64];
    vctx: i64[64];                // the automaton node a variable's value came from, -1 unknown
    // user functions (compile time only): defs and closure parameters are inlined at each call by parsing their text again
    ndef: i64;
    dn_off: i64[256];             // name: position in the filter text
    dn_len: i64[256];
    dnp: i64[256];                // number of parameters (a closure parameter has 0)
    dpar: i64[256];               // position of the parameter list text, -1 none
    dbody: i64[256];              // position of the body text (a closure parameter: of the argument text)
    dnv: i64[256];                // variables visible at the definition
    dkind: i64[256];              // 0 def, 1 closure parameter
    dsd: i64[256];                // closure parameter: defs, variables and hiding windows at the call site
    dsv: i64[256];
    dsw: i64[256];
    dsrc: i64[256];               // the text the definition is in: 0 the filter, 1 the prelude
    dasrc: i64[256];              // closure parameter: the text of its argument
    dan: i64[256];                // `$` parameter: the node of its argument
    curw: i64;                    // current hiding window, -1 none
    nw: i64;
    wdlo: i64[600];
    wdhi: i64[600];
    wvlo: i64[600];
    wvhi: i64[600];
    wprev: i64[600];
    xdepth: i64;
    // object constructors: key expression and value expression
    okey: i64[256];
    oval: i64[256];
    // scopes: a streamed iteration of a node, its body, where the body's results go
    s_iter: i64[32];              // the iteration node
    s_par: i64[32];               // the node iterated (its value tells whether the iteration is an error)
    s_body: i64[32];              // the first node of the body, -1 for the element itself
    s_term: i64[32];              // 1 print, 2 register, 3 add fold, 4 count fold
    s_reg: i64[32];
    s_depth: i64[32];             // nesting depth of the body (1 for a body run at the end of an element of the document)
    s_own: i64[32];               // the unit node whose element contains the playback, -1 the document
    s_next: i64[32];              // next scope on the same iteration node
    s_play: i64[32];              // the tree node that plays the register back
    // registers: lists being collected, folds
    r_kind: i64[64];              // 0 list, 3 add, 4 count
    r_depth: i64[64];             // the depth of the arena the results live in
    r_own: i64[64];               // the unit node whose element a register belongs to, -1 the document
}

// the scanner's stack and the slots
struct Scan {
    sp: i64;                      // open containers
    exit_depth: i64;              // when every slot is filled: the depth of the container to finish, then stop (0 none)
    nfilled: i64;
    esc: i64;                     // set by scan_string: 1 has a backslash or a DEL, 2 has a byte of 128 or more
    ival: i64;                    // set by scan_number: the value of an integer literal of at most 15 digits
    isint: bool;
    anyerr: bool;                 // a navigation error was recorded in this run
    validate: bool;
    dgen: i64;                    // the generation of the document-level slots and registers: one per value of the input stream
    perr: bool;                   // the error being reported is a parse error (fail_at): the input stops
    perr_at: i64;                 // where (a parse error at the end of a piece, with more input to come, is a value cut by the piece)
    rt: bool;                     // an error of the filter happened in this value (reported when the value is complete)
    dead: bool;                   // after it: the rest of the value is only checked, nothing runs
    selective: bool;              // --selective: a container the filter does not read is skipped by counting brackets, not checked (scan.mito, skip_container)
    fnode: i64[10002];            // per open container: its automaton node, -1 when skipped
    fkind: i64[10002];            // 6 array, 7 object
    fcnt: i64[10002];             // elements or keys so far
    fstart: i64[10002];           // where it starts
    fseen: i64[10002];            // bit per child entry already matched in this object
    fkh: i64[10002];              // collected keys: first entry
    fkt: i64[10002];              // collected keys: last entry
    ugen: i64[256];               // per unit node: the generation of its element's slots
    sgen: i64[256];               // per node (the slot)
    stag: i64[256];               // 4 number, 5 string, 6 array, 7 object, 1 null, 2 false, 3 true
    sa: i64[256];
    sb: i64[256];
    scnt: i64[256];
    sesc: i64[256];
    sint: i64[256];
    sisint: i64[256];
    skh: i64[256];                // collected keys of an object slot: first entry, -1 none
    skn: i64[256];
    serr: i64[256];               // the tag of a value that could not be navigated below this node (0 none)
    serrgi: i64[256];
    serrg: i64[256];
    serri: i64[256];              // the same for index children of a value that is not an array
}

struct Out {
    text: utf8<1073741824>;       // everything written (1 GiB; each GiB declared costs about 10 ms of start-up, see README)
    sep: bool;                    // a result was written already: a newline comes first
    pretty: bool;
    raw: bool;
    to: i64;                      // 0 write to `text`, 1 write to the scratch string (tostring)
    results: i64;
    ind: i64;                     // spaces per indent level (--indent), 2 by default
    tab: bool;                    // --tab
    nonl: bool;                   // -j: no newline after a result
    ascii: bool;                  // -a: non-ASCII characters written as escapes
    seq: bool;                    // --seq: a record separator (U+001E) before each result
    lastpos: i64;                 // where the last result starts in text (-e)
    open: bool;                   // a result is being written (an error now leaves it partial: res_cut takes it back)
    cut: i64;                     // where it starts, and the state before it
    cut_sep: bool;
    cut_res: i64;
    cut_last: i64;
}

// two numbers being compared, as decimals
struct Dec {
    neg: bool;
    zero: bool;
    ds: i64;                      // where the significant digits start (integer digits then fraction digits)
    ilen: i64;                    // integer digits from ds
    fs: i64;                      // where the fraction digits start
    k: i64;                       // index of the first significant digit
    nd: i64;                      // significant digit count (no leading or trailing zeros)
    adj: i64;                     // exponent of the leading digit plus one: value in [10^(adj-1), 10^adj)
}

// values: entries in the arena. Fields by kind:
//   vt tag 1 null, 2 false, 3 true, 4 number, 5 string, 6 array, 7 object
//   number:   vs 4 integer in va; 0 literal at [va, vb) of the document; 1 literal in the filter text; 3 double in vx; vf bit 1: negated, bit 2: absolute
//   string:   vs 0 document span with quotes at [va, vb), vf the escape flags; 1 plain bytes in the filter's literals; 2 in the scratch string; 3 in the persistent text; va offset, vb length
//   container: vs 0 a span of the document, vf the count, vd the automaton node; vs 1 built: va first entry, vb last entry, vf count (an object's entries are pairs: va key, vb value)
//   vn the next entry of a chain
struct Val {
    vt: u8[19930112];
    vs: u8[19930112];
    va: i64[19930112];
    vb: i64[19930112];
    vx: f64[19930112];
    vf: i32[19930112];
    vd: i32[19930112];
    vn: i32[19930112];
    base: i64[4];                 // first entry of the arena at depth 0, 1, 2, 3
    top: i64[4];
    cap: i64[4];                  // one past the last entry
    ncon: i64;
}

struct Ev {
    depth: i64;                   // arena depth the evaluator allocates in
    err: i64;                     // 0 none, 1 a jq error, 2 not supported (fatal)
    rh: i64[64];                  // registers: first entry, last entry, count
    rt: i64[64];
    rc: i64[64];
    rg: i64[64];                  // generation stamp
    rerr: i64[64];                // a deferred error of a register's scope body
    ax: f64[64];                  // fold: the sum so far
    at: i64[64];                  // fold: 0 nothing yet, 1 a value (handle in ah), 2 a double
    ah: i64[64];
    sa: i64[524288];              // collectors (sort, group, ...): the elements, their keys, the permutation and its merge buffer
    sk: i64[524288];
    sb: i64[524288];
    sc: i64[524288];
    scr: utf8<16777216>;          // scratch strings
    ptx: utf8<16777216>;         // strings that outlive the element
    tmp2: utf8<1048576>;
    tmp3: utf8<1048576>;
    stk: i64[4096];
    ms_kind: i64[260];            // materialize: the open containers
    ms_head: i64[260];
    ms_tail: i64[260];
    ms_cnt: i64[260];
    ms_key: i64[260];
    errv: i64;                    // the value of the last error (an entry), -1 none
    gpend: i64[2048];             // while unwinding: the tries whose continuation was left (a try skips an error that came from its own continuation)
    gpn: i64;
    stopto: i64;                  // the limit or first that wants the enumeration to stop
    rerrv: i64[64];               // a deferred error's value
    rec: i64;                     // recursion depth of the value functions
    hnull: i64;
    htrue: i64;
    hfalse: i64;
    htype: i64[8];                // the names of the types as constants
    harr0: i64;                   // an empty array
    fjv: i64;                     // fromjson: the string just parsed
    fjb: i64;                     // fromjson: where its text starts in the scratch string
    nanv: f64;
    emsg: utf8<300>;
    rawmsg: utf8<300>;
}

struct J {
    f: Filt;
    sc: Scan;
    o: Out;
    v: Val;
    ev: Ev;
    c: Code;
    m: Mach;
    num: Num;
    d1: Dec;
    d2: Dec;
    tmp: utf8<1048576>;           // an unescaped string for comparing
    err: utf8<300>;
    cp: i64;                      // the filter compiler's cursor
    an_depth: i64;                // compile: body nesting depth
    an_unit: i64;                 // compile: the unit node of the body being analyzed
    cdepth: i64;
    exitc: i64;                   // the exit code of the error being reported: 1 not supported or a limit, 2 usage, 3 syntax, 5 invalid input or a runtime error
    fs: i64;                      // the filter in the arguments
    fe: i64;
    argtxt: utf8<1048576>;        // the arguments (every one followed by a 0 byte), for --arg and the like at compile time
    nullin: bool;                 // -n: the input is null, standard input is not read
    estatus: bool;                // -e: the exit code follows the last output
    nnamed: i64;                  // --arg and --argjson: kind 0 string, 1 JSON; the name and the value as ranges of argtxt
    nm_kind: i64[32];
    nm_no: i64[32];
    nm_nl: i64[32];
    nm_vo: i64[32];
    nm_vl: i64[32];
    nm_slot: i64[34];
    nm_node: i64[34];
    npos: i64;                    // --args and --jsonargs: the positional values (kind 0 string, 1 JSON)
    ps_kind: i64[32];
    ps_o: i64[32];
    ps_l: i64[32];
    posmode: i64;                 // 0 files, 1 --args, 2 --jsonargs
    slurp: bool;                  // -s: the input document is wrapped in an array
    first: bool;                  // --first: the input is one value; stop as soon as the filter is done with it
    rterr: utf8<300>;             // the error of the filter in the current value
    vstatus: i64;                 // 5 when the last value ended with an error of the filter, else 0 (the exit code follows it, as jq's)
    uses_inl: bool;               // the filter reads input_line_number: worked out per value
    lfp: i64;                     // input_line_number per value: line feeds counted up to lfp (lfn of them, the last one ending at lfls)
    lfn: i64;
    lfls: i64;
    flushed: i64;                 // results already written to standard output
    lastnf: bool;                 // the last result written out was null or false (-e)
    more: bool;                   // standard input read in pieces: more input follows the text being scanned
    part: i64;                    // where the value cut by the end of a piece starts (scan returns 2)
    lfbase: i64;                  // line feeds in the pieces already done (input_line_number)
    carry: utf8<268435456>;       // the start of a value cut by the end of a piece, read again with the next piece (256 MiB at most)
    help: i64;                    // 1 --help or -h, 2 --version or -V: print and stop before anything is read
    fromfile: bool;               // -f: the first argument that is not an option names the file the filter is in
    rawin: bool;                  // -R: the input is text, not JSON
    nfile: i64;                   // input files named (one at most)
    file_o: i64;                  // the input file: a range of argtxt
    file_l: i64;
    bad: bool;                    // a file could not be read (the error is set)
    inl: i64;                     // what input_line_number gives
    envtxt: utf8<1048576>;        // the environment: NAME=value entries, each followed by a 0 byte
    explain: bool;                // --explain: print the automaton and the program in readable form and stop
    dump: bool;                   // --dump-program: print the bytecode and stop
    wv_used: i64;
    wv_bound: i64;
    noas: i64;                    // compile: 1 while the source of reduce is parsed (an `as` belongs to the reduce)
    cur_src: i64;                 // compile: which text is being parsed
    pre: utf8<16384>;             // compile: the prelude (builtins written in jq)
    ftxt: utf8<65536>;            // compile: a copy of the filter text
    pdepth: i64;                  // compile: nesting of parse_expr (Mitochondria allows 64 nested calls)
    pn: i64;                      // compile: arguments parsed by parse_args
    argp: i64[10];                // compile: start positions of the arguments of a user function call
    pbn: i64;                     // compile: bindings of patterns being parsed (a stack)
    pbslot: i64[64];
    pbnode: i64[64];
    pstk: i64[10];                // compile: the path of steps of the pattern leaf being parsed: 0 index, 1 key
    pstb: i64[10];
    pstc: i64[10];
    paren_node: i64;              // compile: the node the last parenthesized term returned
    lab_count: i64;               // compile: the labels seen so far (the number a break carries)
    nlab: i64;                    // compile: the labels in scope (a stack): name, variable slot, node
    lab_off: i64[16];
    lab_len: i64[16];
    lab_slot: i64[16];
    lab_node: i64[16];
    alt_s: i64[8];                // compile: `?//` alternatives: the variable names of each pattern (a range of the scope stack) and its bindings (a range of pbslot)
    alt_e: i64[8];
    alt_b: i64[8];
    alt_be: i64[8];
    pa: i64[4];
}
state jj: J;

// Options. The program does its own parsing: it takes `args` (every argument as written, each followed by a 0 byte), so every option
// wherever it appears, long, short or combined (`-cr`), reaches it and unknown ones are a hard error. Exit codes as jq's where jx
// has the same situation: 2 for a usage error (an unknown option, an option jx does not have yet, an input file), 3 for a syntax
// error in the filter, 5 for invalid input and for an error raised while the filter runs; 1 for a filter jx does not support yet
// and for the limits of jx (an arena that is full). The error text goes to standard error, nothing to standard output.

// is the argument at [s, e) of args equal to w?
fn arg_is(args: text, s: i64, e: i64, w: text) -> bool {
    if e - s != len(w) { return false; }
    return substr(args, s, e - s) == w;
}

// the usage error for the option at [s, e)
fn usage_error(args: text, s: i64, e: i64, supported_name: bool) -> i64 {
    jj.exitc = 2;
    if supported_name { jj.err = "jx: option '" + substr(args, s, e - s) + "' is not supported yet"; }
    else { jj.err = "jx: unknown option '" + substr(args, s, e - s) + "'"; }
    return 2;
}

// a jq long option that jx does not have yet
fn known_long(args: text, s: i64, e: i64) -> bool {
    if arg_is(args, s, e, "--stream") { return true; }
    if arg_is(args, s, e, "--stream-errors") { return true; }
    if arg_is(args, s, e, "--sort-keys") || arg_is(args, s, e, "--color-output") { return true; }
    if arg_is(args, s, e, "--raw-output0") { return true; }
    if arg_is(args, s, e, "--library-path") { return true; }
    if arg_is(args, s, e, "--binary") { return true; }
    if arg_is(args, s, e, "--build-configuration") || arg_is(args, s, e, "--strict") { return true; }
    return false;
}

// a short option letter of jq that jx does not have yet
fn known_short(c: i64) -> bool {
    return c == 83 || c == 67 || c == 76 || c == 98 || c == 48;
}

// the end of the argument that starts at s (its 0 byte), or n
fn arg_end(args: text, s: i64) -> i64 {
    var e = s;
    let n = len(args);
    while e < n && byte_at(args, e) != 0 { e += 1; }
    return e;
}

fn usage(msg: text) -> i64 {
    jj.exitc = 2;
    jj.err = "jx: " + msg;
    return 2;
}

fn is_number_arg(args: text, s: i64, e: i64) -> bool {
    if e == s { return false; }
    var i = s;
    while i < e {
        let c = byte_at(args, i);
        if c < 48 || c > 57 { return false; }
        i += 1;
    }
    return true;
}

// a long option that takes parameters: --indent n, --arg name value, --argjson name json; the position after them, or -1 with the error set (jj.err)
fn take_params(args: text, s: i64, e: i64) -> i64 {
    let n = len(args);
    if arg_is(args, s, e, "--indent") {
        if e + 1 >= n { usage("--indent takes one parameter"); return -1; }
        let e2 = arg_end(args, e + 1);
        if !is_number_arg(args, e + 1, e2) { usage("--indent takes a number"); return -1; }
        if e2 - e - 1 != 1 || byte_at(args, e + 1) > 55 { usage("Cannot indent more than 7 characters"); return -1; }
        jj.o.ind = byte_at(args, e + 1) - 48;
        jj.o.tab = false;
        jj.o.pretty = true;
        return e2 + 1;
    }
    // --arg and --argjson
    if e + 1 >= n { usage(substr(args, s, e - s) + " takes two parameters (e.g. " + substr(args, s, e - s) + " varname value)"); return -1; }
    let e2 = arg_end(args, e + 1);
    if e2 + 1 >= n { usage(substr(args, s, e - s) + " takes two parameters (e.g. " + substr(args, s, e - s) + " varname value)"); return -1; }
    let e3 = arg_end(args, e2 + 1);
    if jj.nnamed >= 32 { usage("too many --arg and --argjson options (32 at most)"); return -1; }
    let k = jj.nnamed;
    jj.nm_kind[k] = 0;
    if arg_is(args, s, e, "--argjson") { jj.nm_kind[k] = 1; }
    if arg_is(args, s, e, "--rawfile") { jj.nm_kind[k] = 2; }
    if arg_is(args, s, e, "--slurpfile") { jj.nm_kind[k] = 3; }
    jj.nm_no[k] = e + 1;
    jj.nm_nl[k] = e2 - e - 1;
    jj.nm_vo[k] = e2 + 1;
    jj.nm_vl[k] = e3 - e2 - 1;
    if jj.nm_kind[k] >= 2 {
        let path = substr(args, e2 + 1, e3 - e2 - 1);
        if len(path) == 0 || len(path) > 4095 || !file_exists(path) {
            jj.exitc = 2;
            jj.err = "jx: Bad JSON in " + substr(args, s, e - s) + " " + substr(args, e + 1, e2 - e - 1) + " " + path + ": Could not open " + path + ": No such file or directory";
            return -1;
        }
    }
    // the first of several options with one name wins, as in jq
    var d = 0;
    while d < k {
        if jj.nm_nl[d] == jj.nm_nl[k] && substr(args, jj.nm_no[d], jj.nm_nl[d]) == substr(args, jj.nm_no[k], jj.nm_nl[k]) { return e3 + 1; }
        d += 1;
    }
    jj.nnamed += 1;
    return e3 + 1;
}

// the arguments: sets jj.o.pretty, jj.o.raw, jj.sc.validate, the filter at [jj.fs, jj.fe) of args; 0, or 2 with the message in jj.err
fn parse_opts(args: text) -> i64 {
    jj.o.pretty = true;
    jj.o.raw = false;
    jj.sc.validate = false;
    jj.sc.selective = false;
    jj.fs = -1;
    jj.fe = -1;
    jj.o.ind = 2;
    var s = 0;
    var only_positional = false;
    let n = len(args);
    while s < n {
        var e = s;
        while e < n && byte_at(args, e) != 0 { e += 1; }
        let c0 = byte_at(args, s);
        // an option starts with `-` and a letter or a second `-`; a filter may start with `-` (`-1`, `-.a`, `-(.a)`)
        let c1 = byte_at(args, s + 1);
        let optish = c1 == 45 || (c1 >= 97 && c1 <= 122) || (c1 >= 65 && c1 <= 90);
        if !only_positional && c0 == 45 && e - s > 1 && optish {
            if byte_at(args, s + 1) == 45 {
                // a long option
                if e - s == 2 { only_positional = true; }
                else if arg_is(args, s, e, "--compact-output") { jj.o.pretty = false; }
                else if arg_is(args, s, e, "--raw-output") { jj.o.raw = true; }
                else if arg_is(args, s, e, "--validate") { jj.sc.validate = true; }
                else if arg_is(args, s, e, "--selective") { jj.sc.selective = true; }
                else if arg_is(args, s, e, "--first") { jj.first = true; }
                else if arg_is(args, s, e, "--dump-program") { jj.dump = true; }
                else if arg_is(args, s, e, "--explain") { jj.dump = true; jj.explain = true; }
                else if arg_is(args, s, e, "--null-input") { jj.nullin = true; }
                else if arg_is(args, s, e, "--slurp") { jj.slurp = true; }
                else if arg_is(args, s, e, "--ascii-output") { jj.o.ascii = true; }
                else if arg_is(args, s, e, "--seq") { jj.o.seq = true; }
                else if arg_is(args, s, e, "--exit-status") { jj.estatus = true; }
                else if arg_is(args, s, e, "--join-output") { jj.o.raw = true; jj.o.nonl = true; }
                else if arg_is(args, s, e, "--monochrome-output") || arg_is(args, s, e, "--unbuffered") { jj.o.tab = jj.o.tab; }
                else if arg_is(args, s, e, "--tab") { jj.o.tab = true; jj.o.pretty = true; }
                else if arg_is(args, s, e, "--args") { jj.posmode = 1; }
                else if arg_is(args, s, e, "--jsonargs") { jj.posmode = 2; }
                else if arg_is(args, s, e, "--raw-input") { jj.rawin = true; }
                else if arg_is(args, s, e, "--from-file") { jj.fromfile = true; }
                else if arg_is(args, s, e, "--help") { jj.help = 1; return 0; }
                else if arg_is(args, s, e, "--version") { jj.help = 2; return 0; }
                else if arg_is(args, s, e, "--indent") || arg_is(args, s, e, "--arg") || arg_is(args, s, e, "--argjson") || arg_is(args, s, e, "--slurpfile") || arg_is(args, s, e, "--rawfile") {
                    let nx = take_params(args, s, e);
                    if nx < 0 { return 2; }
                    s = nx;
                    continue;
                }
                else if known_long(args, s, e) { return usage_error(args, s, e, true); }
                else {
                    // an `--name=value` form of a known option
                    var q = s;
                    while q < e && byte_at(args, q) != 61 { q += 1; }
                    if q < e && known_long(args, s, q) { return usage_error(args, s, q, true); }
                    return usage_error(args, s, q, false);
                }
            } else {
                // short options, possibly combined
                var k = s + 1;
                while k < e {
                    let c = byte_at(args, k);
                    if c == 99 { jj.o.pretty = false; }
                    else if c == 114 { jj.o.raw = true; }
                    else if c == 110 { jj.nullin = true; }
                    else if c == 115 { jj.slurp = true; }
                    else if c == 97 { jj.o.ascii = true; }
                    else if c == 101 { jj.estatus = true; }
                    else if c == 106 { jj.o.raw = true; jj.o.nonl = true; }
                    else if c == 77 { jj.o.tab = jj.o.tab; }
                    else if c == 82 { jj.rawin = true; }
                    else if c == 102 { jj.fromfile = true; }
                    else if c == 104 { jj.help = 1; return 0; }
                    else if c == 86 { jj.help = 2; return 0; }
                    else {
                        jj.exitc = 2;
                        let one = "-" + substr(args, k, 1);
                        if known_short(c) { jj.err = "jx: option '" + one + "' is not supported yet"; }
                        else { jj.err = "jx: unknown option '" + one + "'"; }
                        return 2;
                    }
                    k += 1;
                }
            }
        } else if jj.fs < 0 {
            jj.fs = s;
            jj.fe = e;
        } else if jj.posmode != 0 {
            if jj.npos >= 32 { return usage("too many positional arguments (32 at most)"); }
            jj.ps_kind[jj.npos] = jj.posmode - 1;
            jj.ps_o[jj.npos] = s;
            jj.ps_l[jj.npos] = e - s;
            jj.npos += 1;
        } else {
            // `-` is standard input
            if e - s != 1 || byte_at(args, s) != 45 {
                if jj.nfile >= 1 { return usage("not supported yet: more than one input file"); }
                jj.nfile = 1;
                jj.file_o = s;
                jj.file_l = e - s;
            }
        }
        s = e + 1;
    }
    if jj.sc.validate && jj.sc.selective { return usage("--validate and --selective together: one checks every byte, the other skips what the filter does not read"); }
    return 0;
}

fn help_text() -> text {
    return "Usage: jx [OPTIONS] FILTER [FILE]\n"
        + "jx reads one JSON document (standard input, or one file) in a single pass and runs a jq filter over it.\n\n"
        + "Options (see the README for the exact list): -c -r -j -a -s -n -e --tab --indent N --arg --argjson --args --jsonargs --seq --validate --selective --first -h -V\n"
        + "Not supported (exit 1 or 2): regex, walk, path functions, assignment, recursive descent, dates, modules, -S, -C.\n";
}

// ---- reading the input ----

// the end (exclusive) of the JSON value that starts at p, or the end of the text when it is not closed; only brackets and strings are looked at
fn val_end(t: text, p: i64) -> i64 {
    let n = len(t);
    let c = byte_at(t, p);
    var i = p;
    var depth = 0;
    if c == 34 || c == 91 || c == 123 {
        while i < n {
            let b = byte_at(t, i);
            if b == 34 {
                i += 1;
                while i < n && byte_at(t, i) != 34 {
                    if byte_at(t, i) == 92 { i += 1; }
                    i += 1;
                }
                if depth == 0 { return i + 1; }
            } else if b == 91 || b == 123 { depth += 1; }
            else if b == 93 || b == 125 {
                depth -= 1;
                if depth <= 0 { return i + 1; }
            }
            i += 1;
        }
        return n;
    }
    while i < n {
        let b = byte_at(t, i);
        if b == 32 || b == 10 || b == 13 || b == 9 || b == 91 || b == 93 || b == 123 || b == 125 || b == 44 || b == 58 || b == 34 { return i; }
        i += 1;
    }
    return n;
}

fn count_lf(t: text) -> i64 {
    var k = 0;
    var i = 0;
    let n = len(t);
    while i < n {
        if byte_at(t, i) == 10 { k += 1; }
        i += 1;
    }
    return k;
}

// jq reads its input a line at a time (pieces of at most 4095 bytes) and input_line_number counts the pieces ending in a line feed
// that it has fed to the parser when the first value is complete (a number or a literal is complete at the byte after it)
// input_line_number for the value at p of a stream: as lines_read does for the first value, with the line feeds before it counted once
// for the whole stream (from where the last value's count stopped)
fn lines_before(doc: text, p: i64) -> i64 {
    let n = len(doc);
    let e = val_end(doc, p);
    let c = byte_at(doc, p);
    var t = e - 1;
    if c != 34 && c != 91 && c != 123 && e < n { t = e; }
    if t < jj.lfp { jj.lfp = 0; jj.lfn = 0; jj.lfls = 0; }
    var i = jj.lfp;
    while i < t {
        if byte_at(doc, i) == 10 { jj.lfn += 1; jj.lfls = i + 1; }
        i += 1;
    }
    jj.lfp = t;
    var le = t;
    while le < n && byte_at(doc, le) != 10 { le += 1; }
    if le >= n { return jj.lfn; }
    if (t - jj.lfls) / 4095 == (le - jj.lfls) / 4095 { return jj.lfn + 1; }
    return jj.lfn;
}

// -s over a stream of several values: every value as the elements of one array (the values are only split here; the scanner checks
// the array as it reads it). At most 16 MiB for now (a text built in a function); one value of any size takes the `[.]` path instead.
fn one_value(doc: text) -> bool {
    var p = skip_ws(doc, 0);
    if byte_at(doc, 0) == 239 && byte_at(doc, 1) == 187 && byte_at(doc, 2) == 191 { p = skip_ws(doc, 3); }
    return skip_ws(doc, val_end(doc, p)) >= len(doc);
}

fn slurp_text(doc: text) -> text {
    if len(doc) > 16777000 {
        jj.exitc = 1;
        jj.err = "jx: not supported yet: -s over more than one value of more than 16 MiB in all";
        jj.bad = true;
        return "";
    }
    var r: text<16777216> = "[";
    var p = skip_ws(doc, 0);
    if byte_at(doc, 0) == 239 && byte_at(doc, 1) == 187 && byte_at(doc, 2) == 191 { p = skip_ws(doc, 3); }
    var k = 0;
    while p < len(doc) {
        let e = val_end(doc, p);
        if k > 0 { r += ","; }
        r += substr(doc, p, e - p);
        k += 1;
        p = skip_ws(doc, e);
    }
    r += "]";
    return r;
}

// the output so far to standard output (results of complete values; the area is reused)
fn flush_out() {
    if jj.o.results > jj.flushed {
        let last = substr(jj.o.text, jj.o.lastpos, len(jj.o.text) - jj.o.lastpos);
        jj.lastnf = last == "null" || last == "false";
        jj.flushed = jj.o.results;
    }
    if len(jj.o.text) > 0 { print(jj.o.text); }
    jj.o.text = "";
    jj.o.lastpos = 0;
}

fn lines_read(doc: text) -> i64 {
    let n = len(doc);
    var p = skip_ws(doc, 0);
    if byte_at(doc, 0) == 239 && byte_at(doc, 1) == 187 && byte_at(doc, 2) == 191 { p = skip_ws(doc, 3); }
    if p >= n { return count_lf(doc); }
    let e = val_end(doc, p);
    let c = byte_at(doc, p);
    var t = e - 1;
    if c != 34 && c != 91 && c != 123 && e < n { t = e; }
    var ls = 0;
    var before = 0;
    var i = 0;
    while i < t {
        if byte_at(doc, i) == 10 { before += 1; ls = i + 1; }
        i += 1;
    }
    var le = t;
    while le < n && byte_at(doc, le) != 10 { le += 1; }
    if le >= n { return before; }
    let piece = (t - ls) / 4095;
    let last = (le - ls) / 4095;
    if piece == last { return before + 1; }
    return before;
}

// does the text contain the word
fn text_has(t: text, w: text) -> bool {
    let n = len(t);
    let m = len(w);
    var i = 0;
    while i + m <= n {
        if byte_at(t, i) == byte_at(w, 0) && substr(t, i, m) == w { return true; }
        i += 1;
    }
    return false;
}

// the length of the text as a JSON string
fn quoted_len(t: text) -> i64 {
    var k = 2;
    var i = 0;
    let n = len(t);
    while i < n {
        let c = byte_at(t, i);
        if c == 34 || c == 92 { k += 2; } else if c < 32 { k += 6; } else { k += 1; }
        i += 1;
    }
    return k;
}

// the text as a JSON string (at most 16 MiB)
fn quote_text(t: text) -> text {
    var out: text<16777216> = chr(34);
    let n = len(t);
    var rs = 0;
    var i = 0;
    while i < n {
        let c = byte_at(t, i);
        if c == 34 || c == 92 || c < 32 {
            if i > rs { out += substr(t, rs, i - rs); }
            if c == 34 { out += chr(92) + chr(34); }
            else if c == 92 { out += chr(92) + chr(92); }
            else { out += chr(92) + "u00" + substr("0123456789abcdef", c / 16, 1) + substr("0123456789abcdef", c % 16, 1); }
            rs = i + 1;
        }
        i += 1;
    }
    if n > rs { out += substr(t, rs, n - rs); }
    out += chr(34);
    return out;
}

// the filter from the file named by path (-f)
fn read_prog(path: text) -> text {
    if len(path) == 0 || len(path) > 4095 || !file_exists(path) {
        jj.exitc = 2;
        jj.err = "jx: Could not open " + path + ": No such file or directory";
        jj.bad = true;
        return "";
    }
    return or(read_file(path, 65536), "");
}

fn get_prog(args: text) -> text {
    if jj.fs < 0 { return "."; }
    let p = substr(args, jj.fs, jj.fe - jj.fs);
    if jj.fromfile { return read_prog(p); }
    return p;
}

// the input document: the file, or standard input (read now, not before the arguments were looked at); with -R the text as a JSON string
fn raw_input() -> text {
    if jj.nfile > 0 {
        let path = substr(jj.argtxt, jj.file_o, jj.file_l);
        if len(path) == 0 || len(path) > 4095 || !file_exists(path) {
            jj.exitc = 2;
            jj.err = "jx: error: Could not open file " + path + ": No such file or directory";
            jj.bad = true;
            return "";
        }
        return or(read_file(path, 4294967295), "");
    }
    return stdin_text(4294967295);
}

fn read_input(prog: text) -> text {
    let raw = raw_input();
    if jj.bad { return ""; }
    if !jj.rawin {
        if text_has(prog, "input_line_number") {
            if jj.slurp { jj.inl = count_lf(raw); } else if jj.first { jj.inl = lines_read(raw); } else { jj.uses_inl = true; }
        }
        return raw;
    }
    if text_has(prog, "input_line_number") {
        if jj.slurp { jj.inl = count_lf(raw); }
        else if len(raw) > 0 && byte_at(raw, len(raw) - 1) == 10 { jj.inl = 1; }
    }
    if jj.slurp {
        if quoted_len(raw) > 16777216 { return raw_too_large(); }
        return quote_text(raw);
    }
    if len(raw) == 0 { return ""; }
    var le = 0;
    while le < len(raw) && byte_at(raw, le) != 10 { le += 1; }
    if le + 1 < len(raw) {
        jj.exitc = 1;
        jj.err = "jx: not supported yet: -R with more than one input line (each line would be a document of its own; -R with -s or -n works)";
        jj.bad = true;
        return "";
    }
    if quoted_len(substr(raw, 0, le)) > 16777216 { return raw_too_large(); }
    return quote_text(substr(raw, 0, le));
}

fn raw_too_large() -> text {
    jj.exitc = 1;
    jj.err = "jx: -R input is too large (16 MiB as a JSON string at most)";
    jj.bad = true;
    return "";
}

@main
fn main(args: utf8<0..1048576> from args, env: utf8<0..1048576> from env) -> Response<text> {
    jj.exitc = 1;
    jj.argtxt = args;
    jj.envtxt = env;
    var rc = parse_opts(args);
    if rc == 0 && jj.help == 1 { return ok(help_text()); }
    if rc == 0 && jj.help == 2 { return ok("jx 0.2\n"); }
    if jj.o.ascii { jj.o.raw = false; }
    if rc == 0 {
        if jj.fromfile && jj.fs < 0 { rc = usage("-f needs the name of the file with the filter"); }
        let prog = get_prog(args);
        if jj.bad { rc = 1; }
        if rc == 0 {
            if jj.nullin || jj.dump { rc = go(prog, "null"); }
            else if jj.nfile == 0 && !jj.rawin && !jj.slurp && !jj.first && stdin_wants_pieces() { rc = go_pieces(prog); }
            else {
                let doc = read_input(prog);
                if jj.bad { rc = 1; }
                else if jj.slurp && !jj.rawin {
                    // -s: the one document becomes the only element of an array (no input at all: an empty array); a second value is the usual error
                    if skip_ws(doc, 0) >= len(doc) { rc = go(prog, "[]"); }
                    else if jj.first || one_value(doc) { rc = go("[.] | (" + prog + ")", doc); }
                    else {
                        let all = slurp_text(doc);
                        if jj.bad { rc = 1; } else { rc = go(prog, all); }
                    }
                } else { rc = go(prog, doc); }
            }
        }
    }
    if rc == 0 {
        var code = 0;
        if jj.estatus && !jj.dump {
            if jj.o.results == 0 { code = 4; }
            else {
                var lastnf = jj.lastnf;
                if jj.o.results > jj.flushed {
                    let last = substr(jj.o.text, jj.o.lastpos, len(jj.o.text) - jj.o.lastpos);
                    lastnf = last == "null" || last == "false";
                }
                if lastnf {
                    code = 1;
                    if jj.o.raw { return exit_error(5, "jx: error: with -e and raw output the last result null or false cannot be told from the string\n"); }
                }
            }
        }
        if jj.o.results > 0 && !jj.o.nonl { jj.o.text += "\n"; }
        if jj.vstatus == 5 { code = 5; }   // the last value ended with an error of the filter (reported already)
        flush();
        if code == 5 { return exit(5, jj.o.text); }
        if code == 1 { return exit(1, jj.o.text); }
        if code == 4 { return exit(4, jj.o.text); }
        return ok(jj.o.text);
    }
    // the results of the values before the one that failed stand (those of the failed one were taken back)
    if jj.o.results > 0 && !jj.o.nonl { jj.o.text += "\n"; }
    if len(jj.o.text) > 0 { print(jj.o.text); }
    flush();
    if jj.exitc == 2 { return exit_error(2, jj.err + "\n"); }
    if jj.exitc == 3 { return exit_error(3, jj.err + "\n"); }
    if jj.exitc == 5 { return exit_error(5, jj.err + "\n"); }
    return status(400, jj.err);
}

fn go(filter: text, doc: text) -> i64 {
    if prepare(filter) != 0 { return 1; }
    if jj.dump {
        if jj.explain { explain_program(filter); } else { dump_program(filter); }
        return 0;
    }
    return scan(doc, filter);
}

fn prepare(filter: text) -> i64 {
    num_init();
    ev_init();
    if compile(filter) != 0 { return 1; }
    if lower_prog() != 0 { return 1; }
    return 0;
}

// Standard input that is not a file stdin_text can map (a pipe, a terminal, Windows, more than 4 GiB): read in pieces of 16 MiB, so input of
// any size runs in fixed memory. Each piece is cut after its last line feed (no JSON token holds a raw line feed); the complete values of
// what is carried plus the piece run as a stream, and a value the cut splits is carried to the next piece and read again from its start.
fn stdin_wants_pieces() -> bool {
    let n = stdin_size();
    return n < 0 || n > 4294000000;
}

fn go_pieces(filter: text) -> i64 {
    if prepare(filter) != 0 { return 1; }
    jj.uses_inl = text_has(filter, "input_line_number");
    jj.carry = "";
    jj.more = true;
    var rc = 1;
    while rc == 1 { rc = piece(filter); }
    return rc;
}

// one piece: 1 more to read, 0 done, 2 an error (jj.err set)
fn piece(filter: text) -> i64 {
    let t = stdin_next(16777216);
    if len(t) == 0 {
        // the end: what is carried is the last value or values, now read to the end
        jj.more = false;
        if len(jj.carry) == 0 { return 0; }
        let last = jj.carry + "";
        jj.carry = "";
        if scan(last, filter) != 0 { return 2; }
        return 0;
    }
    var cut = len(t);
    while cut > 0 && byte_at(t, cut - 1) != 10 { cut -= 1; }
    let doc = jj.carry + substr(t, 0, cut);
    var keep = len(doc);
    let r = scan(doc, filter);
    if r == 1 { return 2; }
    if r == 2 { keep = jj.part; }
    if jj.uses_inl { jj.lfbase += count_lf(substr(doc, 0, keep)); jj.lfp = 0; jj.lfn = 0; jj.lfls = 0; }
    if len(doc) - keep + len(t) - cut > 268435000 {
        jj.exitc = 1;
        jj.err = "jx: a value of more than 256 MiB in input read in pieces (a pipe): not supported yet; give the file as an argument or with <";
        return 2;
    }
    jj.carry = substr(doc, keep, len(doc) - keep) + substr(t, cut, len(t) - cut);
    return 1;
}

use "util.mito";
use "num.mito";
use "compile.mito";
use "code.mito";
use "lower.mito";
use "exec.mito";
use "dis.mito";
use "scan.mito";
use "prog.mito";
use "eval.mito";
use "lib.mito";
use "out.mito";
